0x4C173AA2  XaprCallFileError       ; table: header slot +0x2C, the plug-in's XaprExtFileError; FileError's ExtMode branch
0x4C173ABD  XaprCallFileOpen        ; table: header slot +0x30, XaprExtFileOpen; FileOpen's ExtMode branch
0x4C173ADA  XaprCallFileClose       ; table: header slot +0x34, XaprExtFileClose; FileClose's ExtMode branch
0x4C173AF5  XaprCallFileRemove      ; table: header slot +0x38, XaprExtFileRemove; FileRemove's ExtMode branch
0x4C173B10  XaprCallFileGetc        ; table: header slot +0x3C, XaprExtFileGetc; FileGetc's ExtMode branch
0x4C173B2B  XaprCallFilePutc        ; table: header slot +0x40, XaprExtFilePutc; FilePutc's ExtMode branch
0x4C173B47  XaprCallFileRead        ; table: header slot +0x44, XaprExtFileRead; FileRead's ExtMode branch
0x4C173B5F  XaprCallFileWrite       ; table: header slot +0x48, XaprExtFileWrite; FileWrite's ExtMode branch
0x4C173B77  XaprCallFileSeek        ; table: header slot +0x4C, XaprExtFileSeek; FileSeek's ExtMode branch
0x4C173B94  XaprCallFileRewind      ; table: header slot +0x50, XaprExtFileRewind; FileRewind's ExtMode branch
0x4C173BAF  XaprCallFileTell        ; table: header slot +0x54, XaprExtFileTell; FileTell's ExtMode branch
; -- the file layer FileOpen belongs to: each routine takes the XAPR slot of the same name when FileExtMode is set,
;    else works on the one open FILE at 0x500622AC (FileOpen stores it) and keeps FileLastError
0x4C14EF02  FileError               ; table: FileExtMode -> XaprCallFileError (slot +0x2C, XaprExtFileError), else returns FileLastError; ferror_ext is `call` + ret of it; called after every failed FileOpen
0x4C14EFC0  FileClose               ; table: FileExtMode -> XaprCallFileClose (slot +0x34), else FsClose of the FILE at 0x500622AC and clears it; fclose_ext is `call` + ret of it
0x4C14EFF2  FileRemove              ; table: FileExtMode -> XaprCallFileRemove (slot +0x38), else "A:\" + a0 (StrAppend) and FsRemove; -0xB when the error word is 0x1F, else -3
0x4C14F0A9  FileGetc                ; table: FileExtMode -> XaprCallFileGetc (slot +0x3C), else FsGetc of the FILE at 0x500622AC
0x4C14F0F9  FilePutc                ; table: FileExtMode -> XaprCallFilePutc (slot +0x40), else FsPutc(d0) to the FILE at 0x500622AC
0x4C14F158  FileRead                ; table: FileExtMode -> XaprCallFileRead (slot +0x44), else FsRead(a0, 1, n) from the FILE at 0x500622AC in pieces of at most 0x7FFF bytes; fread_ext is `call` + ret of it
0x4C14F1F2  FileWrite               ; table: FileExtMode -> XaprCallFileWrite (slot +0x48), else FsWrite in pieces of at most 0x7FFF bytes (-0xB disk full when the error word is 0x1F, else -3); fwrite_ext is `call` + ret of it
0x4C14F291  FileSeek                ; table: FileExtMode -> XaprCallFileSeek (slot +0x4C), else FsSeek(FILE, d0, d1); -5 into FileLastError on failure
0x4C14F2E1  FileRewind              ; table: FileExtMode -> XaprCallFileRewind (slot +0x50), else FsRewind(FILE)
0x4C14F326  FileTell                ; table: FileExtMode -> XaprCallFileTell (slot +0x54), else FsTell(FILE)
0x4C14F041  FilePathRename          ; body: "A:\" + a0 and "A:\" + a1 (StrAppend), then FsRename; the callers are FileRenameFunc's, FileRenameSmfFunc's and FileRenameCstFunc's helpers
; -- the file system library under that layer, a stdio-like API of its own (not the C runtime's fwrite at 0x4C004289,
;    PfOutString's); FsErrno at 0x50200000; a FILE's +4 flags bit 0 readable, bit 1 writable, +0x14 the device
;    method table, +0x1C the position, +0x50 the size
0x4C130087  FsOpen                  ; body: (a0 path, a1 mode): parses the mode letters r w a + b ~ d (`cmp 0x72 / 0x77 / 0x61 / 0x2b / 0x62 / 0x7e / 0x64`) into flags and returns a FILE in a0 (0 + FsErrno on failure); FileOpen's core
0x4C1302B8  FsRead                  ; body: (a0 buf, d0 size, d1 count, a1 FILE): FsErrno 0x11 when the FILE is not open, 0xD when not readable (+4 bit 0), else the device read method (+4 of the table at +0x14) for size * count bytes, returns bytes / size (LibDiv32)
0x4C130301  FsWrite                 ; body: as FsRead with the writable bit (+4 bit 1) and the write method (+0xC); FileWrite's core
0x4C12FE0B  FsSeek                  ; body: (a0 FILE, d0 offset, d1 whence): 0 from the start, 1 from the position (+0x1C), 2 from the size (+0x50), through the seek method (+0x18); FsErrno 0x14 beyond the end
0x4C13004A  FsRewind                ; body: FsSeek(FILE, 0, 0) and clears the FILE's error word (+8)
0x4C12FE8E  FsTell                  ; body: returns the FILE's position (+0x1C, the one FsSeek's whence 1 adds to); -1 + FsErrno 0x11 / 0x12 otherwise
0x4C13034A  FsGetc                  ; body: one byte through the read method, -1 at the end or on error
0x4C1303E1  FsPutc                  ; body: (d0 byte, a0 FILE): one byte through the write method, -1 on error
0x4C13048B  FsClose                 ; body: closes the FILE (func_4C13049F calls its close method +0x14 and clears its slot in the open-file table 0x502883B8)
0x4C12FED8  FsRename                ; body: (a0 old, a1 new): opens old "r" (else "d", a directory), refuses (FsErrno 0x15) when new opens "r", then moves the entry [INFERENCE: name from the two-path signature and FileRename]
0x4C12FD13  FsRemove                ; body: opens the path "w~" and calls the FILE's method +0x20 [INFERENCE: the delete method; FileRemove's core]
0x4C12FD34  FsMkdir                 ; body: FsErrno 0x15 when the path opens as "d" (a directory), else creates it "wb" and calls method +0x1C [INFERENCE]
0x4C12FFB6  FsRmdir                 ; body: opens the path "d", reads its 32-byte FAT entries and refuses (FsErrno 0x1B) unless every one is 0 or 0xE5 (deleted), then method +0x24 [INFERENCE]
; -- string helpers of the file layer (no return value, unlike the C library's)
0x4C14C71E  StrCopy                 ; body: copies the string a1 to a0 with its terminator; 72 callers build file names with it
0x4C14C76A  StrAppend               ; body: appends the string a1 to the end of the string a0 (FileOpen, FileRename, FileRemove put "A:\" before a name with it)
0x4C14C738  StrCopyPad              ; body: copies at most d0 bytes of the string a1 to a0 and zero-fills the rest of the d0 (strncpy's contract, a0 / a1 / d0)
0x4C14C83E  FileNameWithExt         ; body: StrCopy(a0, a1), StrAppend("."), StrAppend(FileTypeExtTable[d0]): the name of the disk file of type d0 (LoadPmt_HD's file routine passes 1, "PMT")
0x4C2592E4  FileTypeExtTable        ; data: 13 pointers to "LSW", "PMT", "SQT", "CMP", "TM ", "MSP", "EFC", "MD ", "FAV", "HMP", "AST", "SQF", "SEQ" (the strings FileNameWithExt appends)
; -- the zlib layer of the file routines: one z_stream at 0x500622EC (whole-file codec: 0x500622B4), a 64 KB
;    buffer at 0x50062328 written / read through FileWrite / FileRead in blocks of 0xFFFD, a status at 0x50072328
0x4C137D8D  inflateInit_            ; libc: zlib 1.0.4 inflateInit_(strm, version, size) -> inflateInit2_(strm, 15, ...): the same body as KN7000 941 inflateInit_ (kn7000_manual.sym), too short to port
0x4C14F5E1  ZFileStatus             ; ram: returns the zlib file layer's status (0x50072328, halfword): every routine below stores its first error there
0x4C14F5EA  ZFileStatusClear        ; ram: clears 0x50072328; the load / save routines call it before a ZFile call and ZFileStatus after
0x4C14F5F4  ZFileInflatedTotal      ; ram: returns 0x50062324, which ZFileInflateBegin clears and the inflating readers count up [INFERENCE: the bytes inflated]
0x4C14F5FD  ZFileSpaceSet           ; ram: d0 -> 0x5007232C, the bytes the output file may still take: ZFileDeflateBegin sets -1 (no limit), the deflating writers fail with -0x65 when a 0xFFFD block would pass it; SaveLsw_HD_Impl passes FileDiskFreeSpace - 0x18
0x4C14F606  ZFileDeflateBegin       ; callee: ZArenaReset, deflateInit_(0x500622EC, -1, "1.0.4", 0x38) for the input a0 / d0, the 64 KB buffer as output; -3 on failure (callers SaveCst, SaveRcm_HD_Impl)
0x4C14F699  ZFileInflateBegin       ; callee: ZArenaReset, inflateInit_(0x500622EC, "1.0.4", 0x38) with the output a0 / d0; -2 on failure (callers LoadCst and seven Load*_HD bodies)
0x4C14FCB6  ZFileDeflatePart        ; callee: deflate on the stream ZFileDeflateBegin set up, a0 / d0 more input, d1 = 1 the last piece (Z_FINISH 4); writes each full 0xFFFD block with FileWrite
0x4C14FF84  ZFileInflatePart        ; callee: inflate on the stream ZFileInflateBegin set up, refilling the 64 KB buffer with FileRead
0x4C14F718  ZFileWriteDeflated      ; callee: one call for a whole buffer (a0, d0 bytes): deflateInit_ on 0x500622B4, deflate, FileWrite of each 0xFFFD block, deflateEnd (the eight Save*_HD bodies)
0x4C14F9D8  ZFileReadInflated       ; callee: one call for a whole buffer: inflateInit_ on 0x500622B4, FileRead, inflate, inflateEnd (the Load*_HD bodies)
