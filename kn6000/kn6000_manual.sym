; KN6000 manual symbol supplement: entry points recovered by hand, which the
; firmware's MILK reflection tables (kn6000.sym, generated) do not name.
; Format as in kn7000/kn7000_manual.sym: "0xCPUADDR  name  ; note".
;
; ---- boot header (file 0x0..0x10) -------------------------------------------
0x4C000000  _reset          ; jmp to crt0_start, the image's first instruction
0x4C000008  _vector_08      ; second vector jmp
;
; ---- start-up ----------------------------------------------------------------
0x4C0002E3  crt0_start      ; _reset's target: ports + memory controller (0x32000020..0x32000042), sp = 0x5000778C, clears 0x50006F8C (+0xCCCE4) and 0x50200000 (+0xB8000), copies .data 0x4C3ED870 -> 0x50000010 (0x6F7C bytes), writes the jmp vectors at 0x90000000
;
; ---- data ---------------------------------------------------------------------
0x4C359AC0  TechnicsRhythmsResource    ; the built-in "Technics Rhythms" style resource (IC18's format, one style " 8 Beat 1"): the fallback the style module stores to data_50005900 when the table ROM's resource does not check (KN6000 v7.1: func_4C0557E9); typed by ../kn7000/tools/program_rhythm.py
0x4C3E5FD4  ToneRecordDirectory        ; the built-in tone / voice records, one u32 pointer per record index: func_4C07C26A reads it (`mov ToneRecordDirectory, a0 / asl2 d0 / mov (d0, a0), a0`) when func_4C07CF02 does not answer 1 (otherwise the archive loaded in RAM, 0x50033BF8); typed by ../kn7000/tools/gen_data_s.py tones()
0x4C32BE24  FactoryPanelMemory         ; the factory PANEL MEMORY banks (13 x 8 memories, the .PMT bank layout): func_4C03D431 copies the .PMT header and 0x2D8D0 bytes from here to the backup RAM 0x840007C2 / 0x840007D2; typed by ../kn7000/tools/gen_data_s.py panel_banks()
0x4C3DF8EC  StyleRecordTable           ; the built-in Music Stylist setups, 1000 x 24 bytes (the KN7000's StyleRecordTable): MssNameFunc / func_4C1640C8 / func_4C164F3F index it by 24 (lane siblings-final, kn6000/notes/siblings-data-final/README.md)
0x4C3DE8BC  StyleGenreTable            ; the Music Stylist genres, 11 x {name, style list}: func_4C1640C8 0x4C164109 indexes it by StyleRecordTable.genre * 8
0x4C3E56AC  StyleEraTable              ; the Music Stylist eras, 10 x {name, setups, era}: func_4C165A19 0x4C165AA1 walks it
0x4C3DF128  StyleAlphabetTable         ; the Music Stylist alphabet index, 34 x {letter, setups}: func_4C164F3F indexes it by StyleRecordTable.letter * 8
0x4C3850BC  NoteConvRules              ; 128 x 8-byte note-conversion rules {is_melody, alt_chord, no_third_adj, no_transpose, table}: func_4C05805C 0x4C05805C (the KN7000's func_48436229)
0x4C35FF84  TechnicsPadsResource       ; the built-in "Technics Pads" PERFORMANCE PAD bank (the table flash's segment 4 format): TechnicsPadsResourceInit stores it when the table flash's resource does not check; typed by ../kn7000/tools/gen_data_s.py pads()
;
; ---- outside the code and data ranges (lane generic-zero; the Makefile's TYPED) ------------------
0x4C00000F  FirmwareVersionByte          ; the boot header's last byte, the update's version as two nibbles (v7.1: 0x71; the KN2400 v1.1's is 0x11): func_4C07B3D7 answers it (`movbu (FirmwareVersionByte), d0 / ret`)
0x4C3F77E8  Str_MILK_MN10300_Ver1_0R1   ; "MILK MN10300 Ver1.0R1", the kernel's version string (the KN7000 and KN2400 hold the same one in their data regions)
0x4C3F7800  KernelServiceHash            ; 16 x {u32 key, code pointer}: func_4C3F7632 takes d1 - 0xFF, indexes the table by (key & 0xF) * 8, probes the records in turn (`cmp KernelRamLayout, a0` is the table's end) and jumps through +4 of the one whose +0 is the key [INFERENCE: the kernel's service-call codes]
0x4C3F7880  KernelRamLayout              ; 6 RAM addresses (0x50180000, 0x501BFFFF, 0x501C0000, 0x501FFFFF, 0x50180CE0, 0x501813C8): func_4C3F61BB reads +4, +8 and +0x14, func_4C3F61F7 +8 and +0xC, func_4C3F62A4 +8, func_4C3F7793 +0x14 [INFERENCE: the kernel's memory pools' bounds]
0x4C3F7898  KernelParams                 ; 14 u16 (10, 20, 20, 20, 10 ...): get_tid reads +0, func_4C3F47EC +0x10 and +0x12, func_4C3F4A69 +0x16 (`movhu`); the KN2400 types its copy as get_tid_Table
0x4C3F78B4  KernelStartStub              ; `jmp func_4C3F7793` (the routine crt0_start's func_4C000350 ends by jumping to); no word of the image holds this address
0x4C3F78BC  KernelGroup0IntDispatch      ; an interrupt handler: saves the registers and psw, counts the nesting at 0x50180CCC, takes the group from 0x34000100 (0x34000104 + 8 when zero), calls the handler the RAM tables 0x50180A6C / 0x50180B64 give for it, rti [INFERENCE: group 0, the non-maskable sources; nothing in the image holds this address]
0x4C3F7942  KernelIntDispatch            ; the interrupt handler func_4C000350 writes a `jmp` to at 0x90000000: as KernelGroup0IntDispatch, but it switches to the kernel stack when not nested and takes the group from 0x34000200
; ---- the MILK kernel's tail routines (lane code-island, 2026-10-30; the KN7000's names,
;      ../kn7000/notes/code-island/README.md: the same block, linked at the flash address) ----
0x4C3F7383  KernelInit                   ; the routine KernelStart jumps to: fills the kernel's RAM tables, creates the kernel task, calls the application's start-up, KernelInitHook and the dispatcher start [INFERENCE: name, from what it does]
0x4C3F7632  KernelWaitRelease            ; d0 = task id: dequeues the task from the wait queue its wait state names (through KernelServiceHash), then from the timer list [INFERENCE: name]
0x4C3F778A  KernelErrorHook              ; `retf 0, 0`: kernel services call it before they return an error, d0 = the function code, d1 = the uITRON error code [INFERENCE]
0x4C3F778D  KernelErrorHook2             ; `retf 0, 0`: as KernelErrorHook, from a few other call sites [INFERENCE]
0x4C3F7790  KernelWaitAbortHook          ; `retf 0, 0`: called with a0 = the TCB and d0 = -0x55 (E_TMOUT) or -0x51 (E_DLT) for a wait that ends in an error [INFERENCE]
0x4C3F7793  KernelStart                  ; sp := (KernelRamLayout + 0x14), jmp KernelInit: the kernel's start
0x4C3F779E  KernelInitHook               ; `ret 0, 0`: KernelInit calls it before it starts the dispatcher [INFERENCE: an empty start-up hook]
;
;
; ---- zlib 1.0.4's data tables (lane mn10300-formats, 2026-10-31): found by their contents, which are
;      the zlib sources' own, and laid out in the sources' order (deflate.c, trees.c, infblock.c,
;      inftrees.c, then infutil.c's inflate_mask and zutil.c's z_errmsg after the copyright strings);
;      kn7000/notes/mn10300-formats-probes/zlib_tables.py finds them in every build ----------------
0x50004BF4  configuration_table     ; zlib 1.0.4 deflate.c: per-level {good_length, max_lazy, nice_length, max_chain, func} (10 x 12 bytes) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004C6C  extra_lbits             ; zlib 1.0.4 trees.c: extra bits of each length code (29 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004CE0  extra_dbits             ; zlib 1.0.4 trees.c: extra bits of each distance code (30 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D58  extra_blbits            ; zlib 1.0.4 trees.c: extra bits of each bit-length code (19 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DA4  bl_order                ; zlib 1.0.4 trees.c: the order the bit-length code lengths are sent in (19 bytes) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DB8  static_l_desc           ; zlib 1.0.4 trees.c: {tree, extra_lbits, 257, 286, 15} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DCC  static_d_desc           ; zlib 1.0.4 trees.c: {tree, extra_dbits, 0, 30, 15} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DE0  static_bl_desc          ; zlib 1.0.4 trees.c: {tree, extra_blbits, 0, 19, 7} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DF4  static_init_done        ; zlib 1.0.4 trees.c: non-zero once tr_static_init has run (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DF8  border                  ; zlib 1.0.4 infblock.c: the order of the bit-length code lengths (19 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004E44  cplens                  ; zlib 1.0.4 inftrees.c: copy lengths for literal codes 257..285 (31 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004EC0  cplext                  ; zlib 1.0.4 inftrees.c: extra bits for literal codes 257..285; 192 = invalid (31 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004F3C  cpdist                  ; zlib 1.0.4 inftrees.c: copy offsets for distance codes 0..29 (30 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004FB4  cpdext                  ; zlib 1.0.4 inftrees.c: extra bits for distance codes (30 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x5000502C  fixed_built             ; zlib 1.0.4 inftrees.c: non-zero once inflate_trees_fixed has built the fixed tables (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005CB8  deflate_copyright       ; zlib 1.0.4 the copyright string the zlib sources keep in the binary (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005CF0  inflate_copyright       ; zlib 1.0.4 the copyright string the zlib sources keep in the binary (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005D20  inflate_mask            ; zlib 1.0.4 infutil.c: masks of the low n bits, n = 0..16 (17 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005D64  z_errmsg                ; zlib 1.0.4 zutil.c: the error texts, indexed 2 - err (10 pointers) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
;
; ---- the built-in sound tables' hash lookups (lane mn10300-formats, 2026-10-31;
;      kn7000/notes/mn10300-formats/README.md, src/include/data_tables.inc TONE_KEY_PAYLOAD ...) ----
0x4C09ACF3  ToneKeyFind             ; (d0 = bank MSB, d1 = LSB, (0x10, sp) = program, a0 = &source byte) -> a0 = the ToneKeyHash payload of the sound, trying the voice archive first (func_4C09B170: source 2) and then, through ToneKeyLookup, the exact key and a chain of fallbacks (MSB 0x28..0x2F as 0x20..0x27, LSB rounded to 8, program 0x7F7F ...)
0x4C09AFB0  SoundSwNoGet            ; (d0 = MSB, d1 = LSB, program, a0 = &state, a1 = &group, (0x44, sp) = &number) -> the sound's panel switch {group, number} for state 0..3 from its ToneKeyHash payload: {swgroup01, swno0}, {swgroup01, swno1}, {swgroup23, swno2}, {swgroup23, swno3}
0x4C09B03B  SoundIconGet            ; (d0 = MSB, d1 = LSB, program, a0 = &icon) -> the payload's +2, the sound's icon (MainGetSoundName answers it for MT_GetSoundIcon)
0x4C09B065  SoundToneIndexGet       ; (d0 = MSB, d1 = LSB, program, a0 = &u16) -> the payload's +0, the tone record's index (func_4C07BA76 names the sound from it)
0x4C09B08C  ToneKeyLookup           ; (d0 = key MSB << 16 | LSB << 8 | program) -> a0 = entry + 8 of the key's ToneKeyHash entry, or 0; the voice archive's table when func_4C07B982 answers 1 or 2
0x4C09B200  SoundSwNoBankGet        ; (d0 = switch kind 0..7, d1 = number, a0 = &MSB, a1 = &LSB, (0x34, sp) = &program) -> the bank MSB, LSB and program a panel switch selects: the ShortKeyHash payload's +0 / +1 / +2 (or the archive's two tables)
0x4C09B2AE  ShortKeyLookup          ; (d0 = key group << 8 | number) -> a0 = entry + 6 of the key's ShortKeyHash entry, or 0
0x4C09BCFA  SoundBankIndexGet       ; (d0 = MSB, d1 = LSB, (0x10, sp) = program, a0 = &u16, a1 = &source) -> the BankKeyHash payload's u16, with fallbacks
0x4C09BDB2  BankKeyLookup           ; (d0 = key MSB << 16 | LSB << 8 | program) -> a0 = entry + 8 of the key's BankKeyHash entry, or 0
