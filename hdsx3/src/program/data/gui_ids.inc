# The OT-block, title and mode ids, GENERATED by tools/gen_data_s.py from the start-up code's
# RegisterOTBlock (-), RegisterTitle (?) and RegisterMode (?) calls:
# id = (registry slot << 16) | index, slot 0x0 OT blocks, 0x1F0 titles, 0x1E0 modes; each name is
# the string the call registers.

# 0 OT blocks

# 1 titles
.equ TT_HDDEXT, 0x01F00077	# screen HDD_MAIN_MENU

# 0 modes

# the KN6000's titles and functions this image's records name (the host's ids)
.equ FN_DefaultFunction, 0x01200000
.equ FN_DefMainFunction, 0x01400000
.equ TT_PS, 0x01F00000
.equ TT_NORMAL, 0x01F00001
