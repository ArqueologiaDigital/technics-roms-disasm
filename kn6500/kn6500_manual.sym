; KN6500 manual symbol supplement: entry points recovered by hand, which the
; firmware's MILK reflection tables (kn6500.sym, generated) do not name.
; Format as in kn7000/kn7000_manual.sym: "0xCPUADDR  name  ; note".
;
; ---- boot header (file 0x0..0x10) -------------------------------------------
0x4C000000  _reset          ; jmp to crt0_start, the image's first instruction
0x4C000008  _vector_08      ; second vector jmp
;
; ---- start-up ----------------------------------------------------------------
0x4C0002E3  crt0_start      ; _reset's target: ports + memory controller (0x32000020..0x32000042), sp = 0x50007738, clears 0x50006F38 (+0xCD984) and 0x50200000 (+0xB8000), copies .data 0x4C377524 -> 0x50000010 (0x6F28 bytes), writes the jmp vectors at 0x90000000
;
; ---- data ---------------------------------------------------------------------
0x4C2E5304  TechnicsRhythmsResource    ; the built-in "Technics Rhythms" style resource (IC18's format, one style " 8 Beat 1"): the fallback the style module stores to data_50005900 when the table ROM's resource does not check (KN6000 v7.1: func_4C0557E9); typed by ../kn7000/tools/program_rhythm.py
0x4C36F724  StyleRecordTable           ; the built-in Music Stylist setups, 1080 x 24 bytes (the KN6000's, kn6000/notes/siblings-data-final/README.md); +0 -> a 144-byte one-touch setting (func_4C04C6C2 answers 0x90)
0x4C36E5AC  StyleGenreTable            ; the Music Stylist genres, 11 x {name, style list}: func_4C1642A9 indexes it by StyleRecordTable.genre * 8
0x4C375C64  StyleEraTable              ; the Music Stylist eras, 10 x {name, setups, era}: func_4C165FFB walks it
0x4C36EEB8  StyleAlphabetTable         ; the Music Stylist alphabet index, 35 x {letter, setups}: func_4C165521 indexes it by StyleRecordTable.letter * 8
0x4C3108F8  NoteConvRules              ; 128 x 8-byte note-conversion rules {is_melody, alt_chord, no_third_adj, no_transpose, table}: func_4C058353 (the KN6000's func_4C05805C)
0x4C2B7668  FactoryPanelMemory         ; the factory PANEL MEMORY banks (the .PMT bank layout, as the KN6000's): func_4C03D5A1 copies the .PMT header (func_4C03D5A1_Table) and 0x2D8D0 bytes from here to the backup RAM 0x840007C2 / 0x840007D2; typed by ../kn7000/tools/gen_data_s.py panel_banks()
0x4C2EB7C8  TechnicsPadsResource       ; the built-in "Technics Pads" PERFORMANCE PAD bank (the table flash's segment 4 format): TechnicsPadsResourceInit stores it when the table flash's resource does not check; typed by ../kn7000/tools/gen_data_s.py pads()
;
; ---- outside the code and data ranges (lane generic-zero; the Makefile's TYPED) ------------------
0x4C00000F  FirmwareVersionByte          ; the boot header's last byte, the update's version as two nibbles (v1.3: 0x13; the KN2400 v1.1's is 0x11): func_4C07B56B answers it (`movbu (FirmwareVersionByte), d0 / ret`)
0x4C381448  Str_MILK_MN10300_Ver1_0R1   ; "MILK MN10300 Ver1.0R1", the kernel's version string (the KN7000 and KN2400 hold the same one in their data regions)
0x4C381460  KernelServiceHash            ; 16 x {u32 key, code pointer}: func_4C381292 takes d1 - 0xFF, indexes the table by (key & 0xF) * 8, probes the records in turn (`cmp KernelRamLayout, a0` is the table's end) and jumps through +4 of the one whose +0 is the key [INFERENCE: the kernel's service-call codes]
0x4C3814E0  KernelRamLayout              ; 6 RAM addresses (0x50180000, 0x501BFFFF, 0x501C0000, 0x501FFFFF, 0x50180CE0, 0x501813C8): func_4C37FE1B reads +4, +8 and +0x14, func_4C37FE57 +8 and +0xC, func_4C37FF04 +8, func_4C3813F3 +0x14 [INFERENCE: the kernel's memory pools' bounds]
0x4C3814F8  KernelParams                 ; 14 u16 (10, 20, 20, 20, 10 ...): get_tid reads +0, func_4C37E44C +0x10 and +0x12, func_4C37E6C9 +0x16 (`movhu`); the KN2400 types its copy as get_tid_Table
0x4C381514  KernelStartStub              ; `jmp func_4C3813F3` (the routine crt0_start's func_4C000350 ends by jumping to); no word of the image holds this address
0x4C38151C  KernelGroup0IntDispatch      ; an interrupt handler: saves the registers and psw, counts the nesting at 0x50180CCC, takes the group from 0x34000100 (0x34000104 + 8 when zero), calls the handler the RAM tables 0x50180A6C / 0x50180B64 give for it, rti [INFERENCE: group 0, the non-maskable sources; nothing in the image holds this address]
0x4C3815A2  KernelIntDispatch            ; the interrupt handler func_4C000350 writes a `jmp` to at 0x90000000: as KernelGroup0IntDispatch, but it switches to the kernel stack when not nested and takes the group from 0x34000200
; ---- the MILK kernel's tail routines (lane code-island, 2026-10-30; the KN7000's names,
;      ../kn7000/notes/code-island/README.md: the same block, linked at the flash address) ----
0x4C380FE3  KernelInit                   ; the routine KernelStart jumps to: fills the kernel's RAM tables, creates the kernel task, calls the application's start-up, KernelInitHook and the dispatcher start [INFERENCE: name, from what it does]
0x4C381292  KernelWaitRelease            ; d0 = task id: dequeues the task from the wait queue its wait state names (through KernelServiceHash), then from the timer list [INFERENCE: name]
0x4C3813EA  KernelErrorHook              ; `retf 0, 0`: kernel services call it before they return an error, d0 = the function code, d1 = the uITRON error code; the function codes are uITRON 3.0's and name the services (../kn7000/notes/uitron3-function-codes) [INFERENCE]
0x4C3813ED  KernelErrorHook2             ; `retf 0, 0`: as KernelErrorHook, from a few other call sites [INFERENCE]
0x4C3813F0  KernelWaitAbortHook          ; `retf 0, 0`: called with a0 = the TCB and d0 = -0x55 (E_TMOUT) or -0x51 (E_DLT) for a wait that ends in an error [INFERENCE]
0x4C3813F3  KernelStart                  ; sp := (KernelRamLayout + 0x14), jmp KernelInit: the kernel's start
0x4C3813FE  KernelInitHook               ; `ret 0, 0`: KernelInit calls it before it starts the dispatcher [INFERENCE: an empty start-up hook]
0x4C381401  KernelTickIsrDefault         ; the kernel's default system-tick interrupt handler, after KernelInitHook: clears bits 4..7 of G6ICR 0x34000118 (acknowledges interrupt group 6), calls func_4C380ED2_L3 (the kernel's wake-up of the task (0x50380000) points at) and returns with `rets` (LibIrqScheduler enters handlers with `calls (a2)` through the RAM table 0x50380B64). Nothing enters it: no word of the image holds its address, and the application start-up (through the def_int service) installs 0x4C172408 for the same interrupt (number 1, G6ICR) [INFERENCE: the kernel configuration's default tick handler, replaced by the application's; lane mn10300-typer]
;
;
; ---- zlib 1.0.4's data tables (lane mn10300-formats, 2026-10-31): found by their contents, which are
;      the zlib sources' own, and laid out in the sources' order (deflate.c, trees.c, infblock.c,
;      inftrees.c, then infutil.c's inflate_mask and zutil.c's z_errmsg after the copyright strings);
;      kn7000/notes/mn10300-formats-probes/zlib_tables.py finds them in every build ----------------
0x50004B68  configuration_table     ; zlib 1.0.4 deflate.c: per-level {good_length, max_lazy, nice_length, max_chain, func} (10 x 12 bytes) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004BE0  extra_lbits             ; zlib 1.0.4 trees.c: extra bits of each length code (29 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004C54  extra_dbits             ; zlib 1.0.4 trees.c: extra bits of each distance code (30 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004CCC  extra_blbits            ; zlib 1.0.4 trees.c: extra bits of each bit-length code (19 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D18  bl_order                ; zlib 1.0.4 trees.c: the order the bit-length code lengths are sent in (19 bytes) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D2C  static_l_desc           ; zlib 1.0.4 trees.c: {tree, extra_lbits, 257, 286, 15} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D40  static_d_desc           ; zlib 1.0.4 trees.c: {tree, extra_dbits, 0, 30, 15} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D54  static_bl_desc          ; zlib 1.0.4 trees.c: {tree, extra_blbits, 0, 19, 7} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D68  static_init_done        ; zlib 1.0.4 trees.c: non-zero once tr_static_init has run (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004D6C  border                  ; zlib 1.0.4 infblock.c: the order of the bit-length code lengths (19 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004DB8  cplens                  ; zlib 1.0.4 inftrees.c: copy lengths for literal codes 257..285 (31 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004E34  cplext                  ; zlib 1.0.4 inftrees.c: extra bits for literal codes 257..285; 192 = invalid (31 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004EB0  cpdist                  ; zlib 1.0.4 inftrees.c: copy offsets for distance codes 0..29 (30 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004F28  cpdext                  ; zlib 1.0.4 inftrees.c: extra bits for distance codes (30 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50004FA0  fixed_built             ; zlib 1.0.4 inftrees.c: non-zero once inflate_trees_fixed has built the fixed tables (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005C64  deflate_copyright       ; zlib 1.0.4 the copyright string the zlib sources keep in the binary (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005C9C  inflate_copyright       ; zlib 1.0.4 the copyright string the zlib sources keep in the binary (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005CCC  inflate_mask            ; zlib 1.0.4 infutil.c: masks of the low n bits, n = 0..16 (17 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50005D10  z_errmsg                ; zlib 1.0.4 zutil.c: the error texts, indexed 2 - err (10 pointers) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
;
; ---- the expansion board's XAPR plug-in, as the host sees it (lane mn10300-rest, 2026-10-31; the KN6000's
;      routines of the same names, kn6000/kn6000_manual.sym; probe kn7000/notes/mn10300-rest-probes/hdsx3_entry_vectors.py) ----
0x4C17321A  XaprBoardDetect        ; strncmp(0x97800000, "XAPR", 4) and strncmp(*(0x97800004), "XAPR", 4): stores 1 / 0 to XaprBoardPresent
0x50005690  XaprBoardPresent       ; 1 when XaprBoardDetect found the board
0x4C173264  XaprCallIdle           ; calls header +0x0C (XaprEntryIdle)
0x4C17327C  XaprInit               ; XaprBoardDetect, then header +0x08 (XaprEntryInit), then XaprInstallIsrs
0x4C1732A4  XaprIsrGroup24         ; interrupt handler (group 0x18): header +0x10
0x4C1732DF  XaprIsrGroup27         ; interrupt handler (group 0x1B): header +0x14
0x4C1728C5  XaprInstallIsrs        ; def_int's the two handlers
0x4C380D01  KernelDefInt           ; the kernel's def_int service
0x4C03CDDE  M3HookDispatch         ; runs the PutM3Em hook rows {mask, value, proc}
0x4C174427  XaprCallM3Hook         ; the group-0x70 hook row's proc: header +0x18 (XaprEntryM3Hook)
0x4C174230  XaprCallDiskFreeSpace  ; header +0x1C
0x4C14D282  FileDiskFreeSpace      ; the file layer: XaprCallDiskFreeSpace when CheckExtMode, else GetDiskFreeSpace
0x4C14F3AA  FileOpen               ; what fopen_ext wraps: header +0x30 in ExtMode
0x50062EFE  FileExtMode            ; the ExtMode flag
0x50062EFC  FileLastError          ; the file layer's last error
;
; ---- the parameter-id trie (lane mn10300-rest, 2026-10-31; the KN7000's ResourceIdTrie, the same design;
;      probes kn7000/notes/mn10300-rest-probes/kn6000_opaque.py / kn2400_opaque.py, group "trie") ----------
0x4C193FF8  ResourceIdTrie             ; the root of the parameter-id trie, 16 entries of {u32 target, u8 inner, u8 count, u16 0}: ResourceIdFind takes the 24-bit id's nibbles from bit 20 down; a leaf's +0 u32 is the id, +4 u16 its type (GetM3Em's records)
0x4C02CBDA  ResourceIdFind             ; (d0 = 24-bit id) walks ResourceIdTrie by the id's nibbles (lsr / and 0x0f / asl 3; `mov (a1), d1`, `movbu (4, a1)`, `movbu (5, a1)`) and answers the leaf whose +0 is the id, else 0
;
; ---- the COMPUTER CONNECTION screen's pictures (lane mn10300-names, 2026-11-02; the KN6000's twins, same
;      code and the same pixel bytes: kn7000/notes/mn10300-names-probes/siblings_kn6000_compconn_bitmaps.py) --
0x4C09FD93  BitmapCompConnDiagram      ; 296 x 108, 1 bit: the MIDI connection diagram ComputerConnection draws in all three modes (KN6000 0x4C0A0012)
0x4C09FDCE  BitmapCompConnMaster       ; 17 x 19, 1 bit: drawn for "KN as master" only (KN6000 0x4C0A004D)
0x4C09FE08  BitmapCompConnSlaveArrow   ; 10 x 12, 1 bit: MASTER KEYBOARD -> MIDI IN, "KN as slave" only (KN6000 0x4C0A0087)
0x4C09FE42  BitmapCompConnSlaveWire    ; 253 x 24, 1 bit: MIDI IN -> COMPUTER, "KN as slave" only (KN6000 0x4C0A00C1)
0x4C1D74C0  BitmapCompConnDiagram_Pixels    ; the pixels BitmapCompConnDiagram answers
0x4C1D84C8  BitmapCompConnMaster_Pixels     ; the pixels BitmapCompConnMaster answers
0x4C1D8514  BitmapCompConnSlaveArrow_Pixels ; the pixels BitmapCompConnSlaveArrow answers
0x4C1D852C  BitmapCompConnSlaveWire_Pixels  ; the pixels BitmapCompConnSlaveWire answers (was Bitmap_4C09FE42_Pixels_2)
0x4C1D882C  BitmapKn6000_Palette       ; BitmapKn6000's 16 colours (MT_GetBitmapPalette); labels.sym called it Bitmap_4C09FE42_Palette, a name gen_data_s.py kept from an earlier run
0x4C1DD70C  BitmapGm2_Pixels           ; the pixels BitmapGm2 answers (200 x 100, 1 bit); labels.sym called them Bitmap_4C09FE42_Pixels, kept from an earlier run
;
; ---- the uITRON 3.0 kernel services (the KN7000's MILK kernel; ../kn7000/notes/uitron3-function-codes/README.md) ----
; A task calls a service through its wrapper (the context save with `udf15`, the switch to the kernel stack), which
; calls the body <svc>_Impl; each body reports an error to KernelErrorHook* with d0 = its uITRON 3.0 function code.
0x4C38064E  rcv_msg_Impl            ; rcv_msg's body, behind the wrapper rcv_msg; KernelErrorHook d0 = -61 (H'ffc3, rcv_msg), d1 = E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C3804FA  snd_msg_Impl            ; snd_msg's body, behind the wrapper snd_msg; program 942's exported snd_msg_X calls the wrapper, carried here by an identical body
0x4C3803AB  cre_tsk_Impl            ; cre_tsk's body, behind the wrapper cre_tsk; KernelErrorHook d0 = -17 (H'ffef, cre_tsk), d1 = the error its core returns (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37FAF8  del_flg_Impl            ; del_flg's body, behind the wrapper del_flg; program 942's export table names the wrapper, carried here by an identical body
0x4C37F420  del_mbx_Impl            ; del_mbx's body, behind the wrapper del_mbx; program 942's export table names the wrapper, carried here by an identical body
0x4C37F68F  del_sem_Impl            ; del_sem's body, behind the wrapper del_sem; program 942's export table names the wrapper, carried here by an identical body
0x4C38087C  exd_tsk_Impl            ; exd_tsk's body, behind the wrapper exd_tsk; KernelErrorHook d0 = -22 (H'ffea, exd_tsk), d1 = E_OBJ (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C380A7C  ext_tsk_Impl            ; ext_tsk's body, behind the wrapper ext_tsk; KernelErrorHook d0 = -21 (H'ffeb, ext_tsk), d1 = E_OBJ (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37E5B0  slp_tsk                 ; uITRON slp_tsk: the service-call wrapper (context save, kernel stack, call slp_tsk_Impl); KernelErrorHook d0 = -38 (H'ffda, slp_tsk), d1 = E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37E659  slp_tsk_Impl            ; slp_tsk's body, behind the wrapper slp_tsk; KernelErrorHook d0 = -38 (H'ffda, slp_tsk), d1 = E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37EE6C  cre_mbx                 ; uITRON cre_mbx: the service-call wrapper (context save, kernel stack, call cre_mbx_Impl); program 942's exported cre_mbx_X calls the wrapper, carried here by an identical body
0x4C37EEF8  cre_mbx_Impl            ; cre_mbx's body, behind the wrapper cre_mbx; program 942's exported cre_mbx_X calls the wrapper, carried here by an identical body
0x4C37EF47  cre_sem                 ; uITRON cre_sem: the service-call wrapper (context save, kernel stack, call cre_sem_Impl); program 942's exported cre_sem_X calls the wrapper, carried here by an identical body
0x4C37EFD3  cre_sem_Impl            ; cre_sem's body, behind the wrapper cre_sem; program 942's exported cre_sem_X calls the wrapper, carried here by an identical body
0x4C37F014  chg_pri                 ; uITRON chg_pri: the service-call wrapper (context save, kernel stack, call chg_pri_Impl); KernelErrorHook d0 = -27 (H'ffe5, chg_pri), d1 = E_ID / E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F0A0  chg_pri_Impl            ; chg_pri's body, behind the wrapper chg_pri; KernelErrorHook d0 = -27 (H'ffe5, chg_pri), d1 = E_ID / E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F13B  rel_blk                 ; uITRON rel_blk: the service-call wrapper (context save, kernel stack, call rel_blk_Impl); KernelErrorHook d0 = -143 (H'ff71, rel_blk), d1 = E_PAR / E_OBJ (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F1C7  rel_blk_Impl            ; rel_blk's body, behind the wrapper rel_blk; KernelErrorHook d0 = -143 (H'ff71, rel_blk), d1 = E_PAR / E_OBJ (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F4CA  get_blk                 ; uITRON get_blk: the service-call wrapper (context save, kernel stack, call get_blk_Impl); KernelErrorHook d0 = -141 (H'ff73, get_blk), d1 = E_OBJ / E_TMOUT (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F556  get_blk_Impl            ; get_blk's body, behind the wrapper get_blk; KernelErrorHook d0 = -141 (H'ff73, get_blk), d1 = E_OBJ / E_TMOUT (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F6C6  wai_flg                 ; uITRON wai_flg: the service-call wrapper (context save, kernel stack, call wai_flg_Impl); KernelErrorHook d0 = -46 (H'ffd2, wai_flg), d1 = E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
0x4C37F756  wai_flg_Impl            ; wai_flg's body, behind the wrapper wai_flg; KernelErrorHook d0 = -46 (H'ffd2, wai_flg), d1 = E_CTX (uITRON 3.0 sect. 6.3; ../kn7000/notes/uitron3-function-codes)
