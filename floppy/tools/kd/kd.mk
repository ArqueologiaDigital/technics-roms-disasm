# floppy/tools/kd/kd.mk -- the make rules of the KN6000 / KN7000 compressed disk files (README.md here).
# Included by floppy/Makefile after its model and disk rules.  Each <model>/<disk>/kd.mk (written by
# kd_describe.py) calls KD_PART per stored stream and KD_IMAGE per stream compressed from an outside image.

KD_DIR      := tools/kd
KD_PY       := $(KD_DIR)/kd.py
KN7000_DIR  ?= ../kn7000
KN6000_DIR  ?= ../kn6000
# zlib 1.0.4's deflate: the repository's one port of it (lane customdata's).
ZLIB104     := $(KN7000_DIR)/tools/zlib10_deflate.py
KD_CODERS   := $(KD_PY) $(KD_DIR)/lzss_j.py $(ZLIB104)

# Every container on a disk, inflated: the reference payloads that payload sources .incbin.
build/%/kd.stamp: build/%/extract.stamp $(KD_CODERS)
	$(PYTHON) -I $(KD_PY) unpack-dir build/$* --stamp $@

build/%.pbin: build/%.po $(LLVM_OBJCOPY)
	$(LLVM_OBJCOPY) -O binary $< $@
build/%.zd: build/%.pbin $(ZLIB104)
	$(PYTHON) -I $(KD_PY) encode deflate104 $< $@
build/%.zl: build/%.pbin $(KD_DIR)/lzss_j.py
	$(PYTHON) -I $(KD_PY) encode lzss_j $< $@

# $(1) model, $(2) disk, $(3) unit, $(4) extracted name, $(5) part, $(6) zd | zl
define KD_PART
build/$(1)/$(2)/$(4).p$(5).po: $(1)/$(2)/payload/$(3).p$(5).s build/$(1)/$(2)/kd.stamp $$(wildcard tools/*.inc) \
		$$(LLVM_MC) $$(wildcard $(1)/include/*.inc $(1)/$(2)/payload/$(3).p$(5).*.s $$(KN7000_DIR)/src/include/*.inc)
	$$(LLVM_MC) -triple=tlcs900 -filetype=obj -I tools -I $(1)/include -I $(1)/$(2)/payload -I build/$(1)/$(2) -I $$(KN7000_DIR)/src/include \
	    -o $$@ $$<
build/$(1)/$(2).o: build/$(1)/$(2)/$(4).p$(5).$(6)
endef

# The same, for a payload source in kn7asm syntax (one generated by a kn7000/tools generator):
# the assembler writes the binary itself.
define KD_PART7
build/$(1)/$(2)/$(4).p$(5).pbin: $(1)/$(2)/payload/$(3).p$(5).s build/$(1)/$(2)/kd.stamp \
		$$(KN7000_DIR)/tools/kn7asm.py $$(wildcard $$(KN7000_DIR)/src/include/*.inc $$(KN7000_DIR)/src/customdata/*.inc)
	$$(PYTHON) $$(KN7000_DIR)/tools/kn7asm.py $$< -I $$(KN7000_DIR) -o $$@
build/$(1)/$(2).o: build/$(1)/$(2)/$(4).p$(5).$(6)
endef

# $(1) model, $(2) disk, $(3) extracted name, $(4) the make variable naming the image it compresses
define KD_IMAGE
build/$(1)/$(2)/$(3).p1.zd: $$($(4)) $$(ZLIB104)
	@mkdir -p $$(@D)
	$$(PYTHON) -I $$(KD_PY) encode deflate104 $$< $$@
build/$(1)/$(2).o: build/$(1)/$(2)/$(3).p1.zd
endef


# ---- .AST: the custom-data flash images the .AST files compress ----
# Built from the custom-data source trees (kn7000/src/customdata/*.s, kn6000/src/customdata/01ctmini.s;
# make -C kn7000 verify-customdata / make -C kn6000 verify-customdata check them byte-exact).
KD_IC21 := 01ctmini 01custm1 02custm2 03custm3 04custm4 01custm5 02custm6 03custm7 04custm8
define KD_CUSTOMDATA7
KN7000_CUSTOMDATA_$(1) ?= $$(KN7000_DIR)/build/customdata/$(1).ic21
$$(KN7000_DIR)/build/customdata/$(1).ic21: $$(wildcard $$(KN7000_DIR)/src/customdata/$(1).s $$(KN7000_DIR)/src/customdata/$(1)/*.inc \
		$$(KN7000_DIR)/src/customdata/customdata.inc $$(KN7000_DIR)/tools/kn7asm.py)
	$$(MAKE) -C $$(KN7000_DIR) build/customdata/$(1).ic21 SOFTLIST_DIR=$$(SOFTLIST_DIR)
endef
$(foreach n,$(KD_IC21),$(eval $(call KD_CUSTOMDATA7,$(n))))
KN6000_CUSTOMDATA_01ctmini ?= $(KN6000_DIR)/build/01ctmini.ic18
$(KN6000_DIR)/build/01ctmini.ic18: $(wildcard $(KN6000_DIR)/src/customdata/01ctmini.s $(KN6000_DIR)/src/customdata/01ctmini/*.inc \
		$(KN7000_DIR)/src/customdata/customdata.inc $(KN7000_DIR)/tools/kn7asm.py)
	$(MAKE) -C $(KN6000_DIR) build/01ctmini.ic18 SOFTLIST_DIR=$(SOFTLIST_DIR)

# ---- .CNV: the Style Convert converters, built by kn7000/Makefile from kn7000/src/cnv/ ----
# $(1) model, $(2) disk, $(3) extracted name, $(4) kn7000/src/cnv/ source name
define KD_CNV
build/$(1)/$(2)/$(3).gen: $$(KN7000_DIR)/src/cnv/$(4).s $$(KN7000_DIR)/tools/kn7asm.py $$(KN7000_DIR)/tools/mn10300_asm.py
	@mkdir -p $$(@D)
	$$(MAKE) -C $$(KN7000_DIR) build/cnv/$(4).cnv
	cp $$(KN7000_DIR)/build/cnv/$(4).cnv $$@
build/$(1)/$(2).o: build/$(1)/$(2)/$(3).gen
endef

# ---- a byte range of a disk file cut out as a file of its own kind (a .bmp inside a .HMP) ----
# $(1) model, $(2) disk, $(3) extracted name, $(4) output suffix, $(5) offset, $(6) count
define KD_CUT
build/$(1)/$(2)/$(3).$(4): build/$(1)/$(2)/extract.stamp
	$$(PYTHON) -I -c "import sys; d=open(sys.argv[1],'rb').read(); open(sys.argv[2],'wb').write(d[$(5):$(5)+$(6)])" \
	    build/$(1)/$(2)/$(3) $$@
build/$(1)/$(2).o: build/$(1)/$(2)/$(3).$(4)
endef

# Last: the per-disk rules use every variable above.
-include $(foreach m,$(MODELS),$(wildcard $(m)/*/kd.mk))
