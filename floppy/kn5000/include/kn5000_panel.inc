;   +16 b16                hex     TODO [zeroed ]
;   +17 b17                hex     TODO [zeroed ]
	.macro	ptlv_style_name tag, name, b16, b17
	.byte	\tag, 18
.Lpn\@:
	.ascii	"\name"
.Lpe\@:
	.if	(.Lpe\@ - .Lpn\@) - 16
	.error	"ptlv: name is not 16 bytes"
	.endif
	.byte	\b16
	.byte	\b17
	.endm

