;   +9  b9                 hex     TODO [zeroed ]
	.macro	ptlv_drawbar tag, dsp_effect_shadow, nib1_lo, nib1_hi, nib2_lo, nib2_hi, db16_8_lo, db16_8_hi, db5_4_lo, db5_4_hi, db2_2_lo, db2_2_hi, db1_1_lo, db1_1_hi, db1_sw_lo, db1_sw_hi, sw8, b9
	.byte	\tag, 10
