; 61 manually reverse-engineered symbols (RE, not from reflection tables):
0x48736F08  GenreStyleTable	; 16 x 0x18 genre records {name[16],flag,styleCount@+0x11,listPtr@+0x14}
0x48737088  GenreCount	; u16 = 16 rhythm genres
0x48735F08  StyleNumToBankSlotLUT	; 2048 x u16: style number -> bank/slot
0x48435A0A  GetCurrentGenreIndex	; reads RAM CUR_RHYTHM_GENRE
0x48435A8E  GetGenreName	; record+0x00, 16-byte memcpy
0x48435AC8  GetGenreStyleCount	; record+0x11
0x48435B22  ResolveStyleId	; source-select &0x00700000 then LUT
0x4843FAFC  StyleFlatOrdinalBuilder	; sums preceding genres' counts -> flat ordinal
0x4858B918  ResourceIdTrie	; nibble-indexed resource-id trie (used by libROM 0x4C01BB1C)
0x484ADB43  PanelButtonDispatch	; walks the per-normSeg 12-byte descriptor array (bank A 0x48614978 / bank B 0x486149FC), 5 action types; posts events via PanelEventPost 0x484AE17D (canonical movm start; register-save call entry = +5, see kn7000_manual.sym)
0x48614E6C  PanelButtonDescPtrTable	; per-normSeg -> 12-byte {event u16, +4 mask, +5 bit, +6 gate, +7 arg, +8 type}
0x48613A94  PanelWireNormTable	; wire ADDR -> normSeg (KN7000 bank A; select flag @RAM 0x5006BE94==0)
0x4860CEE8  PanelSwitchClassTable	; 2-byte entries indexed by switch-MATRIX (row*8+col)*2 at reader 0x484A0D23; self-test scan map, NOT a normSeg.bit->LED map
0x484A0CF6  PanelSelfTestScanEntry	; reads PanelSwitchClassTable by (row*8+col)*2 -- self-test switch/LED matrix scan
0x4861554C  PanelLedRegMap	; 21-entry (0..0x14) LED-group index -> LED register byte; reader 0x484B1714
0x484B16F6  PanelLedGroupToReg	; indexes PanelLedRegMap (bound 0x15) to select an LED register byte
0x48441D0A  StyleRecordToTemplate	; parse one style record @a2 -> template RAM 0x5003A2BC+idx*0x18 (subtypes 0xB0/C0/D0/E0)
0x48441CAE  StyleTemplateToNameTable	; memcpy 0xC0 B: template 0x5003A2BC -> displayed name-table 0x5003A37C
0x48441CCA  StyleTemplateBuildLoop	; 8x0x18 build loop; per entry calls 0x48440862, handler ptr 0x48435DD0
0x48442061  StyleNameDefaultFill	; memcpy the 15-byte default name ('8 Beat 1' @0x4872AB42) into a name slot
0x48435DBF  StyleIdArrayHandler	; per record: build style-ID arrays 0x50034C48/0x50035448 (u16 counters 0x50034C40/44, lim 0x1FF)
0x48435D72  StyleIdArrayStore	; store a style-ID + source tag into the style-ID arrays
0x48433493  StyleNameCommit	; memcpy 13 B from *(0x50034B8C) -> name buf 0x50034B9C; default 0x4872AB42 => '8 Beat 1'
0x48435E73  StyleIdQueueDequeue	; dequeue a style-ID from ring 0x50034C48/0x50035448 (read idx 0x50034C42, count 0x50034C44)
0x485CF8FC  StyleListBoxMsgTable	; 16 x {u32 msg-ID, u32 handler} for AcCtgStyleListBoxProc
0x4847C065  StyleListBoxDrawItem	; list item-draw (msg 0x10/0x12); fetches item text via GUI property 0x4842938D/0x48417740
0x484403C4  RhyEventLenByStatus	; pattern event length by status nibble: 0x9n=6 0xBn=3 0xCn=4 0xDn=2 0xEn=3 else=1
0x484403BC  RhySysexLen	; pattern SysEx length = data[1]+2
0x484388FD  RhyPatternScan	; pattern-stream scanner/validator; uses RhyEventLenByStatus (until 0xF5)
0x4843981C  RhyPatternPlayer	; real-time pattern player/seek; timing byte -> position:=value (absolute, 96 ticks/beat)
0x4843DC6B  RhyNoteOnVoice	; note-on: vel@+2(0=skip), note@+1, ch=b0&0xF, gate=b3+(b4<<7), routing@+5
0x4847F710  FlashWordProgram	; AMD program: AA/55/A0 + data
0x4847F749  FlashSectorErase
0x4847F96F  FlashReadAutoselect	; read chip manufacturer/device ID
0x4847F6B6  FlashReset	; reset to read-array mode
0x4847F9E6  FlashProgram128Words	; 128-word chunk programmer
0x4847E7AF  FlashAddrToSector
0x485CFED4  FlashChipIdTable	; MBM29LV160B / MX29LV160B / AT49BV16X4 descriptors
0x485CFC7C  FlashSectorMap	; bottom-boot sector geometry, total 0x200000
0x4852CFD3  DiskLoadDispatch	; walks disk-file handler table
0x486647A4  DiskFileHandlerTable	; per-file-type load handlers
0x4852CC8D  AstLoadHandler	; handles 'J K' (.AST) custom/style files
0x48664584  DiskFileTagTable	; tag signatures: JK / J K / TCMP / TPAD / KN7000 SOUND RAM
0x4866492C  DiskFileExtTable	; extensions: MD / FAV / HMP / AST / SQF / SEQ / ACT
0x5008FDDA  FavoritesBankDir	; 40 x 34-byte {name[16], u16 items[9]}
0x48561CCA  FavNameSetter	; writes FavoritesBankDir[idx].name (0x5008FDCA+idx*0x22)
0x48561D7D  FavItemSetter	; writes FavoritesBankDir[idx].items[slot] (u16)
0x4855EC23  FavFormat	; memset the favorites directory (0x550 bytes)
0x4848A920  OpeningFrameDraw	; boot opening-screen draw callback; plays the splash JPEG animation
0x48424F23  JpegDecodeBlit	; DrawJpegFile's Impl: JpegSetup decodes the JPEG into the picture planes at the point, then GetJpegSize + SetChangeRect; also called by DrawJpegFileR_Impl; its callers test DrawEnable 0x5002A01C (call entry JpegDecodeBlit_entry 0x48424F28)
0x484870B7  JpegPixelStore	; picture writer: YCbCr->RGB, 4-bit quantize, store 0xD0|red4 to FB + green4/blue4 to companion plane
0x48486330  JpegSetup	; JPEG decode setup: installs the output callback, calls JpegEngine
0x4840E721  JpegEngine	; JPEG decode engine (Huffman + IDCT, drives the DCT block decode)
0x4840FC3A  JpegBitRefill	; JPEG bit-buffer refill / ensure-N-bits (state @0x501739C4/C8)
0x485E6DAC  OpeningFrameTable	; 7-entry splash frame sequence {00,10,12,14,16,20,42,FFFF}
0x5006B5B4  OpeningFrameTarget	; boot-splash sequencer target counter (++ per OpeningFrameDraw redraw)
0x5006B5B8  OpeningFrameIndex	; boot-splash current index into OpeningFrameTable (-1/0xFFFF = done)
0x4848593C  AstHeaderIngest	; reads the .AST header, sets install buffer 0x502B8000
0x485335EE  FatSectorRead	; FAT sector reader used by the .AST loader
0x48727D08  MilkMethodDict	; MILK method-name dictionary: 241 MT_ name ptrs (0x48726CE4..0x487270A4)
0x487280D0  InitBlockTable	; func-ptr table: 32 x InitializeBlockNN (0x00..0x7C), then the graphics/object API from +0x80 (InitializeGraphics, UpdateScreen +0x84, SetChangeRect +0x8C, DrawBitmap +0xC0, DrawIcons +0xC4, DrawFrameSP +0xC8, DrawString +0xCC, ...)
