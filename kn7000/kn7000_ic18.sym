; ---- the caches, the tick, BootMain's helpers ---------------------------------
0x50008435  ICacheInvalidate        ; instruction cache off, wait, invalidate, on again
0x5000845C  DCacheInvalidate        ; data cache off, wait, invalidate, on again
0x50008482  ICacheDisable
0x500084A3  DCacheFlushDisable      ; written back way by way unless write-through, invalidated, left off
0x50008515  TickIsr                 ; interrupt group 6 (timer 4): TickCount += 1; a six-step cycle sets the request bits of TickJobs
0x50008617  LcdControllerInitOld    ; another set-up of the LCD controller, by a register map that is not the S1D13506's (even offsets 0x00-0x14, two palette tables at +0x20 and +0x60), then 512 KB of LCDC_VRAM cleared
0x50008BEB  BootMain_UnusedRet      ; an epilogue left after BootMain; unreachable
0x50008BEE  TickStart               ; TickIsr on interrupt group 6, timer 4 reloading 0xFA0, interrupts on
0x50008C4C  FlashAllToReadMode      ; every flash device back to read mode (Flash32Reset 0, FlashResetToRead 4..10)
0x50008C6A  PanelStart              ; the D-cache written back and off, PanelDriverOps[0] (PanelInit), the D-cache invalidated and on
0x50008C82  FdcStart                ; FdcHookNop4, FdcHwInit
0x50008C92  ScreenInit              ; LcdControllerInit, then panel commands 0x1C/0x32 and 8..0xD with 4, and PanelPump
0x50008D04  SpinDelay               ; d0 rounds of ten nops
0x50008D23  SpinDelay10000          ; d0 rounds of SpinDelay(10000)
0x50008D43  UpdateSystemMenu        ; UPDATE / DISKCHK / EXIT: FlashUpdateScreen or DiskCheckScreen
0x50008DB9  DeviceInfoScreen        ; DEVICE INFO: DeviceInfoProbe
0x50008DF1  DiskCheckScreen         ; UPDATE DISK CHECK: the floppy's kind, then DiskCheckRun
0x50008E7D  FlashUpdateScreen       ; FLASH MEMORY UPDATE: the program's version now (PROGRAM_FLASH_VERSION) and on the disk, then FlashUpdateRun
0x50008FDA  SdUpdateScreen          ; FLASH MEMORY UPDATE --- SD: two confirmations, then SdUpdateStart
0x50009095  LcdControllerInitAlt    ; a third set-up of the LCD controller, by yet another register map: the offsets 0x01-0x23 and the values fit Epson's earlier S1D13505 ([INFERENCE] there 0x04 = 0x4F is 640 pixels a line, 0x08 = 0xEF 240 lines, 0x0D the display mode, enabled last; not checked against its data sheet)
0x5000917E  IrqGroupsDisableAll     ; the enable bit of every GxICR off, before the jump to the firmware
0x50009301  LcdControllerInit       ; the LCD controller's registers, by the S1D13506 map (640 x 240, 16 bits a pixel), LCDC_VRAM cleared, the display on
0x500095F9  HexDumpLines            ; ten lines of "%08X :" and sixteen "%02X " bytes from a0

; ---- the flash programmer ------------------------------------------------------
; The update writes 13 kinds of device (FlashDeviceBase, numbered as the floppy kinds
; KN7KP1..KN7KA2 of UpdateDiskIdentify). Kinds 0..3, the program and table flash, are
; two 16-bit chips side by side (32-bit commands 0x00AA00AA at 0x1554); the others are
; one 16-bit chip (0xAA at 0xAAAA). Both AMD-style command sets.
0x500097B0  FlashBusyWait6000       ; counted busy loop (0x1770)
0x500097DD  FlashBusyWait33         ; counted busy loop (0x21)
0x50009808  FlashDeviceBase         ; the uncached base of device d0: 0/1 program 0x88400000 (+2 MB), 2/3 table 0x88000000 (+2 MB), 4 IC21 0x96800000, 5 0x96000000, 6 0x97000000, 7 0x81000000, 8/9 0x80000000 (+2 MB), 10-12 IC19 0x97800000
0x500098A5  FlashResetToRead        ; the read/reset command (0xF0) by the identified chip's command layout
0x50009945  FlashIdentify           ; autoselect (0x90): maker and device, printed "M:%2X D:%2X"; known Fujitsu (4), Atmel (0x1F) and Macronix (0xC2) parts set FlashChipId; 0 if known else 0xFFFF
0x50009A6A  FlashPageWrite          ; Atmel page mode: collects 128 words in FlashPageBuffer, then programs the page (0xA0) and polls
0x50009B1D  FlashProgramWord        ; one word (0xA0), then polls until it reads back; Atmel parts through FlashPageWrite
0x50009B82  FlashEraseChip          ; chip erase (0x80, 0x10); kinds 8 and 0xB erase both halves
0x50009C76  FlashEraseSectors       ; sector erase (0x30) of the eight sectors at 0x8000, 0x40000..0x1C0000
0x50009CDE  FlashWaitEraseDone      ; until FlashEraseComplete, printing a mark every 50 ticks
0x50009D29  FlashEraseBootSectors   ; the small sectors one by one, then the large ones
0x50009E06  FlashEraseComplete      ; device 9: always; Atmel: status 0x80; else the first word reads 0xFFFF twice
0x50009E59  FlashEraseChipWait
0x50009E87  FlashEraseSectorsWait
0x50009EB5  Flash32Reset            ; read/reset for the program/table pair
0x50009F32  Flash32Identify         ; autoselect on the pair: Fujitsu 0x22F6/0x22F9/0x225F/0x2250 or Macronix 0xA100/0xA200 set Flash32ChipId; 0 if known
0x50009FD0  Flash32ProgramWord      ; one 32-bit word (0x00A000A0), polled until it reads back
0x5000A018  Flash32EraseChip        ; chip erase on the pair
0x5000A059  Flash32IsErased         ; the first word reads 0xFFFFFFFF twice
0x5000A078  Flash32EraseChipWait
0x5000A09E  Flash32WordErased       ; word d1 of the table pair reads 0xFFFFFFFF twice
0x5000A0C4  Flash32WaitErasedAt     ; until Flash32WordErased, then a progress mark
0x5000A0F9  Flash32EraseRegion      ; region d0 (0..3) erased sector by sector, by the sector map of the identified chips
0x5000C538  PfConversionCases       ; vsprintf_core's switch on the conversion letter 'E'..'x'
0x5000C608  PfFlagChars             ; PfParseSpec's hashed switch: {flag character + 1, handler}
0x5000CD70  FlashDeviceBaseCases    ; FlashDeviceBase's switch
0x5000CDA4  FlashResetById          ; FlashResetToRead's hashed switch on the device code
0x5000CE24  FlashFujitsuIds         ; FlashIdentify's hashed switch on the Fujitsu device codes 0x2227..0x22F9
0x5000E104  FontTable               ; two 8x16 fonts: {width, height, .., glyph bitmaps}
0x5001006C  Flash32ChipId           ; both chips' device codes, or -1
0x50010170  FlashChipId             ; the 16-bit chip's device code, 0xFFFF until identified
0x50012468  FlashPageBuffer         ; FlashPageWrite's 128 words; Reset puts the stack top 12 bytes below it
0x50012568  FlashPageIndex          ; FlashPageWrite's word count

; ---- the floppy update ---------------------------------------------------------
; An update floppy (1.44 MB) carries at LBA 0x21 a six-character kind (KN7KP1 ...) and at
; LBA 0x22 the block sums, '@'-separated hex; the image follows from LBA 0x24 as an LZSS
; stream (4 KB window, 12-bit offsets, 4-bit lengths + 3, window pre-filled to 0xFEE)
; whose eight-byte header is followed by the 24-bit size.
0x5000A7A2  FloppyInit144           ; FdcRequest 0 for 1.44 MB media (0xD3)
0x5000A7C5  FloppyLbaToRequest      ; buffer, LBA, count into FloppyRequest: cylinder LBA/36, head (LBA/18)%2, sector LBA%18+1
0x5000A826  FloppyRead              ; d1 sectors from LBA d0 into a0, re-initialising and retrying until it reads
0x5000A858  UpdateDiskIdentify      ; the update kind at LBA 0x21: 0 KN7KP1 .. 12 KN7KA2, 0xFF none
0x5000A9B3  UpdateDiskLoadSums      ; LBA 0x22's '@'-separated hex: the block count, then the 16-bit sums into UpdateSums (not for second disks: kinds 1, 3, 9, 12)
0x5000AA5D  WaitForDisk             ; until the disk is taken out, put in again and is of kind d0
0x5000AAAC  FlashEraseForKind       ; kinds 0..3 Flash32EraseRegion, else FlashEraseChip and a wait with progress marks
0x5000AB24  FloppyFlashUpdate       ; "Now erasing", erase, "Now writing", UpdWriteDisk; a two-disk image asks for disk 2/2; "Completed! Turn on Again."
0x5000ABD9  FloppyDiskCheck         ; UpdVerifyDisk over one or two disks against the sums: "NG disk" or "OK! Turn on again."
0x5000AC7E  FloppyDiskCheck_UnusedRet    ; an epilogue left after FloppyDiskCheck, which never returns; unreachable
0x5000AC81  UpdStreamGetByte        ; the next byte of the LZSS stream, reading the next four tracks when the buffer runs out; 0xFFFF past the end
0x5000AD05  UpdFlashPutByte         ; gathers bytes into a word (4 for kinds 0..3, else 2) and programs it at UpdWriteAddr
0x5000ADA9  UpdSumByte              ; adds a byte to the block sum; every 0x40000 bytes compares it with UpdateSums ("NG Disk", halt)
0x5000AE3C  UpdFlashFlush           ; the last partial word, padded with 0xFF
0x5000AEBF  UpdVerifyDisk           ; decompresses the disk's stream through UpdSumByte only; returns the size
0x5000B080  UpdWriteDisk            ; decompresses the disk's stream into the flash (UpdFlashPutByte), "> Write Address = ..."; returns the size
0x5000B280  UpdDiskVersion          ; decompresses the first 16 bytes of the program disk; returns byte 15, the version
0x5000B450  DeviceInfoProbe         ; "FLASH ROM" if the program flash identifies, else "MASK ROM"; never returns
0x5000B477  DeviceInfoProbe_UnusedRet    ; unreachable
0x5000B47A  DiskCheckRun            ; UpdateDiskLoadSums, FloppyDiskCheck
0x5000B490  FlashUpdateRun          ; identifies the target flash for the disk's kind, then FloppyFlashUpdate; hangs if it is not a known flash
0x5000B4C7  FlashUpdateRun_UnusedRet     ; unreachable
0x5002B9D0  UpdStreamSize
0x5002B9D4  UpdStreamPos
0x5002B9D8  UpdWriteAddr
0x5002B9DC  UpdTrackPtr             ; the next byte in UpdTrackBuffer
0x5002B9E4  UpdNextLba
0x5002B9E8  UpdByteCount            ; bytes gathered for the word (UpdFlashPutByte) or summed in the block (UpdSumByte)
0x5002B9EC  UpdBlockSum
0x5002B9EE  UpdBlockIndex
0x5002B9F0  UpdTotalSum
0x5002B9F4  UpdateSums              ; the 16-bit block sums from LBA 0x22
0x5002BA14  UpdateSumCount
0x5002BA18  FloppyRequest           ; FloppyRead's FdcRequest block
0x500199CC  UpdTargetBase
0x500199D0  UpdTrackBuffer          ; four tracks (0x9000 bytes) of the stream
0x5001256C  UpdWordBuffer

; ---- the SD update ---------------------------------------------------------------
0x5000B4CA  SdFlashUpdate           ; for each update file on the card (UpdateFileNames): the target flash identified, erased, written, verified; then "Update Infomation" and the per-file result
0x5000BD07  SdFlashUpdate_UnusedRet ; unreachable
0x5000BD0A  FlashFindNonBlank       ; the first 0x40-byte step from a0 up to a1 whose word is not 0xFFFFFFFF, else 0
0x5000BD39  StatusLedOff            ; clears bit 2+d0 of StatusLatchShadow and sends it (StatusLatchWrite)
0x5000BDA0  SdUpdateFilePresent     ; 1 if the card holds any of UpdateFileNames
0x5000BDE8  SdUpdateStart
0x5000BDFA  DiskStart               ; LCDC_GPIO_CONFIG1 := 0x0E (pins 1-3 outputs), DiskInit
0x50010174  UpdateFileNames         ; KN7KPRG.DAT, KN7KTBL.DAT, KN7KCSTM.DAT, KN7KRHY.DAT, KN7KAROM.DAT, ""
0x50012570  StatusLatchShadow
0x50007060  StatusLatchWrite        ; sends d0 & 0x7F on the SPI shift register, then pulses the SD select line, which latches it (TODO: which device: the update's status lamps, by StatusLedOff)

; ---- the text screen and the soft keys -------------------------------------------
0x5000BE0D  ScreenClear             ; the 10 x 78 text buffer to spaces, the cursor home, the frame buffer cleared
0x5000BE58  ScreenTitle             ; "UPDATE SYSTEM", a rule, the title, two lines across
0x5000BE9E  MenuSoftKeyChoice       ; up to four captions "[%s]" across the bottom; waits for a panel key under one: 0..3 (4 when there are none)
0x5000C068  ScreenPrint             ; text into the buffer at the cursor (\n, \r, wrap, scroll), then the changed lines drawn
0x5000C1C9  PanelWaitEvent          ; pumps the link until a three-byte switch event {group, bits, changed} comes in
0x5000C216  PanelDiskLed            ; panel command 9 with 8 (on) or 0
0x5000C23F  LcdFill                 ; the whole frame buffer with pattern 0, 0x5555, 0xAAAA or 0xFFFF
0x5000C27D  LcdHLine                ; pixel row d0 with pattern d1
0x5000C2BE  LcdDrawChar             ; one glyph of a FontTable font at text column/row
0x5000C3FD  LcdDrawString
0x5002BA40  ScreenText              ; 10 lines of 78 characters
0x5002BD4C  ScreenLineFlags
0x5002BD9A  ScreenCursorCol
0x5002BD9C  ScreenCursorRow

; ---- disk: the SD card and the drive-letter commands, the firmware's design ----
0x500065E9  DiskInit                ; DiskDriverOps[0]: SdHwInit, the card records reset, slot power off, SdSlotDischarge
0x50006616  DiskHookNop1            ; an empty method of DiskDriverOps
0x50006619  DiskHookNop2            ; an empty method of DiskDriverOps
0x5000661C  DiskHookNop3            ; an empty method of DiskDriverOps
