; ---- the FAT12 reader on the SD card (the SD update files) --------------------
0x50007141  SdReadSector            ; sector d0 into a0 through DiskCmdTransact (message: command 3, count 1); -1 on failure
0x50007166  FatClusterToSector      ; (cluster - 2) * sectors per cluster + the first data sector
0x50007185  FatReadCluster          ; every sector of cluster d0 into a0
0x500071BD  FatMount                ; partition 1's start from the MBR, then its boot sector: 512-byte sectors, two FATs, "FAT12   ", the sizes; on a failure the volume name is "12345678"
0x500072E6  FatLoadFat              ; the first FAT into FatTable
0x50007321  FatLoadRootDir          ; the root directory into FatRootDir; the first data sector after it
0x50007373  FatFindRootEntry        ; the root entry of an 8.3 name ("NAME.EXT"); the entry count when it is not there, 0xFFFF without a dot
0x50007400  FatClusterValid         ; 2..0xFF6
0x50007413  FatNextCluster          ; the 12-bit FAT entry of cluster d0
0x50007469  SdFatOpenVolume         ; mounts the card (SD command 0), FatMount, FatLoadFat, FatLoadRootDir; -1 no card, -2 no FAT12 volume
0x500074A3  FatOpen                 ; opens a root-directory file into FatFile and reads its first sector; a0 = FatFile or 0
0x5000757C  FatRead                 ; up to d0 bytes of the file a1 into a0; the count read
0x500075A6  FatGetc                 ; the next byte of the file a0, following the cluster chain; -1 at the end
0x50007633  FatEof                  ; 1 when the position has reached the size
0x50007644  FatClose                ; the file control block back to FatFileInitImage
0x50007657  FatReadTestFile         ; opens MORITANI.DAT and reads it through to the end, 512 bytes at a time into a ten-sector ring
0x5000DF70  FatMountFailImage       ; FatMount copies these nine words over its volume variables when it rejects the boot sector, then returns -1. TODO: the numbers do not describe a usable volume (32 bytes a sector, no FAT); what they were meant to be is not known
0x5000DF94  FatFileInitImage        ; a closed file control block
0x500128F8  FatVolumeName
0x50012904  FatPartitionStart
0x50012908  FatBytesPerSector
0x5001290A  FatSectorsPerCluster
0x5001290C  FatNumFats
0x5001290E  FatRootEntries
0x50012910  FatSectorsPerFat
0x50012912  FatEntryCount           ; the 12-bit entries the FAT holds
0x50012914  FatTotalSectors         ; from the 32-bit field of the boot sector
0x50012918  FatDataStart            ; the first data sector
0x5001291C  FatTable
0x5001411C  FatRootDir
0x5001811C  FatFile                 ; the open file: {cluster, offset in sector, buffer, sector in cluster, size, position}
0x5001811E  FatFileOffset
0x50018120  FatFileBuffer
0x50018124  FatFileSectorInCluster
0x50018128  FatFileSize
