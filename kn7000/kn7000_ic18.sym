0x50006EAB  SdCardInfoReset         ; block length 0x200, capacity 0, not initialised
0x50006ECF  SdCardInfoReset_UnusedRet    ; a second epilogue left after SdCardInfoReset; unreachable
0x50006ED1  SdCardIdentify          ; CMD9: the CSD, the block length and capacity from its fields; prints "spiGetInfo : %d = sendReadCOM(CSD);" on failure
0x500070B9  SdMediaChangeService    ; on a card: the canned drive-control messages '@' and 'C', state 2
0x5000710A  SdPowerDownNotify       ; the canned 'F' drive-control message
0x5000713C  StubMinusOne            ; returns -1
0x500076BF  SdHwInit                ; select pulse, SdSpiPortSetup, SdDetectPortInit
0x500076D4  SdSpiPortSetup          ; EXTMD bits 10-11 for the SPI handshake group, the slow clock
0x50007725  SdSpiClockSet           ; d0 2: the slow clock; 3: the stored working pair
