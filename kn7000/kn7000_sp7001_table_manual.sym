; KN7000 SP7001 table-flash XAPR plug-in (table build 83, CPU 0x483E8000..0x483FB5A0)
; -- hand-curated names, NOT from the plug-in's own MILK reflection tables (those are in
; the generated kn7000_sp7001_table.sym). Sources: the XAPR header layout and the program
; side's plug-in host (kn7000_sp7001_new.sym), and the activation reverse-engineering in
; research-scratch/kn7000-sp7001-activation/ (ALGORITHM.md, README.md; live traces).
; Entries marked "label" are code points inside a larger routine (not call/pointer
; targets); tools/gen_table_s.py prints them as in-code markers, not function splits.
;
; ---- XAPR header (0x483E8000): 'XAPR', footer pointer, then entry slots ----
0x483E8000  XaprHeader              ; 'XAPR' magic; +0x04 -> XaprFooter; +0x08/+0x0C/+0x10 entry slots; +0x14..+0x38 -> XapSlotDefault
0x483FB59C  XaprFooter              ; 'XAPR' again: PlugInProbe (program 0x48585B95) checks both magics
0x483E88E4  XapSlot08               ; header slot +0x08: called once by the program's PlugInProbeCallSlot08 (from 0x4854AC83) with a0 = 0x5011FABC
0x483E88FE  XapSlot0C               ; header slot +0x0C: called every pass of the firmware's library main loop (program PlugInCallSlot0C, call site 0x4C02BE74)
0x483E8303  XapSlot10               ; header slot +0x10: d0/d1 in, result out (program PlugInCallSlot10; -1 when no plug-in)
0x483E803C  XapSlotDefault          ; `rets`: the ten unused header slots +0x14..+0x38 point here
;
; ---- activation gate (research-scratch/kn7000-sp7001-activation) ----
0x483E9E1C  KssActivationOkHandler  ; label: OK-button path of the activation dialog (live-traced; runs 4x per OK press); calls KssPasswordCheck at +4
0x483EE8E9  KssPasswordCheck        ; builds the two serial-derived targets and runs KssKeyCompare; status -> 0x502992C4 (0 = ok), match in d0
0x483EE921  KssActivationApply      ; activation apply: re-validates through KssKeyCompare and sets 0x502992C4
0x483EF0AF  KssKeyCompare           ; comparator(a0 = framework obj, a1 = param1, d0 = param2): checks transformed[1:12] (field-3 vs param2, field-8 vs param1)
0x483EF2F7  KssKeyStripDashes       ; strips the dashes of the typed XXXX-XXXX-XXXX-XXXX key
0x483EF1AD  KssKeyTransform         ; applies one keystream record: copies char 0, then KssKeyCharTransform for i = 1..15 (two passes per check)
0x483EF234  KssKeyCharTransform     ; out = enc(((dec(in) - i) & 0x1F) XOR dec(key)) over the base-35 alphabet {1-9,a-z} (invertible; invert.py)
0x483EEF21  KssBuildParam1          ; builds the field-8 target at boot: SD card CID -> KssPad16 -> KssHash275 (trace_param1_build.lua)
0x483EEF26  KssBuildParam1_entry
0x483ECC6D  KssPad16                ; (buf, fill = 0x20, n = 0x10): from the first NUL, right-pad with spaces to 16 chars
0x483EF275  KssHash275              ; hashes 16 chars -> 8 chars with two 32-bit accumulators (param1_hash.py)
;
; ---- plug-in loader / framework data (RAM) ----
0x50299298  KssFrameworkObj         ; *(this) = the MILK framework object the plug-in host hands to a loaded .XAP (XapSlot08 0x483E88E4 stores a0 here); plug-ins call the firmware only through its method tables (obj+0x1C and obj+0x2E1C)
0x50299070  KssBaseExtLoadedLatch   ; 0 until the base extension is loaded; Ap_Ce_StartUp's load case reads it, calls KssPluginLoad(3), then sets it to 1 (so the .XAP loads once)
0x502992C4  KssActivationStatus     ; 0 = ok; set by KssPasswordCheck / KssActivationApply and read AFTER KssPluginLoad returns -- activation does not gate the load
;
; ---- .XAP plug-in loader ----
0x483EEAA9  KssPluginLoad           ; (d3 = plug-in id) logs 'PluginLoad id=%i', opens the .XAP (A:\%s.XAP / %s\%s.XAP), rejects files over 0x1D000 bytes, reads exactly 0x1D000 bytes to 0x5029B000, calls 0x5029B000 (a0 = framework object, a1 = 0x502992E4, d0/d1 -> compile id / plug-in id), checks the id and the compile id ('Compile id's dont match: base=%i != baseext=%i'), then registers the handle in 0x50299ED0[id]
;
; ---- activation data ----
0x483F8B74  KssKeystreamRecords     ; 27 static keystream records, 20 base-35 chars + NUL each (stride 0x15); the key's first char selects the pair used
0x483F782C  KssMsgWrongPassword     ; 'Falsches Passwort'
0x50299490  KssKeyStringsPtr        ; (RAM image) the pointer the key check passes in d0 to KssKeyTransform and func_483EF161 (table.s, after KssKeyStripDashes); its initial value points at the RAM image's list of 20-character key strings at 0x50299424 (named so the data generation and the code agree on one label: lane kn7000-final)
0x483F88F0  KssStrPluginCtrl        ; 'PluginCtrl', then the plug-in type names 'BASE', 'mr7', 'MIDI', ...
0x483F8900  KssStrMr7               ; 'mr7': the field-3 target (param2) for this plug-in
0x483F892C  KssActivationFilePath   ; 'C:\TECHNICS\DATA\CTDV10KL.CDF' -- the SD-card file caching the typed key (the RE note's 0x483F893D is the bare filename inside it)
0x483F89A8  KssMsgPluginReleased    ; "Plugin '%s', id %i, serial %s, is released" (the RE note's 0x483F89C7 points inside it)
0x483F89D4  KssMsgPluginWrongPw     ; "Plugin '%s', id %i, serial %s, is has WRONG PASSWORT in passfile!"
;
; ---- lane mn10300-names (2026-11-02, N-d753af29): the services and objects BASEEXT.XAP's indirect calls go through ----
; ---- the base plug-in's service table handed to a loaded .XAP (a1 of its entry; BASEEXT keeps it in XapContext 0x502B4048) ----
; Probe: notes/mn10300-names-probes/oldbuilds_baseext_indirect_calls.py.  A function reached through this table
; or a vtable starts with a `movm` (the `calls` entry); its name goes 2 bytes in, after the movm, where
; direct `call`s enter (as KssPad16 at 0x483ECC6D, table slot +0xCC = 0x483ECC6B).
0x502992E4  KssContext              ; (RAM image) the service table KssPluginLoad passes in a1 to a loaded .XAP: 78 words, code pointers into this plug-in and pointers into KssWorkRam; BASEEXT.XAP makes 329 of its 1,340 indirect calls through it (slots +0x00 .. +0x130)
0x502990C0  PtrStrListVtbl          ; (RAM image) 12 methods of the PtrStrList object (ptr_502990BC = its class name 'PtrStrList'; magic 0xF34E32BB at +4, items +8, capacity +0xC, count +0x10)
0x502990F0  StrListVtbl             ; (RAM image) 15 methods of the StrList object (a view over a PtrStrList; magic 0x89426ACE), followed by its name 'StrList'
0x483EC488  KssLogPrintf            ; KssContext+0x00 (34 BASEEXT calls): (a0 = log buffer in KssWorkRam, d0 = 1, a1 = format, ...) [INFERENCE: the trace/log printer the exception code writes "%H forwarded" / "%H stack trace" with]
0x483EBCC9  KssUnhandledException   ; KssContext+0x20 (25): logs the pending exception (KssActivationStatus), runs KssTraceForward, and shows 'Unbekannter Fehler' / 'Druecken Sie OK um zur Hauptseite zu wechseln' through KssDialogShow
0x483EBD8F  KssRsprintf             ; KssContext+0x2C (23): sprintf into a debug ring buffer ('rsprintf buf too small %i %i', 'debug out of order')
0x483EBF26  KssThrow                ; KssContext+0x6C (29): (d0 = exception code, ...) logs 'thrown %s' and sets KssActivationStatus := d0; refuses while one is pending ('Can't throw exception while an old one is uncatched', 'Printing uncatched exception ...')
0x483EBFC2  KssThrowBug             ; KssContext+0x70 (40): logs ('can't throw bug while a bug exception is ...') and sets KssActivationStatus := 1
0x483EC03A  KssTraceForward         ; KssContext+0x78 (85): when KssActivationStatus == 1 logs '%H forwarded', else '%H stack trace' (the frame-exit trace of the exception scheme)
0x483EB6A4  KssDialogShow           ; KssContext+0x8C (17): (a0 = title, a1 = text, d1) the ScrDialog message box (sets the class-name pointer to 'ScrDialog')
0x483ECD5F  KssMasterCodeCheck      ; KssContext+0xB4 (1): (a0 = string) -> 1 when strcmp(a0, '73298125') == 0, else 0
0x483ECCFF  KssSdCardCheck          ; KssContext+0xC8 (7): fopen_api('C:', ...) and fclose_api; when it fails shows 'Es ist keine SD Card im Schacht' / 'Bitte setzen Sie eine SD Card ein ...' and returns 0, else 1
0x483ECC8E  KssTextFieldCopy        ; KssContext+0xD0 (4): (a0 = dest, a1 = src, d0 = n) copies up to n chars, CR / LF / TAB -> space, then pads with spaces to n
0x483EC9BD  KssFwrite               ; KssContext+0xD4 (8): (a0 = buffer, d0 = size, d1 = count, a1 = file) fwrite_api in chunks of at most 0x7FFF bytes -> bytes written
0x483ECA06  KssFread                ; KssContext+0xD8 (7): the same through fread_api
0x483ECCDC  KssStrUpper             ; KssContext+0xDC (1): a..z -> A..Z in place
0x483ECC09  KssFileSkip             ; KssContext+0xE0 (2): (a0 = file, d0 = n) reads and discards n bytes through a 0x400-byte malloc_X buffer -> bytes read
0x483ECA4F  KssFileCopy             ; KssContext+0xE4 (1): _findfirst, fopen_api 'rb' and 'wb', a malloc_X buffer, KssFread / KssFwrite, free_X, both fclose_api
0x483ED266  PtrStrListCreate        ; KssContext+0x118 (11): (a0 = object, d0 = capacity) items := malloc_X(4 * capacity) (KssThrowBug 0x68 when that fails), cleared; vtable PtrStrListVtbl, magic 0xF34E32BB
0x483ED564  StrListCreate           ; KssContext+0x11C (11): (a0 = object, a1 = a PtrStrList, checked by its magic, else KssThrowBug 0xFE) vtable StrListVtbl, magic 0x89426ACE, linked to the list
0x483ED345  PtrStrListAdd           ; PtrStrListVtbl+0x04: (a0 = list, a1 = string) items[count++] := a1; KssThrowBug 0x92 for NULL, 0x93 when full
0x483ED51F  PtrStrListCount         ; PtrStrListVtbl+0x20: -> count (+0x10)
0x483ED553  PtrStrListClear         ; PtrStrListVtbl+0x28: count := 0
