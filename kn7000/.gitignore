# Reference images (extracted from the copyrighted update disks) and build
# products are derived data, regenerated by `make` — never committed.
/baserom/*.rom
/baserom/*.xap
/baserom/*.inf
/baserom/*.sld
/baserom/*.bin
/build/
__pycache__/
*.pyc

# The full linear disassembly is ~30 MB and fully regenerable with `make disasm`;
# only the curated samples (program_entry.asm, table_directory.asm) are tracked.
/disasm/program.asm
/disasm/program_named.asm
/disasm/program_region2.asm

# The program menu's build: build/card/ holds Another World's game files (made from your own copy of the game)
/tools/kn7menu/build/
/tools/dsptone/build/
