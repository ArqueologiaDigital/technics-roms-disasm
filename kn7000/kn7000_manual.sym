; ---- MIDI (MN10300 on-chip serial SC1/SC2 @ 0x34000810/0x34000820) ---------
; See kn7000_mame/notes/midi-rx.md, boot-performance-and-clock.md.
0x484B1E86  Midi1RxIsr              ; MIDI port 1 RX ISR (ICR 0x34000148, group 0x12)
0x484B2037  Midi2RxIsr              ; MIDI port 2 RX ISR (ICR 0x34000150, group 0x14)
0x484B2691  MidiBaudTimerSetup      ; sets TM3MD/TM3BR (=0x3F) : baud = IOCLK/8/(TM3BR+1) = 31250
0x484B2793  MidiSerialInit          ; SC1/SC2 init: 8N1, CK=Timer3-underflow/8
;
; ---- Tone generators (main 0x98040000 / sub 0x98050000) --------------------
; Register-indirect 32-bit writes (HIGH16->base+0 addr, LOW16->base+2 data).
; See kn7000_mame/notes/tone-generator.md. (The helper has main & sub tails
; sharing one epilogue; ToneGenWriteMain is the main-TG store path.)
0x487EFF92  ToneGenWriteMain        ; write a main-TG register (addr in d1, data in d2)
;
; ---- Data tables (reference only; commented so the code disassembler skips
;      them — these are DATA, not code) --------------------------------------
; 0x48735EE4  RhythmGenreNameTable   ; 16 records x 0x18, "[H"+centred name (8&16 BEAT..MEMORY)
; 0x4860C9F4  PanelSwitchClassTable  ; service panel-test mode: switch# -> [LED reg, value]
; 0x486135A0  PanelWireNormTable     ; wire (bank<<1|sub) -> normalized segment
; 0x48614978  ButtonDescPtrTableA    ; per-normSeg descriptor pointer table (bank A = KN7000)
; 0x486149FC  ButtonDescPtrTableB    ; per-normSeg descriptor pointer table (bank B)
; 0x4872573C  ClutPaletteSeedTable   ; 256x 0x00BBGGRR CLUT seed (idx 0x1D-0xF3 = green placeholder)
; 0x485FDD5C  PartNameStringPool     ; ASCII pool: "PART 1".."PART 16","RIGHT 1/2","LEFT","ACCOMP 1-5","BASS","DRUM 1/2","CHORD","R.BASS","PADS","BASS PEDAL","CHORDFINDER","MICROPHONE","APC","CONTROL"
; 0x485FDE70  PartNamePtrTable       ; u32 ptrs into PartNameStringPool; entry [0]=PART 1 (16 MIDI parts, then keyboard sections)
; 0x485FDEB0  KeyboardPartNames      ; = PartNamePtrTable+16: keyboard/mixer parts (RIGHT 1/2,LEFT,ACCOMP 1-5,BASS,DRUM 1/2,CHORD,R.BASS,PADS,PADS,BASS PEDAL,CHORDFINDER,MICROPHONE,APC,CONTROL) — matches the home-screen mixer
; 0x485FDED0  AccompPartNames        ; = PartNamePtrTable+24: auto-accompaniment subset (BASS,DRUM 1/2,CHORD,R.BASS,PADS,...)
; 0x485FDD0C  CprSoundModeNames      ; CPR-board sound-mode labels: DIGITAL DRAWBAR, ACCORDION REGISTER, SOUND EXPLORER, EW EXPANSION, ORGAN TABS

; ---- RHYTHM/STYLE NAME MODULE (0x484332F9..0x48433C1E) -----------------------
; The whole style NAME + RECORD path, converted 2026-07-20 (see
; kn7000_mame/notes/sequenced-playback-and-style-data-rootcause.md 2a and
; notes/rhythm-name-list-bug.md). Three SOURCES of a style, selected by the
; style-ID's bits 0x00700000 and cached in *(0x50034B94):
;   0          = BUILT-IN  ("Technics Rhythms" flash resource, base 0x50034B78)
;   0x00100000 = MEMORY    (user styles, via 0x484355E2 / 0x484355F8)
;   0x00200000 = CUSTOM    (custom-flash styles, via 0x4848457D / 0x4843E1xx)
; RAM: 0x50034B74 count / 0x50034B78 resource base / 0x50034B7C u16 name table /
;      0x50034B80 3-byte-offset sub-table / 0x50034B84 variation sub-table /
;      0x50034B88 fallback name / 0x50034B8C selected NAME RECORD /
;      0x50034B90 secondary sub-table (table ROM seg59 0x48244F78) /
;      0x50034B98 custom-source handle / 0x50034B9C 13-byte display name /
;      0x50034BAC[8] sub-record ptrs / 0x50034BCC[20] variation-record ptrs /
;      0x50034C1C bound style record / 0x50034C20 its data area /
;      0x50122DC0..0x50122DD4 the bound record's runtime view.
0x484332F9  StyleBuiltinNameTableInit  ; (a0 = resource window) opens the "Technics Rhythms" resource (name string 0x4872980C, lib strncmp 0x4C00203C) and populates the style-name-table globals 0x50034B74/78/7C/80/84/88; then re-points 0x50034B7C at the table-ROM copy (TableRomStyleResourcePtr, seg83 0x483E828C) when that one also carries the signature. RUNTIME-CONFIRMED to SUCCEED -- the "8 Beat 1" bug is downstream, in per-style resolution
0x484332FE  StyleBuiltinNameTableInit_entry
0x484333FF  StyleNameSourceSet         ; (d0 = style-ID) -> a0 = the 13-byte NAME RECORD, cached in *(0x50034B8C); index = ((id & 0x0F00) >> 1) | (id & 0x7F), source = id & 0x00700000 (0 = builtin -> StyleBuiltinNameResolve, 0x200000 = custom -> 0x4848457D, else MEMORY -> 0x484355E2). Returns 0 when the record is unchanged
0x48433404  StyleNameSourceSet_entry
0x484334A9  StyleNameCommit_entry
0x4843351B  StyleNameCommitMem         ; MEMORY-source twin of StyleNameCommit: 13-byte name copy, then the 20 variation-record pointers 0x50034BCC[] resolved from the bytes at record+0x50 through 0x484355F8; data area = record+0x70
0x48433520  StyleNameCommitMem_entry
0x48433569  StyleNameCommitCustom      ; CUSTOM-source twin: same shape, records resolved through 0x4843E10C against the custom-source handle *(0x50034B98)
0x4843356E  StyleNameCommitCustom_entry
0x484335BF  StyleVariationNameGet      ; (d0 = variation slot 0..19) -> a0 = the variation's NAME. Takes the low 3 bits of the record byte +1 (builtin) or +0x11 (MEM/CUSTOM) as a variation kind, asks the library resource dispatcher (LibResourceLookup path, resource 0x0000D00A via lib 0x4C0149FA) and on success indexes the ROM pointer table 0x48736078; otherwise falls back to the 3-byte-offset variation sub-table *(0x50034B84) into the resource base *(0x50034B78). Sets the "name resolved" flag 0x50122DD0
0x484335C4  StyleVariationNameGet_entry
0x48433643  StyleRecordSlotSelect      ; (d0 = group < 0x0C, d1 = slot <= 0x14, arg5 = index) selects one of the 20 cached style records 0x50034BCC[] as the CURRENT record *(0x50034C1C); slot 0x14 goes through StyleVariationNameGet first. The group index must be a multiple of 3. Returns the newly selected record, or 0 when unchanged
0x48433648  StyleRecordSlotSelect_entry
0x484336DB  StyleRecordBindBuiltin     ; publishes the current BUILT-IN style record *(0x50034C1C) into the pattern-player's runtime view: header bytes -> 0x50122DCE/CF, u16BE -> 0x50122DCC, event-stream start 0x50122DC8/C0, end 0x50122DC4, aux 0x50122DD4 (the stream is expected to end with the 0xF4 terminator)
0x484336E0  StyleRecordBindBuiltin_entry
0x4843374A  StyleRecordBindMem         ; MEMORY twin of StyleRecordBindBuiltin (record fetched through 0x48435614; eight sub-record pointers at 0x50034BAC[], stride 0x18, from record+0x20)
0x4843374F  StyleRecordBindMem_entry
0x484337D0  StyleRecordBindCustom      ; CUSTOM twin (record fetched through 0x4843E128 against *(0x50034B98))
0x484337D5  StyleRecordBindCustom_entry
0x4843385E  StyleNameModuleBoot        ; boot entry of the style-name module: StyleResourceWindowProbe picks the resource window (cached at 0x5000775C), StyleBuiltinNameTableInit opens it, and on failure the program-ROM STUB resource 0x48729988 is used instead -- which is exactly the fallback that makes every style display "  8 Beat 1" in emulation. Then clears the 20 record slots and the current record
0x48433863  StyleNameModuleBoot_entry
0x484338AF  StyleResourceVerify        ; integrity check of a probed resource window: signature strncmp, then a checksum (0x484403A7) over the block at u24BE(+0x12) of length u24BE(+0x15) compared against the u16BE at +0x10. Returns 0 / -1
0x484338B4  StyleResourceVerify_entry
0x48433919  StyleNameSelectCommit      ; StyleNameSourceSet + the matching per-source name commit (builtin / MEM / CUSTOM). Returns 1 when a new name was committed
0x4843391C  StyleNameSelectCommit_entry
0x48433960  StyleSlotRecordDiffers     ; (d0 = group, d1 = slot) -> 1 when 0x50034BCC[group+slot] is not the currently bound record *(0x50034C1C); 0 for group outside 0x0C..0x13
0x48433962  StyleSlotRecordDiffers_entry
0x4843398F  StyleRecordSelectBind      ; StyleRecordSlotSelect + the matching per-source record bind; returns 1 when a record was bound
0x48433994  StyleRecordSelectBind_entry
0x484339F4  StyleNameAndRecordSelect   ; the full "style changed" path: name select+commit, then record select+bind, in one call
0x484339F9  StyleNameAndRecordSelect_entry
0x48433A80  StyleNameBufCopy           ; (a0 = dest) strcpy the 13-byte display name buffer 0x50034B9C out to the caller; always returns 1
0x48433A95  StyleBoundRecByteCfGet     ; -> the bound record's header byte 0x50122DCF -- retf leaf
0x48433A9E  StyleBoundRecByteCeInc     ; -> the bound record's header byte 0x50122DCE + 1 -- retf leaf
0x48433AA9  StyleBoundRecByteCfLow3    ; -> 0x50122DCF & 7 (the variation kind) -- retf leaf
0x48433AB6  StyleVariationNameFlagGet  ; -> 0x50122DD0, the "variation name was resolved" flag set by StyleVariationNameGet -- retf leaf
