; ---- THE LOCAL-EDIT LIFECYCLE (2026-07-20): who SETS and who CLEARS bit0 of
;      the 9-byte per-part edit-state record 0x500C58AE+part*9. Byte 0 is the
;      flag byte (bit0 = TgPartLocalEditActive, bit1 = "this part may be
;      edited"); bytes 1..6 are edit parameters seeded from ROM defaults.
0x4C00C890  TgPartAuxHdrDerive      ; (d0 part) recompute aux header bytes +0x4D..+0x53 from the part record 0x500B5340+part*0x54C (halfword +0 bits 0x80/0x02/0x40, bytes +6/+0x15/+0xE/+0xF/+0x14, channel field +0x62 bits 10..8)
0x4C00C892  TgPartAuxHdrDerive_entry
0x4C00C96C  TgPartAuxRecRefresh     ; (d0 part) full aux refresh: TgPartAuxRecBuild_entry, then the four mod units through TgPartAuxElemRecBuild_entry, then aux byte +0x44 bit7 = (part != 6), then TgPartAuxHdrDerive_entry
0x4C00C971  TgPartAuxRecRefresh_entry
0x4C00CA19  TgPartAuxModAllEnabled  ; (d0 idx) -> 0 when all four mod units have bit7 set in BOTH +0x52 and +0x56, else 1
0x4C00CA1B  TgPartAuxModAllEnabled_entry
0x4C00CA67  TgPartEditStateDefaults ; (d0 part) seed the 9-byte edit-state record's bytes 1..6 from the ROM defaults 0x486D3192/94/95/97/98; byte 1 becomes 1 or -0xB depending on TgPartAuxModAllEnabled_entry
0x4C00CA6C  TgPartEditStateDefaults_entry
0x4C00CABD  TgPartLocalEditRecBuildAll ; (d0 part) copy the tone descriptor into the scratch, then rebuild all 0x80 shadow records: for each idx the 0x8E record (TgPartLocalEditRecBuild_entry, seeded from ROM table 0x500C1003+idx*7) and its two element sub-records
0x4C00CAC2  TgPartLocalEditRecBuildAll_entry
0x4C00CB3F  TgPartLocalEditActivate ; ★ THE SETTER of bit0. (d0 part) only for parts 0x10..0x12 (or a part already flagged bit0+bit1); returns at once if bit0 is already set, otherwise SETS bit0, refreshes the aux record, seeds the edit-state defaults and re-applies the tone. Called lazily by the SOUND EDIT parameter get/set APIs -- the shadow springs into existence the first time a parameter is touched
0x4C00CB44  TgPartLocalEditActivate_entry
0x4C00CBC2  TgPartLocalEditSelect   ; (d0 part) make `part` the CURRENT edit part: if the global 0x500C59E0 already names a different part, CLEAR that part's flag byte (TgPartLocalEditClear) and re-apply its unedited tone, then set 0x500C59E0 = part, set bit0 and build the whole shadow (TgPartLocalEditRecBuildAll_entry)
0x4C00CBC7  TgPartLocalEditSelect_entry
0x4C00CCB1  TgLocalEditPartSet      ; 0x500C59E0 = d0 (the current-edit-part global; 0xFF = none) -- retf leaf
0x4C00E5C0  TgPartLocalEditClear    ; ★ THE CLEARER. (d0 part) zero byte 0 of 0x500C58AE+part*9 -- bit0 goes away, so the tone-apply layer stops reading the RAM shadow and falls back to the read-only resource record. Nothing frees the shadow: the edit is discarded purely by dropping this bit
0x4C00E5D2  TgLocalEditResetAll     ; boot-time reset: 0x500C59E0 = 0xFF and TgPartLocalEditClear for all 0x22 parts (called from the lib bring-up 0x4C004069)
0x4C00E5D7  TgLocalEditResetAll_entry

; ---- the region-1 VOICE-RESOURCE BANK FETCHERS (2026-07-20). Five resource
;      banks; a class code 0..4 (from the classifier 0x485713DB) picks the bank
;      descriptor 0x5003A5A4+class*4 and its load base 0x5003A554+class*4.
;      Descriptor +0x04/+0x14 = record directories (dword offsets), +0x18 = the
;      element table (stride 0x23). Records are 0x8E bytes: +0x10 sub-records
;      (0x1C), +0x54 mod units (0x7A).
0x484496C9  VoiceRecFetchBanked     ; (d0 idx&0x7F, d1 class-arg, stack) -> the 0x8E voice resource record, via the +0x14 directory of the selected bank
0x484496CE  VoiceRecFetchBanked_entry
0x4844978B  VoiceSubRecFetch        ; (d0 part, d1 idx, stack) -> record +0x10+n*0x1C, where n = 0x484494E4(part, record byte +0x0D); 0xFF means "no override" and VoiceSubRecDefaultPtr_entry supplies the default
0x48449790  VoiceSubRecFetch_entry
0x484497CB  VoiceModRecDefaultPtr   ; -> the DEFAULT record's first mod unit (bank 0 pointer 0x5003A590, +0x54) -- retf leaf
0x484497E0  VoiceRecDefaultPtr      ; -> the DEFAULT voice record: 0x5003A590+4 when non-zero, else the bank-0 directory's entry 0 -- retf leaf
0x48449810  VoiceSubRecDefaultPtr   ; -> VoiceRecDefaultPtr + 0x10 (the default +0x10 sub-record) -- the fallback TgPartLocalEditRecBuild uses
0x48449813  VoiceSubRecDefaultPtr_entry
0x4844981D  VoiceElemRecFetchBank0  ; -> VoiceElemRecFetch_entry(0, 0): element record 0 of bank 0
0x4844982A  VoiceModRecFetch        ; (a0 record, d0 part, d1 unit) -> record +0x54+unit*0x7A; parts 0x22/0x23/0x2A/0x2B take that directly, the rest remap the unit through 0x484494E4(part, record byte +0x11) and fall back to VoiceModRecDefaultPtr
0x4844987C  VoiceElemRecFetch       ; (d0 elem, d1 class) -> element record: bank descriptor +0x18 table + elem*0x23
0x4844987E  VoiceElemRecFetch_entry

; ---- ★ THE FIVE VOICE-RESOURCE BANK SOURCES + the MIDI-keyed classifier
;      (region 1, 2026-07-20).  Full write-up:
;      kn7000_mame/notes/sound-bank-classes.md
;
;      Every voice lookup starts from a MIDI-SHAPED TRIPLE -- exactly what the
;      SOUND EXPLORER screen prints next to each sound as "[32.11-1"
;      (kn7000_mame/notes/sound-gui-inventory.md p35):
;          d0        = PROGRAM CHANGE number (masked &0x7F by the caller)
;          d1        = BANK SELECT LSB
;          arg5 (sp) = BANK SELECT MSB
;      The classifier packs them into one 24-bit key
;          key = (MSB << 16) | (LSB << 8) | PROGRAM
;      and asks each source, in order 1,2,3,4, whether it is fitted
;      (VoiceBankSourcePresent -> VoiceBankSourceFlagGet -> presence byte
;      0x501496B4+source-1); the first source whose archive contains the key
;      wins.  Source 0 (the INTERNAL archive) is the always-present fallback.
;      The number of the winning source IS the class code 0..4 that
;      VoiceRecFetchBanked / VoiceParamRecFetchBanked then use to pick the bank
;      descriptor 0x5003A5A4+class*4 and load base 0x5003A554+class*4.
;
;      THE FIVE SOURCES (address window / directory pointer at window+0x0C):
;        class 0  INTERNAL  0x48000000, directory pointer at 0x48000018 -- the
;                 program+table flash's own resource archive (factory PRESET
;                 sounds; the only source that is always present)
;        class 1  0x57000000 -- factory read-only DATA flash
;        class 2  0x56000000 -- CUSTOM flash (disk-programmed data)
;        class 3  0x41000000
;        class 4  0x41800000
;      Sources 1..4 are all validated the same way by the boot archive parser
;      0x48449EF4..0x4844A3D1: header self-check *(base) + base == base+0x200
;      and a 16-byte signature compare against "Expansion Board" (0x485B8518),
;      then the presence byte 0x501496B4+n is set and the per-source directory
;      pointers are cached in 0x5003A554.. / 0x5003A5A4...  Which panel button
;      (SOUND GROUP "MEMORY" vs "EW EXPANSION") maps to which of classes 1..4
;      is NOT settled here -- that needs a live session with a card fitted.
;
;      Each source has its own lookup routine; all ten are the same
;      multiplicative-hash bucket walk over the archive's sound directory
;      (bucket = (key*mult) % nbuckets via *HashIndex, chain compare via
;      *KeyEqual, chain link at entry+0, payload halfword at entry+8).
;      Family A (VoiceBank*, used by VoiceRecFetchBanked) returns the raw
;      halfword index; family B (VoiceParamBank*, used by
;      VoiceParamRecFetchBanked) additionally treats bit15 as "entry invalid"
;      and degrades: exact key -> LSB rounded down to a multiple of 8 ->
;      LSB-only -> the 0x7F7F default.
0x485713D6  VoiceBankClassify       ; (d0 program, d1 bank LSB, a0 out u16 index, a1 out u8 class, arg5 bank MSB) -> 1 when resolved; MSB==0 short-circuits to the internal archive
0x485713DB  VoiceBankClassify_entry
0x4857150D  VoiceBankLookupInternal ; hash lookup in the class-0 archive (0x48000000, dir ptr *(0x48000018))
0x48571512  VoiceBankLookupInternal_entry
0x48571580  VoiceBankLookupSrc1     ; hash lookup in the class-1 archive (0x57000000, dir ptr *(0x5700000C))
0x48571585  VoiceBankLookupSrc1_entry
0x485715F3  VoiceBankLookupSrc2     ; hash lookup in the class-2 archive (0x56000000, dir ptr *(0x5600000C))
0x485715F8  VoiceBankLookupSrc2_entry
0x48571666  VoiceBankLookupSrc3     ; hash lookup in the class-3 archive (0x41000000, dir ptr *(0x4100000C))
0x4857166B  VoiceBankLookupSrc3_entry
0x485716D9  VoiceBankLookupSrc4     ; hash lookup in the class-4 archive (0x41800000, dir ptr *(0x4180000C))
0x485716DE  VoiceBankLookupSrc4_entry
0x4857174C  VoiceBankKeyEqual       ; (d0,d1) -> 1 when the chain entry's key matches -- retf leaf
0x48571757  VoiceBankHashIndex      ; (d0 key, d1 mult, arg nbuckets@0x14,sp) -> (key*mult) % nbuckets
0x48571759  VoiceBankHashIndex_entry
0x48570C41  VoiceParamBankClassify  ; the family-B classifier: same five sources, but bit15 of the entry marks it invalid and misses fall back LSB-family -> LSB-only -> 0x7F7F
0x48570C46  VoiceParamBankClassify_entry
0x48570DF8  VoiceParamBankLookupInternal ; class-0 archive (0x48000000)
0x48570DFD  VoiceParamBankLookupInternal_entry
0x48570E6B  VoiceParamBankLookupSrc1 ; class-1 archive (0x57000000)
0x48570E70  VoiceParamBankLookupSrc1_entry
0x48570EDE  VoiceParamBankLookupSrc2 ; class-2 archive (0x56000000)
0x48570EE3  VoiceParamBankLookupSrc2_entry
0x48570F51  VoiceParamBankLookupSrc3 ; class-3 archive (0x41000000)
0x48570F56  VoiceParamBankLookupSrc3_entry
0x48570FC4  VoiceParamBankLookupSrc4 ; class-4 archive (0x41800000)
0x48570FC9  VoiceParamBankLookupSrc4_entry
0x48571037  VoiceParamBankKeyEqual  ; (d0,d1) -> 1 on key match -- retf leaf
0x48571042  VoiceParamBankHashIndex ; (d0 key, d1 mult, arg nbuckets) -> (key*mult) % nbuckets
0x48571044  VoiceParamBankHashIndex_entry
0x48448C0F  VoiceBankSourcePresent  ; (d0 source 1..4) -> 0 when that source archive is fitted, -1 otherwise (the classifier's per-source gate)
0x48448C21  VoiceBankSourcePresentAlt ; same shape over the stubbed probe VoiceBankSourceFlagStubB -- always reports "absent" in this firmware
0x48448C36  VoiceBankSourceQuery    ; (d0 source) -> u8 answer from 0x48570941 (per-source archive query)
0x4844A3D4  VoiceBankSourceFlagGet  ; (d0 source) -> presence byte 0x501496B4+source-1 for source 1..4, else 0; the four flags are set by the boot archive parser
0x4844A3EE  VoiceBankSourceFlagStubB ; retf 0 -- second presence probe, stubbed out in this firmware
0x4844A3F2  VoiceBankSourceFlagStubC ; retf 0 -- third presence probe, stubbed out
0x48449925  VoiceParamRecFetchBanked ; (d0 program&0x7F, d1 bank LSB, stack bank MSB) -> the 0x10-byte per-sound PARAMETER record, from the winning bank descriptor's +0x1C directory + index*0x10
0x4844992A  VoiceParamRecFetchBanked_entry
0x4844A42F  CustomVoiceRecFetch     ; (d1 idx) -> a 0x8E voice record inside the resource block 0x4848463F(): block+0x1A7+idx*0x8E; when the block is absent it reports error 0x26 and re-resolves through VoiceRecFetchBanked_entry using the 3-byte {program, bank LSB, bank MSB} triple stored at block+0x27+idx*3
0x4844A434  CustomVoiceRecFetch_entry
0x4844ABF7  UserVoiceRecPtr         ; (d1 idx) -> user/MEMORY voice record *(0x501496B8) + 0x70F7 + idx*0x8E -- rets leaf

; ---- ★ DIGITAL DRAWBAR (library 0x4C00A1F7..0x4C00A90C, 2026-07-20) --------
; The per-part DRAWBAR REGISTRATION record lives at 0x500082C8+part*0x1C:
;   +0x00/+0x02/+0x04  three 12-bit registration words; each holds three
;                      4-bit drawbar levels. The scatter table 0x486D10A0
;                      (3 x 3 bytes) maps word->slot: word0 nibbles -> slots
;                      0,1,6 / word1 -> 3,5,8 / word2 -> 2,4,7, so the nine
;                      slots come out in DISPLAY order 16' 5 1/3' 8' 4'
;                      2 2/3' 2' 1 3/5' 1 1/3' 1' (manual p36).
;   +0x06              PERCUSSIVE TONE, 2 bits (the 2 2/3' and 4' buttons)
;   +0x08 ATTACK TIME, +0x09 RELEASE TIME, +0x0A PERCUSSIVE TONE DECAY,
;   +0x0B PERCUSSIVE TONE LEVEL -- all stored as SIGNED offsets and applied
;                      on top of the sound's tone parameters, see
;                      TgPartDrawbarOffsetApply
;   +0x0C/+0x0E/+0x10  level words derived from the registration
;   +0x19              drawbar TYPE flag (the <Jazz Drawbars>/<Rock Drawbars>
;                      button; 0/1)
; Scratch: 0x50009930 = the 9 unpacked drawbar levels, 0x50009939/3A/3B the
; scan results, 0x5000993C = the four captured registration words.
; Screen inventory: kn7000_mame/notes/sound-gui-inventory.md (DIGITAL DRAWBAR,
; manual p36); the +/-offset clamp is shared with the SOUND EDIT shadow.
0x4C00A1F7  TgDrawbarToneRecInit    ; (d0 part, d1 tone, stack 3 bytes) seed the 0x23-byte drawbar tone record at 0x50008698+part*0x8C+tone*0x23 from the ROM template 0x48586E60, then fill its six 5-byte sub-entries at +5 with (arg0&0x7F, arg1, arg2)
0x4C00A253  TgPartDrawbarCapture    ; (d0 part) CAPTURE the sound's registration: for each of the four tone-block mod units of 0x500CE404+part*0x130 read bytes +4/+5 as a 16-bit word into 0x5000993C+unit*2 and its low 12 bits into the drawbar record; if the tone class (+8) is 0x10 or 0x4C0384C4(part)==0x18 push the four words on through 0x4C008679
0x4C00A258  TgPartDrawbarCapture_entry
0x4C00A2F1  TgPartDrawbarTypeSet    ; (d0 part) drawbar record +0x19 = 1 (Rock/Jazz drawbar TYPE flag) -- rets leaf
0x4C00A307  TgPartDrawbarTypeClear  ; (d0 part) drawbar record +0x19 = 0 -- rets leaf
0x4C00A31C  TgPartDrawbarTypeGet    ; (d0 part) -> drawbar record +0x19 -- rets leaf
0x4C00A330  TgPartDrawbarRegExport  ; (d0 part, a0 out) export the registration as bytes: for words 0..2 write (word & 0xFF) then ((word>>8) & 0x0F), then the PERCUSSIVE TONE nibble from +6 and a 0 terminator (8 bytes)
0x4C00A389  TgPartDrawbarUnitEnable ; (d0 part) set/clear bits 0..3 of the halfword at 0x500CE404+part*0x130+4 -- one enable bit per registration word, set when that word is non-zero, so an all-zero footage group switches its tone unit off
0x4C00A38E  TgPartDrawbarUnitEnable_entry
0x4C00A44C  TgDrawbarNibbleScatter  ; (d0 12-bit word, d1 group, a0 out) scatter the word's three nibbles into out[] at the slots named by 0x486D10A0+group*3 -- the table that puts the nine drawbars into display order
0x4C00A44E  TgDrawbarNibbleScatter_entry
0x4C00A483  TgDrawbarLevelsScan     ; (a0 the three registration words, d0/d1/a1 outputs) unpack all nine drawbar levels into 0x50009930 via TgDrawbarNibbleScatter_entry, then scan them: count of non-zero drawbars, index of the first maximum and index of the last non-zero
0x4C00A488  TgDrawbarLevelsScan_entry
0x4C00A519  TgPartDrawbarLevelsDerive ; (d0 part) run TgDrawbarLevelsScan_entry over the part's registration and fold its three results through the s16 curve tables 0x486D10AA / 0x486D10BE / 0x486D10D0 / 0x486D10E2 / 0x486D10F6 into the derived level words at record +0x0C/+0x0E/+0x10
0x4C00A51E  TgPartDrawbarLevelsDerive_entry
0x4C00A594  TgPartDrawbarOffsetsReset ; (d0 part) zero the four offset bytes +0x08..+0x0B (ATTACK / RELEASE / PERC DECAY / PERC LEVEL back to centre) and refresh through TgPartDrawbarUnitEnable_entry + TgPartDrawbarLevelsDerive_entry
0x4C00A5C7  TgPartDrawbarPairSet1   ; (d0 part, d1 packed pair) drawbars 1+2 (16', 5 1/3'): word0 low byte := d1
0x4C00A5FB  TgPartDrawbarPairSet2   ; (d0 part, d1 packed pair) drawbars 3+4 (8', 4'): word2 bits0-3 := d1&0xF, word1 bits0-3 := d1>>4
0x4C00A653  TgPartDrawbarPairSet3   ; (d0 part, d1 packed pair) drawbars 5+6 (2 2/3', 2'): word2 bits4-7 := d1&0xF, word1 bits4-7 := d1>>4
0x4C00A6AB  TgPartDrawbarPairSet4   ; (d0 part, d1 packed pair) drawbars 7+8 (1 3/5', 1 1/3'): word0 bits8-11 := d1&0xF, word2 bits8-11 := d1>>4
0x4C00A702  TgPartDrawbarPairSet5   ; (d0 part, d1 packed pair) drawbar 9 (1') + PERCUSSIVE TONE: word1 bits8-11 := d1&0xF, record +6 := (d1&0x30)>>4 -- the two percussive-tone buttons
0x4C00A74D  TgPartDrawbarAtkRlsSet  ; (d0 part, d1 packed pair of 4-bit indices) DRAWBAR ATTACK TIME / RELEASE TIME: record +8 := (s8)0x48586E84[d1>>4]<<2, +9 := (s8)0x48586E84[d1&0xF]*2 -- the table is the signed ladder 0,1,..,7,-8,..,-1
0x4C00A786  TgPartDrawbarPercSet    ; (d0 part, d1 packed pair of 4-bit indices) PERCUSSIVE TONE DECAY / LEVEL: record +0x0A and +0x0B from the same 0x48586E84 ladder (<<2 and <<3)
0x4C00A7BC  TgEditOffsetAddClamp    ; (d0 current unsigned byte, d1 signed delta, stack max, min) -> clamp(d0 + (s8)d1, min, max) as a byte -- the shared +/- applier behind every offset-style edit parameter (callers pass max 0x64 = 100 or 0x7F)
0x4C00A7BE  TgEditOffsetAddClamp_entry
0x4C00A7E5  TgPartDrawbarOffsetApply ; (d0 part) ★ push the drawbar record onto the part's SOUND EDIT shadow: for each of the four tone mod units write the registration word's low/high byte to aux fields +0x04/+0x05, then add the offset bytes through TgEditOffsetAddClamp_entry -- units 0..2 take +0x0A/+0x0B (percussive decay/level) into aux +0x28/+0x2E clamped 0..100, unit 3 takes +0x08 into aux +0x19 clamped 0..0x7F and +0x09 into aux +0x2A/+0x2C clamped 0..100

; ---- ★ LFO EDIT group loaders (library 0x4C00CCBA..0x4C00D0AC, 2026-07-20) -
; Twelve LFO groups (manual p174 "12 LFO groups") live in the ROM table
; 0x486D2ED5, stride 0x27. Each record carries four (speed, depth, ...) triples
; at +0x00/+0x03/+0x06/+0x09 -- the four LFO EDIT destination pages (PITCH
; MODULATION / AMP / FILTER / PAN). The group is chosen by the low nibble of
; byte +0x44 of the part's tone descriptor, and eight different unpackers
; project the record onto the 8-byte LFO parameter block at +0x45 of the
; per-part SOUND EDIT record 0x500C0784+(part-0x10)*0x2C8 (parts 0x10..0x12,
; the three editable parts -- see TgPartLocalEditActivate).
0x4C00CCBA  TgPartEditLfoLoadA      ; (d0 part, d1 group) groups 0..3: block := rec[0], rec[1], rec[0x1A], rec[0x1C], rec[0x1B], -, rec[0x0E], rec[0x12]
0x4C00CCBC  TgPartEditLfoLoadA_entry
0x4C00CD10  TgPartEditLfoLoadB      ; (d0 part, d1 group) groups 4..5 (two active triples): rec[0], rec[1], rec[3], rec[4], rec[0x1A], rec[0x1C], rec[0x0E], rec[0x12]
0x4C00CD12  TgPartEditLfoLoadB_entry
