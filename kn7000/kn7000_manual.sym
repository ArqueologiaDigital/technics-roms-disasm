;
; ---- SOFT-FLOAT IEEE-754 DOUBLE RUNTIME + libm subset (library image
;      0x4C000000..0x4C001A00 -- the firmware has no FPU; TgPartGlidePlan/
;      TgPartGlideTick's portamento math runs here, and the module is generic
;      compiler runtime shared by any double-typed code). ABI: doubles are
;      passed on the CALLER's outgoing-arg area -- arg1 lo32 at (8,sp) /
;      hi32 at (0xC,sp), arg2 at (0x10,sp)/(0x14,sp) -- and returned in
;      d0 (lo32) : d1 (hi32); the canonical movm prologue is bypassed by the
;      register-save `call X_entry,[regs],frame` form as usual. Unpack class
;      codes (d2/d3): 0 = normal, 1 = Inf, 2 = zero, 4 = NaN. Error cell
;      0x500AD390 (1 = domain, 2 = range) with DBL_MAX / -DBL_MAX / 0
;      returns = a classic errno-style libm. ---------------------------------
0x4C000000  LibF64Pow               ; pow(x,y): y==0 -> 1.0; x==0 -> y<=0 sets errno(0x500AD390)=1 dom, returns 0; else split y via LibF64Modf (integer part -> repeated squaring path, fraction -> LibF64Exp(frac*LibF64Log(x))); negative x only legal for integral y (sign fixed at the end)
0x4C000005  LibF64Pow_entry
0x4C000263  LibF64UnpackedToI32     ; tail core: unpacked double (d0/d1 mantissa, a1 sign copy, a3 exponent field, d3 class) -> signed i32 in d0, truncating; class 2/4 -> 0, class 1 or exp >= 0x41E00000 -> saturate 0x7FFFFFFF/0x80000000, exp < 0x3FF00000 (|x| < 1) -> 0
0x4C0002B3  LibF64ToI32             ; (double at (8,sp)/(0xC,sp)) -> d0 = (int32)x, truncation toward zero: LibF64Unpack then LibF64UnpackedToI32
0x4C0002B8  LibF64ToI32_entry
0x4C0002CB  LibF64Unpack            ; unpack core (retf leaf): double d0:d1 -> d1 = hi-20 mantissa bits w/ implicit 1 restored, d0 = lo32, a3 = exponent field (hi & 0x7FF00000), a1 = original hi word (sign), d3 = class code (0 normal / 1 Inf / 2 zero / 4 NaN; denormals bump a3 one ulp)
0x4C000311  LibF64Log               ; log(x): x==0 -> errno=2, -DBL_MAX; sign bit -> errno=1, 0.0; else LibF64Frexp + LibF64Ldexp(m,1) to m in [1,2), ratio z=(m-sqrt2)/(m+sqrt2) (0x3FF6A09E667F3BCD), odd polynomial in z*z walked from the coeff table 0x48586198..0x485861C0 (Horner via LibF64Div/Mul/Add), + (e - 0.5)*ln2 (0x3FE62E42FEFA39EF, half-term 0x3FD62E42... when the sqrt2 fold applied)
0x4C000316  LibF64Log_entry
0x4C000523  LibI32ToF64             ; (d0 signed i32) -> double d0:d1 (retf leaf): sign/abs split, normalize into exponent base 0x41D00000 (2^30) by shift-and-decrement
0x4C00057D  LibF64Sub               ; arg1 - arg2: flips arg2's sign bit on the stack and falls into LibF64Add
0x4C000582  LibF64Sub_entry
0x4C00058E  LibF64Add               ; arg1 + arg2, full IEEE double add/sub with unpack, operand swap so |a|>=|b|, guard/round shifts, renormalize + repack; specials via the class codes (NaN/Inf/zero fast paths)
0x4C000593  LibF64Add_entry
0x4C0007E2  LibF64Cmp               ; compare arg1 ? arg2 and return with the CPU flags set for SIGNED branches (bge/blt/ble after the call); +-0 fold via the LibF64CmpZero tail when arg2 == 0; the sign-flip is done by xor-ing PSW N|V when the shared-sign magnitude order inverts
0x4C0007E7  LibF64Cmp_entry
0x4C000851  LibF64CmpZero           ; compare arg1 against 0.0: flags set (bne = nonzero), d1 = +2 / -2 / 0 sign code
0x4C000856  LibF64CmpZero_entry
0x4C000874  LibF64Mul               ; arg1 * arg2: 4 x 16-bit cross products for the 53-bit mantissa product, exponent sum - bias, renormalize/round, sign = xor; specials via class codes
0x4C000879  LibF64Mul_entry
0x4C000B17  LibF64Div               ; arg1 / arg2: long division of the mantissas (shift-subtract loop), exponent difference + bias, round, sign = xor; specials via class codes
0x4C000B1C  LibF64Div_entry
0x4C000CD3  LibF64Ldexp             ; ldexp(x at (8,sp), d0 = n): exponent field += n with overflow -> errno=2 + +-DBL_MAX (0x7FEFFFFF.../0xFFEFFFFF...) and underflow -> errno=2 + 0.0; x==0 passes through
