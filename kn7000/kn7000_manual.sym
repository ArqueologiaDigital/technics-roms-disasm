0x4854BCE0  SdCardDetectRaw_entry
0x4854BD34  SdCardDetectDebounce    ; 100-tick (0x50151bfc) insert debounce on the raw read; shadow 0x5000520c, edge tick 0x50005210; removal reports immediately
0x4854BD39  SdCardDetectDebounce_entry
0x4854BD90  SdPowerLineSet          ; subtype!=4: bset bit2 (0x04) of 0x9cc00009 (slot power line)
0x4854BD93  SdPowerLineSet_entry
0x4854BDA9  SdPowerLineClear        ; bclr bit2 of 0x9cc00009
0x4854BDAC  SdPowerLineClear_entry
0x4854BDC2  SdPowerRailSet          ; SdPowerCtrlSet(4): raise 0x98060000 bit2 (SD power rail, shadow 0x50005214)
0x4854BDC5  SdPowerRailSet_entry
0x4854BDCF  SdPowerRailClear        ; SdPowerCtrlClear(4)
0x4854BDD2  SdPowerRailClear_entry
