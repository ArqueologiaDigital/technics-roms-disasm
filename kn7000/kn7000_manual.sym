0x484ADCA0  PanelBtnSuppressCheck_entry
0x484ADCCD  PanelBtnActType0        ; action type 0: post 0x10000000|event with ((DATA&CHANGED&mask)>>shift)+(arg<<8) payload
0x484ADCD2  PanelBtnActType0_entry
