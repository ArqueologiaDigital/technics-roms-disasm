0x484A0B39  PartFlagsSet            ; (d0 = part 0..0x13, d1 = flags) set a part's flag byte through 0x484B1780; parts 0x0E..0x13 additionally get bit 0x04 forced when 0x484ABAFD returns 0
0x484A0B3E  PartFlagsSet_entry
