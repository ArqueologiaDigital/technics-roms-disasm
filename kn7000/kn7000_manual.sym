;
; ---- SD-card subsystem: mount state machine (0x485517E0..0x48552257) --------
; UI-side supervisor around the disk worker. State byte 0x50083cd8 (SD_Get/
; SetState): 0 idle, 1 = mount requested (card inserted), 2 = mount job
; running, 3 = MOUNTED, 4 = mount failed. Status block 0x50083bxx: 0x50083bc1
; card-busy, 0x50083bc2 card-ready (1 ok / 2 fs-init failed), 0x50083bc3
; error flags (bit0 info, bit1 dir, bit2 playlist), 0x50083bc4 done flag,
; 0x50083bc5 busy-UI flag, 0x50083bc8/0x50083bcc = {job, done} callback pair
; run by the job poster 0x484729AD, 0x50083bac.. handles (-1 = closed).
; Pending-eject latch 0x500058a0 (1 = removed while mounting, 2 = re-insert).
; Insert/remove message = 0x107020BB (SdCardInsertMsgHandler). See
; kn7000_mame/notes/sd-card-emulation-plan.md + the kn7000-sd-strap-gate notes.
0x485517E0  SdStateReset            ; full reset to idle: state:=0, clear the favorites dir (FavFormat_entry), close handles 0x50083bac..b2:=-1, clear 0x50083bb6..ba/bbf/bc4/bc5, defaults 0x50083bc6/c7 from ROM 0x4868da64
0x485517E3  SdStateReset_entry
0x48551872  SdUnmountCleanup        ; unmount: same teardown without touching the state byte or 0x50083bb6..ba
0x48551875  SdUnmountCleanup_entry
0x485518D8  SdStateResetCall        ; thin wrapper -> SdStateReset
0x485518DB  SdStateResetCall_entry
0x485518E3  SdHookNops              ; 3x retf filler
0x485518EC  SdUiBusyBegin           ; busy-UI flag 0x50083bc5:=1 + 0x4851abae(d0)
0x48551902  SdUiBusyEnd             ; if flagged: 0x4851abe9 + clear
0x48551920  SdCardInsertMsgHandler  ; system message hook: UI mode 0xFC ignored; msg 0x107020BB: d1==0 REMOVE -> card-busy:=0, VFS invalidate 0x48565f64, state 2 -> pending-eject:=1 else unmount+state:=0, card-ready:=0; d1==1 INSERT -> 0x48565f67, pending 0 -> state:=1 (kicks the mount) / 1 -> pending:=2; forwards to the SD-audio notifier 0x48578ddd
0x48551925  SdCardInsertMsgHandler_entry
0x485519B7  SdStateMachineTick      ; THE demand-driven SD supervisor, dispatch on SD_GetState: 1 -> gate SdMountBusyCheck==0, install {SdMountWorker,SdMountDone} at 0x50083bc8/cc, state:=2, schedule via job poster 0x484729AD; 2 -> pump the job runner 0x48472a55; 3 -> SdUiMountGateCheck then UI supervision (event 0x106 + error bit1 -> property 0x0006008F dialog; 0x108/109/10B/10C/113/120 screen syncs gated on card-busy 0x50083bc1); 4 -> failed-mount UI (0x48551d2a); 0 -> idle UI resync (0x48551f28); properties on object 0x0210033F via 0x484298a0
0x485519BC  SdStateMachineTick_entry
