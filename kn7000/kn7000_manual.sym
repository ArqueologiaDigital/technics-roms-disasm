0x48551F92  SdMountWorker_entry
0x4855203A  SdMountDone             ; mount completion (pointer-installed): result<0 -> state 4 else state 3 (MOUNTED); done flag 0x50083bc4:=1; pending-eject 1 -> unmount+ready:=0, 2 -> unmount+state:=1; SD-audio notifies 0x4857926f/0x48578ff0
0x485520AF  SdSyncWorker            ; re-sync job (installed by SdMountSyncPost): card gates + SdCardFsInit + card-ready, then rescan 0x4855fab3
0x4855210B  SdSyncDone              ; re-sync completion: state 3/4 + the same pending-eject handling
