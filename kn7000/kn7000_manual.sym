0x4C02BF8B  TgLevelTermFinalize_entry
;
; ---- the per-part TYPE-7 EG TIME-RAMP module (the curve helpers under
;      TgVoiceEgSegParamGet; closes the whole 0x4C011730..0x4C011F2F gap).
;      State: 8-byte record 0x50009D38+part*8 -- byte0 = flags (bit0 active,
;      bit1 engaged input, bit2 engaged latch, bit3 rampA done, bit4 hold-off),
;      byte1/byte2 = tick counters (max 0x4F / 0x96), +4/+6 = the two Q8.8
;      time scales (0x100 = 1.0). Enable = partrec halfword bit 0x1000 AND
;      tone type 7 (tone rec +0x44 & 0xF); the dispatcher ticks all 0x22
;      parts and runs an engage/release edge state machine, ramping the
;      scales through curve ROMs 0x4858712C/0x4858717C. Setters refresh the
;      LIVE voices: part class-reg list via TgPartClassRegCollect ->
;      TgGlobalRegWriteBoth_entry, per-slot EG via TgVoiceEgSegParamGet/
;      FlagTest entries -> TgVoiceReg0401Write/TgVoiceReg0405Write.
;      WHICH panel feature drives partrec bit12 is still open (candidate:
;      the part sustain/damper response of sustaining type-7 tones). --------
0x4C011730  TgPartEgRampInit        ; (d0 part, d1 phase) phase 0: partrec bit 0x1000 set -> state {flags 0x0F, cnt 0x4F/0x96, scales 0x100/0x100} else {flags 1, cnt 1/1, scales 0/0}; phase != 0: flags := (flags & 5) | (partrec bit 0x1000 ? 2 : 0) -- the engage-input writer; tone type != 7 -> whole state zeroed
0x4C011732  TgPartEgRampInit_entry
0x4C01180E  TgPartEgRampScaleASet   ; (d0 part, d1 scale) scale A (+4) := scale, then LIVE refresh: ratio = TgVoiceEgSegParamGet-style scaled read via 0x4C03A315(part, 1), part class regs (mask 0x11) rescaled via TgGlobalRegWriteBoth_entry, and every sounding slot of the part (TgVoiceListCollectPartAll_entry) gets EgSegParamGet*FlagTest (sel 1) -> TgVoiceReg0405Write
0x4C011814  TgPartEgRampScaleASet_entry
0x4C0118E3  TgPartEgRampScaleAGet   ; (d0 part) -> raw scale A halfword +4 (retf leaf)
0x4C0118F5  TgPartEgRampScaleACurve ; (d0 part) -> curve ROM halfword 0x48587196[scale A * 2] -- TgVoiceEgSegParamGet's sel-1 (type 7) scale source
0x4C011910  TgPartEgRampScaleAReset ; (d0 part) scale A := 0x100 + the same mask-0x11/sel-1 live refresh as TgPartEgRampScaleASet
0x4C011916  TgPartEgRampScaleAReset_entry
0x4C0119EA  TgPartEgRampScaleBSet   ; (d0 part, d1 scale) scale B (+6) := scale + live refresh mask 0x10 / sel 0 -> TgVoiceReg0401Write
0x4C0119F0  TgPartEgRampScaleBSet_entry
0x4C011ABC  TgPartEgRampScaleBGet   ; (d0 part) -> raw scale B halfword +6 (retf leaf)
0x4C011ACE  TgPartEgRampScaleBCurve ; (d0 part) -> curve ROM halfword 0x48587398[scale B * 2] -- TgVoiceEgSegParamGet's sel-0 (type 7) scale source
0x4C011AE9  TgPartEgRampScaleBReset ; (d0 part) scale B := 0x100 + live refresh mask 0x10 / sel 0
0x4C011AEF  TgPartEgRampScaleBReset_entry
0x4C011BC0  TgPartEgRampScaleBSet2  ; (d0 part, d1 scale) scale B := scale + live refresh with reg-list mask 0x20 and the 0x4C03A38E scaled ratio -- the release-side variant of TgPartEgRampScaleBSet
0x4C011BC5  TgPartEgRampScaleBSet2_entry
0x4C011C23  TgPartEgRampScaleBGet2  ; duplicate raw scale-B getter (second link of the leaf)
0x4C011C35  TgPartEgRampScaleBReset2 ; (d0 part) scale B := 0x100 + the mask-0x20 variant refresh
0x4C011C3A  TgPartEgRampScaleBReset2_entry
0x4C011C9D  TgPartEgRampTickHeld    ; (d0 part) steady-ENGAGED tick: cntA(byte1) < 0x4F -> ++cntA, flags &= ~8, scale A := curve ROM 0x4858712C[cntA] (else flags |= 8 + TgPartEgRampScaleAReset); cntB(byte2) < 0x96 -> ++cntB, scale B := curve ROM 0x4858717C[cntB / 6] via LibDiv32 + TgPartEgRampScaleBSet2 (else ScaleBReset + ScaleBReset2)
0x4C011CA2  TgPartEgRampTickHeld_entry
0x4C011D32  TgPartEgRampTickIdle    ; (d0 part) steady-RELEASED tick: the counter walk-down twin (scale A via ScaleASet, scale B via ScaleBSet + ScaleBSet2 mask-0x20 path)
0x4C011D37  TgPartEgRampTickIdle_entry
0x4C011DB6  TgPartEgRampReleaseEdge ; (d0 part) engage -> release transition (flags bit2 just cleared): re-seed the counters and push both scales
0x4C011DBB  TgPartEgRampReleaseEdge_entry
0x4C011E44  TgPartEgRampEngageEdge  ; (d0 part) release -> engage transition (flags bit2 just set)
0x4C011E49  TgPartEgRampEngageEdge_entry
0x4C011EC9  TgPartEgRampDispatchTick ; FOR EACH part 0..0x21: flags bit0 gate, then the edge state machine on bits 1/2 -- engage edge (bit1 & !bit2: set bit2, EngageEdge), steady engaged (bit1 & bit2 & bit4clear...: TickHeld unless bit3+bit4 done), release edge (!bit1 & bit2: clear bit2, ReleaseEdge), steady released (!bit1 & !bit2 & !bit4: TickIdle) -- the module's periodic driver
0x4C011ECE  TgPartEgRampDispatchTick_entry
0x4C03A310  TgPartEgRampSegScaled   ; (d0 part, d1 sel) -> part EG cache halfword 0x500CE404+part*0x130+0x4C+sel*4 scaled by the ramp: tone type 7 only; sel 0 -> * scale B >> 8 floor 0x1C, sel 1 -> * scale A >> 8 floor 0x2C
0x4C03A315  TgPartEgRampSegScaled_entry
0x4C03A389  TgPartEgRampCache54Scaled ; (d0 part) -> part EG cache halfword +0x54 scaled the same way (type-7 gate) -- the ratio source of the mask-0x20 setter pair
0x4C03A38E  TgPartEgRampCache54Scaled_entry
