0x4C000D54  LibF64Frexp             ; frexp(x at (8,sp), a0 = &int exp-out): returns the mantissa in [0.5,1) (exponent field forced to 0x3FE), *a0 = unbiased exponent + 1; x==0 -> *a0=0
0x4C000D59  LibF64Frexp_entry
0x4C000D99  LibF64Exp               ; exp(x): x < ln(DBL_MIN) (0xC086232BDD7ABCD2 = -708.396) -> errno=2, 0.0; x > ln(DBL_MAX) (0x40862E42FEFA39EF = +709.782) -> errno=2, DBL_MAX; else argument reduction x = k*ln2 + r and rational approximation in r, LibF64Ldexp(result, k)
0x4C000D9E  LibF64Exp_entry
