;
; ---- SOFT-FLOAT IEEE-754 DOUBLE RUNTIME + libm subset (library image
;      0x4C000000..0x4C001A00 -- the firmware has no FPU; TgPartGlidePlan/
;      TgPartGlideTick's portamento math runs here, and the module is generic
;      compiler runtime shared by any double-typed code). ABI: doubles are
;      passed on the CALLER's outgoing-arg area -- arg1 lo32 at (8,sp) /
;      hi32 at (0xC,sp), arg2 at (0x10,sp)/(0x14,sp) -- and returned in
;      d0 (lo32) : d1 (hi32); the canonical movm prologue is bypassed by the
;      register-save `call X_entry,[regs],frame` form as usual. Unpack class
;      codes (d2/d3): 0 = normal, 1 = Inf, 2 = zero, 4 = NaN. Error cell
;      0x500AD390 (1 = domain, 2 = range) with DBL_MAX / -DBL_MAX / 0
;      returns = a classic errno-style libm. ---------------------------------
0x4C000000  LibF64Pow               ; pow(x,y): y==0 -> 1.0; x==0 -> y<=0 sets errno(0x500AD390)=1 dom, returns 0; else split y via LibF64Modf (integer part -> repeated squaring path, fraction -> LibF64Exp(frac*LibF64Log(x))); negative x only legal for integral y (sign fixed at the end)
0x4C000005  LibF64Pow_entry
0x4C000263  LibF64UnpackedToI32     ; tail core: unpacked double (d0/d1 mantissa, a1 sign copy, a3 exponent field, d3 class) -> signed i32 in d0, truncating; class 2/4 -> 0, class 1 or exp >= 0x41E00000 -> saturate 0x7FFFFFFF/0x80000000, exp < 0x3FF00000 (|x| < 1) -> 0
0x4C0002B3  LibF64ToI32             ; (double at (8,sp)/(0xC,sp)) -> d0 = (int32)x, truncation toward zero: LibF64Unpack then LibF64UnpackedToI32
