; ---- TG voice/register primitives (library image, self-loaded to 0x4C000000
;      from program-flash file offset 0x3B8FD1; notes/library-rom-loading.md).
;      RE: kn7000_mame/notes/tg-pitch-pipeline.md (voice records 0x500AF940
;      stride 0xB4 / 0x500CA0B0 stride 0x84, TG A=0x98050000 slots 0..0x3F,
;      TG B=0x98040000 slots 0x40..0x7F) -----------------------------------
0x4C036D3A  TgVoiceSlotService      ; (d0 slot, d1 mode) dispatch on the lib voice record's (0x500AF940+slot*0xB4) class bits (+2)&0x7C: 0x10/0x40/0x08 -> handlers 0x4C00C0B1/0x4C0115AA/TgVoiceKillHandler; 0x04/0x20 -> flag ops rec+0x52 (|=0x80) / rec+0x54 (!=0xFF -> clear bits13:12, set bit12) else 0x4C013F0F
0x4C036D3F  TgVoiceSlotService_entry
0x4C036F98  TgVoiceRegWrite         ; THE slot-routed TG register write (the pitch-pipeline notes' 0x4C036F98): word = (slot<<20)|d1|(0x18,sp); slot < 0x40 -> hi16 to 0x98050000 + lo16 to 0x98050002 (TG A), else slot&0x3F to TG B 0x98040000/2
0x4C036FE5  TgVoiceRegWriteB        ; same 20-bit slot layout, TG B only
0x4C037008  TgGlobalRegWriteBoth    ; global-register variant (d0 is 16-bit, shifted 18): broadcast to TG A then TG B
0x4C037037  TgGlobalRegWriteB       ; the 18-shift global write, TG B only
0x4C03705A  TgCmdReadA              ; issue raw 32-bit word d0 to TG A (hi16 -> 0x98050000, lo16 -> 0x98050002) then read the data port back (returns the answered halfword)
0x4C03705D  TgCmdReadA_entry
0x4C037082  TgCmdReadB              ; same readback primitive on TG B 0x98040000/2
0x4C037085  TgCmdReadB_entry
0x4C0370AA  TgVoiceStatusRead       ; (d0 slot) poll the voice status: gate byte 0x500CE380 == 0x7F (no TG) skips; else command 0xFC010000|(slot&0x3F)<<20 via TgCmdReadA/B -> status & 0x1FFF
0x4C0370F3  TgVoiceRecordReset      ; re-init voice record slot d0: copy the 0x84-byte ROM template 0x4858766C over 0x500CA0B0 + slot*0x84 (returns a0 = the record)
