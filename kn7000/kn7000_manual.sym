; KN7000 MANUAL symbol supplement — hand-reversed functions NOT named by the
; firmware's own MILK-toolkit reflection tables (those live in the generated
; kn7000.sym). These were recovered by dynamic + static reverse-engineering in
; the sibling kn7000_mame driver effort; each is a verified instruction-boundary
; function entry. Merged into the annotated disassembly by `make disasm`.
; Cross-references: see kn7000_mame/notes/*.md.
;
; ---- Control-panel serial protocol (SIO ch0 @ 0x34000800) ------------------
; The main CPU <-> panel sub-CPU handshake. Full protocol in
; kn7000_mame/notes/panel-serial-protocol.md. These sit in the large unnamed
; gap after FadeIOFilter.
0x484AC2A8  PanelTransaction        ; 10-retry command transaction driver
0x484AC523  PanelTxKick             ; queue [cmd,arg] into the TX ring, start TX
0x484AC5F1  PanelAtnIsr             ; ISR, INTC group 0x1A (panel ATN 2-edge pulse)
0x484AC70E  PanelTxDoneIsr          ; ISR, group 0x11 (sync-transfer-complete TX state machine)
0x484AC74A  PanelRxIsr              ; ISR, group 0x10 (reply byte -> RX ring)
0x484AC799  PanelTxState1           ; TX state 1 (line sync)
0x484AC84D  PanelTxState2           ; TX state 2 (payload byte 1)
0x484AC923  PanelTxState3           ; TX state 3 (line sync)
0x484AC98C  PanelTxState4           ; TX state 4 (payload byte 2)
0x484ACA5E  PanelTxState5           ; TX state 5 (line sync)
0x484ACAFF  PanelTxState6           ; TX state 6 (line sync)
0x484ACC13  PanelRxState8           ; RX state 8 (reads 0x34000809 -> reply ring)
;
; ---- Panel button dispatch -------------------------------------------------
0x484ADB59  PanelButtonDispatch     ; normal-mode button dispatcher (descriptor tables 0x48614978/0x486149FC)
;
; ---- MIDI (MN10300 on-chip serial SC1/SC2 @ 0x34000810/0x34000820) ---------
; See kn7000_mame/notes/midi-rx.md, boot-performance-and-clock.md.
0x484B1E86  Midi1RxIsr              ; MIDI port 1 RX ISR (ICR 0x34000148, group 0x12)
0x484B2037  Midi2RxIsr              ; MIDI port 2 RX ISR (ICR 0x34000150, group 0x14)
0x484B2691  MidiBaudTimerSetup      ; sets TM3MD/TM3BR (=0x3F) : baud = IOCLK/8/(TM3BR+1) = 31250
0x484B2793  MidiSerialInit          ; SC1/SC2 init: 8N1, CK=Timer3-underflow/8
;
; ---- Tone generators (main 0x98040000 / sub 0x98050000) --------------------
; Register-indirect 32-bit writes (HIGH16->base+0 addr, LOW16->base+2 data).
; See kn7000_mame/notes/tone-generator.md. (The helper has main & sub tails
; sharing one epilogue; ToneGenWriteMain is the main-TG store path.)
0x487EFF92  ToneGenWriteMain        ; write a main-TG register (addr in d1, data in d2)
;
; ---- Data tables (reference only; commented so the code disassembler skips
;      them — these are DATA, not code) --------------------------------------
; 0x48735EE4  RhythmGenreNameTable   ; 16 records x 0x18, "[H"+centred name (8&16 BEAT..MEMORY)
; 0x4860C9F4  PanelSwitchClassTable  ; service panel-test mode: switch# -> [LED reg, value]
; 0x486135A0  PanelWireNormTable     ; wire (bank<<1|sub) -> normalized segment
; 0x48614978  ButtonDescPtrTableA    ; per-normSeg descriptor pointer table (bank A = KN7000)
; 0x486149FC  ButtonDescPtrTableB    ; per-normSeg descriptor pointer table (bank B)
; 0x4872573C  ClutPaletteSeedTable   ; 256x 0x00BBGGRR CLUT seed (idx 0x1D-0xF3 = green placeholder)
; 0x485FDD5C  PartNameStringPool     ; ASCII pool: "PART 1".."PART 16","RIGHT 1/2","LEFT","ACCOMP 1-5","BASS","DRUM 1/2","CHORD","R.BASS","PADS","BASS PEDAL","CHORDFINDER","MICROPHONE","APC","CONTROL"
; 0x485FDE70  PartNamePtrTable       ; u32 ptrs into PartNameStringPool; entry [0]=PART 1 (16 MIDI parts, then keyboard sections)
; 0x485FDEB0  KeyboardPartNames      ; = PartNamePtrTable+16: keyboard/mixer parts (RIGHT 1/2,LEFT,ACCOMP 1-5,BASS,DRUM 1/2,CHORD,R.BASS,PADS,PADS,BASS PEDAL,CHORDFINDER,MICROPHONE,APC,CONTROL) — matches the home-screen mixer
; 0x485FDED0  AccompPartNames        ; = PartNamePtrTable+24: auto-accompaniment subset (BASS,DRUM 1/2,CHORD,R.BASS,PADS,...)
; 0x485FDD0C  CprSoundModeNames      ; CPR-board sound-mode labels: DIGITAL DRAWBAR, ACCORDION REGISTER, SOUND EXPLORER, EW EXPANSION, ORGAN TABS

; ---- Built-in rhythm-style name table (the "8 Beat 1" list-bug area) ---------
; The genre style list resolves built-in style names via StyleNameSourceSet
; 0x48433400 -> builtin resolver 0x48433AC4 (indexes name-table *(0x50034B7C)).
; See kn7000_mame/notes/rhythm-name-list-bug.md.
0x48433300  StyleBuiltinNameTableInit  ; loads the "Technics Rhythms" resource (name @0x4872980C via lib 0x4C00203C) and populates the style-name-table globals 0x50034B74/78/7C/80/88; RUNTIME-CONFIRMED to SUCCEED (0x50034B7C = table-ROM name-table 0x483E82BF, non-zero) -- so the "8 Beat 1" bug is downstream in per-style resolution, NOT this init
0x48433AC4  StyleBuiltinNameResolve    ; style-index -> name ptr in a0 (10 call sites): indexes name-table *(0x50034B7C) (table ROM 0x483E82BF, u16), count-gate *(0x50034B74), 0x8000-flag indirection, then 3-byte-offset sub-table *(0x50034B80) into the "Technics Rhythms" resource *(0x50034B78)+off; fallback *(0x50034B88)=" 8 Beat 1". Feeds the current-rhythm display (works), NOT directly the buggy style list
0x48729988  TechnicsRhythmsResource    ; built-in rhythm style-name resource (name @0x4872980C); embeds its own name string + the style names at byte-offsets (e.g. +0x11BA=" 8 Beat 1"); base cached in RAM 0x50034B78
0x4873BEE8  StyleRecordTable           ; >=400 24-byte built-in style records used by the style list-box (indexed by CUR_STYLE_IDX 0x50001270). Layout: +0x00 patternDataPtr (->0x487674xx, 160B pattern), +0x04 namePtr -> REAL style name (program ROM 0x485D0000+, e.g. "Disco Hustling"/"Orchestral Jazz"), +0x08 u16, +0x0C u32 index, +0x10/12/14 u16 params. Proves all built-in style names exist as data
0x50001270  CUR_STYLE_IDX              ; RAM: current style index into StyleRecordTable 0x4873BEE8 (used by the list-box msg handlers)

; ---- Self-loaded library / kernel ROM image (stored in program ROM) ----------
; The boot self-loader (0x484D7BBD) copies this region to 0x8C000000; the firmware
; then EXECUTES it via the 0x4C000000 alias. So these are code-at-runtime / data-at-rest
; here. Mapping: library address X  ==  program ROM 0x487B8FD1 + (X - 0x4C000000).
0x487B8FD1  LibRomImageBase        ; = lib 0x4C000000: base of the self-loaded library/kernel ROM image
0x487BC022  LibStrCopy             ; = lib 0x4C003051: byte copy until NUL (strcpy), hardware-loop (setlb)
0x487F6D71  LibIrqQuickDispatch    ; = lib 0x4C03DDA0: AM33 maskable-IRQ quick handler -- F6/udf context save, increments IRQ counter 0x50380D0C, reads IAGR 0x34000100 (used by high-priority device levels)
0x487F6DF7  LibIrqScheduler        ; = lib 0x4C03DE26: RTOS scheduler entry (level-6 system tick) -- saves the interrupted task's SP into its TCB *0x5038002C, switches to the scheduler stack *0x50380CBC, dispatches, reloads SP from the chosen TCB
