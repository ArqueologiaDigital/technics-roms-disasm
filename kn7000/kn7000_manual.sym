; Panel-protocol data tables (reference only; DATA, not code):
; 0x48612F74  PanelTypeIdTable        ; 4 x {ptr, expected byte} checked by PanelTypeDetect mode A
; 0x48613014  PanelTypeIdTable2       ; 4 x {ptr, expected byte} (checker 0x484AC280)
; 0x48613034  PanelXferStateTable     ; 11 x code ptr: link state 0..10 -> handler (0=7=10 idle, 1-6 TX, 8-9 RX)
; 0x48613060  PanelEventFifoDescInit  ; 5-word cooked-FIFO descriptor image {base,end,rd,wr,free}
; 0x48613074  PanelTxFifoDescInit     ; 5-word TX byte-FIFO descriptor image
; 0x48613088  PanelCtrlValuePtrTable  ; 32 x ptr to latched-control value bytes (PanelCtrlValueGet)
; 0x48613108  PanelCtrlDispatchTable  ; 32 x code ptr, only (0,0)(0,7)(3,0)(3,1)(3,2)(3,3) live
; 0x48613588  PanelGpioSwShadowInit   ; 6 x 4-byte GPIO-switch shadow-record init image
; 0x48613620  PanelWireNormTableB     ; wire ADDR -> normSeg, mode-B twin of PanelWireNormTable 0x486135A0
; 0x48614BC4  PanelBtnMaskJumpTable   ; 13 x code ptr for PanelBtnEnableMaskGet
; 0x5006BCF8  PANEL_EVENT_FIFO        ; cooked switch-event FIFO descriptor
; 0x5006BD8C  PANEL_TX_FIFO           ; LED/command TX byte-FIFO descriptor
; 0x5006BEB4  PANEL_SW_EVENT_RECORDS  ; 7 x 3-byte [normSeg,DATA,CHANGED] (count 0x5006BEF0)
