0x4C00D047  TgPartEditLfoFlagSet    ; (d0 part, d1 bool) set/clear bit7 of the SOUND EDIT record byte +0x44 (the LFO block header) for parts 0x10..0x12 -- one of the LFO EDIT page's on/off toggles (KEYSYNC or CONNECTION; not settled which). Lazily activates the local-edit shadow first (TgPartLocalEditActivate_entry)

; ---- ★ THE VOICE-LIST INDEX LAYER: four more archive directories, and the
;      SOUND-EXPLORER / TONE-SELECT grids that ride on them
;      (region 1, 2026-07-20). Extends notes/sound-bank-classes.md.
;
;      The five bank sources documented above (INTERNAL 0x48000000 plus the
;      four 0x57000000 / 0x56000000 / 0x41000000 / 0x41800000 windows) do NOT
;      carry just one directory each. Each archive's sound directory -- the
;      block at base + *(base+0x18) -- carries SIX parallel hash directories,
;      each a (bucket-table offset, descriptor offset) pair:
;
;        buckets  descr   key     payload         used by
;        +0x08    +0x20   u32     u16 @entry+8    family B  VoiceParamBank*
;        +0x0C    +0x24   u32     u16 @entry+8    family A  VoiceBank*
;        +0x28    +0x2C   u16     rec @entry+6    VoiceListIndexOfBank
;        +0x30    +0x34   u16     rec @entry+6    VoiceListEntryByIndex
;        +0x38    +0x3C   u16     rec @entry+6    VoiceListIndexMapAtoB
;        +0x40    +0x44   u32     u8  @entry+8    VoiceAttrClassify
;
;      A descriptor is halfwords {mult, nbuckets, countA, countB}; the walk is
;      always the same multiplicative-hash bucket chain (bucket =
;      (key*mult) % nbuckets, chain link at entry+0, key at entry+4).
;      countA / countB live in the +0x3C descriptor and are read back by
;      VoiceArchiveCountA / VoiceArchiveCountB.
;
;      TWO GLOBAL INDEX SPACES. The tone-selection GUI does not address a
;      sound by (bank, program) -- it addresses it by a position in ONE merged
;      list spanning every fitted archive. Two such numbering spaces exist:
;        space A -- byte-wide per archive, running total VoiceArchiveCountA
;        space B -- halfword-wide,        running total VoiceArchiveCountB
;      Each source's local index is made global by adding the running sum of
;      (count+1) over all preceding sources, which is exactly what the three
;      classifiers below do as they walk sources 0,1,2,3,4.
;
;      The three functions compose, and the SOUND/TONE selection grids call
;      them back-to-back in this order (see ToneSelGridSe 0x484DF84E ->
;      0x484DF863 -> 0x484DF883, and the same triple in TsetGridSe,
;      DrumTsetGridSe, DrumMainGridSe, DrumLfoGridSe):
;
;        (bank LSB, program)  --VoiceListIndexOfBank-->  index A (and index B)
;        index A + 1          --VoiceListIndexMapAtoB->  index B
;        index B & 0x7FFF     --VoiceListEntryByIndex->  (kind, byte0, byte1)
;
;      WHAT THIS IS NOT: these are the VOICE archives' own index directories.
;      Every caller found in the image is a tone/drum SELECTION GRID; nothing
;      here reaches the rhythm/style resource windows, so this pass does NOT
;      connect the bank machinery to the missing STYLE data
;      (notes/sequenced-playback-and-style-data-rootcause.md).
;
;      DELIBERATELY NOT CLAIMED: which UI axis space A and space B each are
;      (group/page ordinal vs. sound ordinal is the natural reading but is not
;      proven from the code), and the meaning of the byte VoiceAttrClassify
;      returns (0xFF when the sound has none).
0x48571056  VoiceAttrClassify       ; (d0 program, d1 bank LSB, a0 out u8 attr, a1 out u8 class, arg5 bank MSB) -> always 1; same five-source walk and same 24-bit MIDI key as VoiceBankClassify, but over the +0x40/+0x44 directory, and the payload is a BYTE. Total miss -> attr 0xFF, class 0
0x4857105B  VoiceAttrClassify_entry
0x48571178  VoiceAttrLookupInternal ; +0x40/+0x44 hash lookup in the class-0 archive (0x48000000)
0x4857117D  VoiceAttrLookupInternal_entry
0x485711EB  VoiceAttrLookupSrc1     ; class-1 archive (0x57000000)
0x485711F0  VoiceAttrLookupSrc1_entry
0x4857125E  VoiceAttrLookupSrc2     ; class-2 archive (0x56000000)
0x48571263  VoiceAttrLookupSrc2_entry
0x485712D1  VoiceAttrLookupSrc3     ; class-3 archive (0x41000000)
0x485712D6  VoiceAttrLookupSrc3_entry
0x48571344  VoiceAttrLookupSrc4     ; class-4 archive (0x41800000)
0x48571349  VoiceAttrLookupSrc4_entry
0x485713B7  VoiceAttrKeyEqual       ; (d0,d1) -> 1 on u32 key match -- retf leaf
0x485713C2  VoiceAttrHashIndex      ; (d0 key, d1 mult, arg nbuckets@0x14,sp) -> (key*mult) % nbuckets, mulu/divu remainder
0x485713C4  VoiceAttrHashIndex_entry
0x48449B14  VoiceAttrByteGet        ; (d0 program, d1 bank LSB, a0 out u8 class, arg5 bank MSB) -> the attribute byte, staged through the scratch byte 0x5003A5B8. No caller in this image
0x48449B19  VoiceAttrByteGet_entry
0x4857176B  VoiceListIndexOfBank    ; (d0 bank LSB, d1 program, a0 out u8 index A, a1 out u32 record ptr, arg5 archive kind, arg6 out u16 index B) -> 1 when found. Walks sources 1..4 then 0, skipping any source whose VoiceArchiveKindByte differs from the requested kind, accumulating (VoiceArchiveCountA+1)/(VoiceArchiveCountB+1) as it goes; key = (LSB<<8)|program over the +0x28/+0x2C directory. Misses degrade program -> program&~7 -> program 0 -> the 0x7F7F default, like family B
0x48571770  VoiceListIndexOfBank_entry
0x485719D5  VoiceListIndexLookupInternal ; +0x28/+0x2C hash lookup in the class-0 archive (0x48000000)
0x485719DA  VoiceListIndexLookupInternal_entry
0x48571A4B  VoiceListIndexLookupSrc1 ; class-1 archive (0x57000000)
0x48571A50  VoiceListIndexLookupSrc1_entry
0x48571AC1  VoiceListIndexLookupSrc2 ; class-2 archive (0x56000000)
0x48571AC6  VoiceListIndexLookupSrc2_entry
0x48571B37  VoiceListIndexLookupSrc3 ; class-3 archive (0x41000000)
0x48571B3C  VoiceListIndexLookupSrc3_entry
0x48571BAD  VoiceListIndexLookupSrc4 ; class-4 archive (0x41800000)
0x48571BB2  VoiceListIndexLookupSrc4_entry
0x48571C23  VoiceListIndexKeyEqual  ; (d0,d1) -> 1 on u16 key match -- retf leaf
0x48571C30  VoiceListIndexHashIndex ; (d0 key, d1 mult, arg nbuckets@0x10,sp) -> (key*mult) % nbuckets -- rets leaf (no register frame)
0x48571C41  VoiceArchiveKindByte    ; (d0 source 1..4) -> the archive's KIND byte, the first byte of the header block at base + *(base): *(u8 *)(window + *(window)). 0 for any other source. The index classifiers use it to skip archives that do not hold the requested resource kind
0x48571CA0  VoiceListEntryByIndex   ; (d0 global index B, d1 out u8 kind, a0 out u8 byte0, a1 out u8 byte1) -> 1 when the index resolves. The INVERSE of VoiceListIndexOfBank: subtracts (VoiceArchiveCountB+1) per source until the index falls inside one, looks the local index up as the key in that archive's +0x30/+0x34 directory, and returns the entry's first two bytes plus the source's VoiceArchiveKindByteAlt
0x48571CA5  VoiceListEntryByIndex_entry
0x48571E07  VoiceListEntryLookupInternal ; +0x30/+0x34 hash lookup in the class-0 archive (0x48000000)
0x48571E0C  VoiceListEntryLookupInternal_entry
0x48571E7D  VoiceListEntryLookupSrc1 ; class-1 archive (0x57000000)
0x48571E82  VoiceListEntryLookupSrc1_entry
0x48571EF3  VoiceListEntryLookupSrc2 ; class-2 archive (0x56000000)
0x48571EF8  VoiceListEntryLookupSrc2_entry
0x48571F69  VoiceListEntryLookupSrc3 ; class-3 archive (0x41000000)
0x48571F6E  VoiceListEntryLookupSrc3_entry
0x48571FDF  VoiceListEntryLookupSrc4 ; class-4 archive (0x41800000)
0x48571FE4  VoiceListEntryLookupSrc4_entry
0x48572055  VoiceListEntryKeyEqual  ; (d0,d1) -> 1 on u16 key match -- retf leaf
0x48572062  VoiceListEntryHashIndex ; (d0 key, d1 mult, arg nbuckets@0x10,sp) -> (key*mult) % nbuckets -- rets leaf
0x48572073  VoiceArchiveKindByteAlt ; a second, byte-identical copy of VoiceArchiveKindByte used by the index-B side
0x485720D2  VoiceListIndexMapAtoB   ; (d0 global index A, a0 out u16 index B) -> 1 when it resolves. Subtracts (VoiceArchiveCountA+1) per source to find the owning archive, looks the local index up as the key in its +0x38/+0x3C directory and adds the running (VoiceArchiveCountB+1) sum to the halfword it finds -- i.e. the space A -> space B conversion the selection grids apply between VoiceListIndexOfBank and VoiceListEntryByIndex
0x485720D7  VoiceListIndexMapAtoB_entry
0x48572225  VoiceArchiveCountA      ; (d0 source 0..4) -> u16 at (sound directory +0x3C)+4, the archive's entry count in global index space A; -1 for any other source
0x48572227  VoiceArchiveCountA_entry
0x485722E0  VoiceArchiveCountB      ; (d0 source 0..4) -> u16 at (sound directory +0x3C)+6, the archive's entry count in global index space B; -1 for any other source
0x485722E2  VoiceArchiveCountB_entry
0x4857239B  VoiceListMapLookupInternal ; +0x38/+0x3C hash lookup in the class-0 archive (0x48000000)
0x485723A0  VoiceListMapLookupInternal_entry
0x48572411  VoiceListMapLookupSrc1  ; class-1 archive (0x57000000)
0x48572416  VoiceListMapLookupSrc1_entry
0x48572487  VoiceListMapLookupSrc2  ; class-2 archive (0x56000000)
0x4857248C  VoiceListMapLookupSrc2_entry
0x485724FD  VoiceListMapLookupSrc3  ; class-3 archive (0x41000000)
0x48572502  VoiceListMapLookupSrc3_entry
0x48572573  VoiceListMapLookupSrc4  ; class-4 archive (0x41800000)
0x48572578  VoiceListMapLookupSrc4_entry
0x485725E9  VoiceListMapKeyEqual    ; (d0,d1) -> 1 on u16 key match -- retf leaf
0x485725F6  VoiceListMapHashIndex   ; (d0 key, d1 mult, arg nbuckets@0x10,sp) -> (key*mult) % nbuckets -- rets leaf

; ---- the BOOT ARCHIVE PARSER (voice-resource windows 1..4) --------------------
0x48449EF4  VoiceArchiveScanBoot       ; validates the four expansion voice-archive windows 0x57000000 / 0x56000000 / 0x41000000 / 0x41800000 at boot, one near-identical block each: header self-check (*(base)+base == base+0x200), then TWO 16-byte signature compares against "Expansion Board " (0x485B8518) at *(base+4) and *(base+8). On success the presence byte 0x501496B4+n is set to 1, the archive ID *(base + *(base)) is cached at 0x501496A4+n*4, and the five parallel descriptor arrays 0x5003A554/68/7C/90/A4 (index 0 = INTERNAL, from table ROM *(0x48000018)) get slot n+1 from the directory base + *(base+0x0C); on failure everything aliases the internal bank. See kn7000_mame/notes/sound-bank-classes.md
0x48449EF6  VoiceArchiveScanBoot_entry
0x485B8518  ExpansionBoardSigStrings   ; "Expansion Board KN7000 SOUND RAM" then "KN6000 SOUND RAM" / "KN5000 SOUND R..." -- only the first 16 bytes ("Expansion Board ") are compared by VoiceArchiveScanBoot

; ---- the GLOBAL EFFECT-CHANNEL REFRESHERS (lib 0x4C004DE4..0x4C00566E) -------
; The CALLER layer above the output-channel register file documented at
; 0x4C037D0F..: each of these programs one of the thirteen TG global output
; channels (EG segments 0..3 + the output-level pair) from the current part
; settings 0x500B5340+part*0x54C and the global effect-enable halfword
; 0x500C0758. Seven of them own ONE fixed channel and are (re)run by the
; effect ENABLE setters at lib 0x4C00908F+ when a panel effect is toggled
; (kn7000_mame/notes/per-part-effect-application.md, reverb-toggle-findings.md
; -- 0x4C0053B3 / 0x4C005433 are named there as the "lib consumers" of the
; reverb flag). The scan pattern is uniform: walk parts 0..0x21 for the first
; whose partrec+0x62 bits 10..8 select this channel, then either program the
; channel from that part or mute it (output-level pair := 0).
; DELIBERATELY NOT CLAIMED: which panel effect each fixed channel IS. The
; enable bits are known only positionally (bit9 = reverb, per the MAME notes);
; bits 0x0200/0x0800/0x1000/0x2000/0x4000 are used here but not identified.
0x4C004DE4  TgPartGlobalChanRefresh ; (d0 part) programs the GLOBAL CHANNEL the part is routed to: channel = partrec+0x62 bits 10..8 through ROM 0x486D109A (8 = none -> return), a second ROM map 0x486D1094 on bits 15..13 and the gate table 0x500C076C decide whether the channel is muted (TgChanOutLevelPairSet 0,0) or fully programmed; the same inputs TgVoiceFadeParamsPlan uses for the per-voice auto-fade
0x4C004DE9  TgPartGlobalChanRefresh_entry
0x4C0050DE  TgGlobalChan6Refresh    ; global channel 6: first part with (partrec+0x62 & 0x0700) == 0x100, gated on the byte 0x500C0772 and on 0x500082BD; EG seg0 level from 0x500082BF, output pair 0x7F/(0x7F or 0x50 by +0x62 bits 7..6); no candidate -> pair := 0
0x4C0050E3  TgGlobalChan6Refresh_entry
0x4C005241  TgGlobalChan7Refresh    ; global channel 7: gated on 0x500C0758 bit 0x0800, first part with (partrec+0x62 & 0x0700) == 0x200; the rhythm/accomp parts 0x13..0x1A take a second path with its own flag test; EG seg0 level from 0x500082C0
0x4C005246  TgGlobalChan7Refresh_entry
0x4C005396  TgGlobalChanBRefresh    ; global channel 0x0B, gated on the byte 0x500C0777 and the flags 0x500C0758
0x4C005399  TgGlobalChanBRefresh_entry
0x4C00542E  TgGlobalChan3Refresh    ; global channel 3, gated on 0x500C0758 bit 0x0200 and the byte 0x500C076F
0x4C005431  TgGlobalChan3Refresh_entry
0x4C0054A5  TgGlobalChan5Refresh    ; global channel 5, gated on the byte 0x500C0771 and 0x500C0758 bit 0x4000
0x4C0054A8  TgGlobalChan5Refresh_entry
0x4C005535  TgGlobalChan1Refresh    ; global channel 1, gated on 0x500C0758 bit 0x2000 and the byte 0x500C076D
0x4C005538  TgGlobalChan1Refresh_entry
0x4C005593  TgGlobalChanCRefresh    ; global channel 0x0C, gated on 0x500082C4 == 1 (a DIGITAL DRAWBAR global, cf. the drawbar record 0x500082C8+part*0x1C) and 0x500C0758 bit 0x1000; the byte 0x500082BC picks between two full EG programmings (rate 0x2D vs 0)
0x4C005596  TgGlobalChanCRefresh_entry
; ---- the TG GLOBAL-PARAMETER MODULE 0x4C008CBB..0x4C009837 -----------------
;      master volume / master tune / group gains, the effect ENABLE bits in
;      0x500C0758 + 0x500C075A, and the command dispatcher that drives them.
;      Bit map: kn7000_mame/notes/effect-enable-bits.md
0x4C008CBB  TgGlobalAllPartsRefresh ; refresh all 0x22 parts through 0x4C007B63 (dispatcher command id 0x09)
0x4C008CC0  TgGlobalAllPartsRefresh_entry
0x4C008CD0  TgMasterVolumeRecompute ; sums the three master-volume bytes 0x500082B4 (main) + 0x500082B6 (sub) + 0x500082B8 (aux), each biased -0x7F, clamps to [-0x7F,0] and publishes 0x500C077E (all three) and 0x500C0780 (sub included only when 0x500C075A bit5 is set), each scaled *0xC992/0x7F through LibDiv32 and pushed to hw via 0x4C038028 / 0x4C038046
0x4C008CD5  TgMasterVolumeRecompute_entry
0x4C008D8E  TgMasterVolumeMainSet   ; byte 0x500082B4 := d0 (change-gated), then TgMasterVolumeRecompute -- dispatcher id 0x14
0x4C008D93  TgMasterVolumeMainSet_entry
0x4C008DAE  TgMasterTuneFineSet     ; halfword 0x500C075C := d0*2, the MASTER FINE TUNE TgPitchNoteResolve folds into pitch16 -- dispatcher id 0x19
0x4C008DBE  TgMasterTuneTransposeSet ; halfword 0x500C075E := (d0-0x40)<<8, the MASTER TRANSPOSE TgPartPitchWordCalc folds in (1/256-semitone units) -- dispatcher id 0x1A
0x4C008DCD  TgMasterVolumeSubSet    ; byte 0x500082B6 := d0 (change-gated) + recompute -- dispatcher id 0x20
0x4C008DD2  TgMasterVolumeSubSet_entry
0x4C008DED  TgMasterVolumeAuxSet    ; byte 0x500082B8 := d0 (change-gated) + recompute -- dispatcher id 0x21
0x4C008DF2  TgMasterVolumeAuxSet_entry
0x4C008E0D  TgGroupGainPartsLoSet   ; halfword 0x500C0764 := (d0 ? d0-0x7F : -0x200 hard mute), the group master gain TgLevelTermFinalize applies to parts <= 0x0F -- dispatcher id 0x22
0x4C008E21  TgGroupGainClass23Set   ; halfword 0x500C0760, group master gain for part class 2/3, gated in TgLevelTermFinalize on 0x500C075A bit3 -- dispatcher id 0x23
0x4C008E35  TgGroupGainParts13To1ASet ; halfword 0x500C0762, group master gain for parts 0x13..0x1A, gated on 0x500C075A bit4 -- dispatcher id 0x24
0x4C008E49  TgGlobalRampStateSet    ; start/stop of the 0x500082A4 ramp state machine (counter 0x500082A6/A8, per-tick advance at 0x4C009837 over the program-ROM curve 0x486D27EB); lives in the 0x500082xx DIGITAL DRAWBAR global block -- dispatcher id 0x25
0x4C008EA4  TgGlobalRampParamSet    ; ramp parameters from one packed byte: bit3 -> 0x500082AA (1 or 3), high nibble -> curve table 0x48586648 -> 0x500082AC, 0x500082AE = 0x80/0xA0, low 2 bits -> 0x500082B0 = 0xC8 - (v<<3) -- dispatcher id 0x26
0x4C008EA6  TgGlobalRampParamSet_entry
0x4C008F0C  TgAllPartsRefreshAndFlush ; refresh all 0x22 parts, then drain the pending byte list built by 0x4C010127 into 0x4C037244 (bytes < 0x80) -- dispatcher id 0x27
0x4C008F12  TgAllPartsRefreshAndFlush_entry
0x4C008F45  TgPartEffectRefresh     ; one part: 0x4C007B63 + 0x4C007C45 + the send/level writers 0x4C038942 and 0x4C03A660 fed from 0x4C0384C4/D9/EE
0x4C008F4A  TgPartEffectRefresh_entry
0x4C008F8C  TgAllPartsEffectRefresh ; TgPartEffectRefresh over parts 0..0x21 -- dispatcher id 0x28
0x4C008F91  TgAllPartsEffectRefresh_entry
0x4C008FA1  TgEffectRouteSelect     ; 0x500C0758 bits 1..3 as a 3-value field (clear mask 0x000E, then value 1/2/3 -> bit1/bit2/bit3); bit3 additionally forces REVERB on in TgEffectEnableReverb; consumers in the element layer 0x4C0350E4.. -- dispatcher id 0x29
0x4C008FF6  TgReverbPartsApply      ; the per-part REVERB send pass over parts 0..0x21 (only parts whose 0x4C0384C4 class is 0x10/0x11), through 0x4C038942 + 0x4C03A660 -> descriptor array 0x500CE404; the loop kn7000_mame/notes/per-part-effect-application.md calls "0x4C009000" -- dispatcher id 0x2B
0x4C008FFB  TgReverbPartsApply_entry
0x4C009050  TgGlobalByte0768Set     ; byte 0x500C0768 := d0
0x4C009059  TgDrawbarGlobal82B2Set  ; byte 0x500082B2 := d0; its dispatcher handler (id 0x30) then re-runs TgGlobalChan3Refresh
0x4C009062  TgDrawbarGlobal82BDSet  ; byte 0x500082BD := d0; handler id 0x31 re-runs TgGlobalChan6Refresh + TgGlobalChanCRefresh
0x4C00906B  TgDrawbarGlobal82BESet  ; byte 0x500082BE := d0; handler id 0x32 re-runs TgGlobalChanBRefresh
0x4C009074  TgDrawbarGlobal82BFSet  ; byte 0x500082BF := d0; handler id 0x33 re-runs TgGlobalChan6Refresh
0x4C00907D  TgDrawbarGlobal82C0Set  ; byte 0x500082C0 := d0; handler id 0x34 re-runs TgGlobalChan7Refresh
0x4C009086  TgDrawbarGlobal82BCSet  ; byte 0x500082BC := d0 (the byte TgGlobalChanCRefresh uses to pick between two EG programmings); handler id 0x35 re-runs TgGlobalChanCRefresh + TgGlobalChan6Refresh
0x4C00908F  TgEffectEnableReverb    ; 0x500C0758 bit9 = the global REVERB enable (reverb-toggle-findings.md: the panel REVERB button lands on these two stores); OFF only takes effect when route bit3 is clear, else reverb stays forced on. Dispatcher id 0x40, whose handler re-runs TgGlobalChan3Refresh (reverb RETURN ch03) + TgGlobalChanBRefresh (reverb SEND ch0B) and then a per-part pass through 0x4C01010A / 0x4C0046B5
0x4C0090C0  TgEffectEnableBit10     ; 0x500C0758 bit10; dispatcher id 0x41, no channel refresh -- which GUI effect it is is NOT identified
0x4C0090EC  TgEffectEnableBit4      ; 0x500C0758 bit4; dispatcher id 0x42, no channel refresh; consumed in the low-level TG layer at 0x4C036EC3
0x4C009115  TgGroupGainClass23Enable ; 0x500C075A bit3, the gate TgLevelTermFinalize applies to the class-2/3 group gain 0x500C0760 -- INVERTED (a non-zero argument CLEARS the bit). Dispatcher id 0x43
0x4C009140  TgGroupGainParts13To1AEnable ; 0x500C075A bit4, gate for the parts-0x13..0x1A group gain 0x500C0762 -- also inverted. Dispatcher id 0x44
0x4C00916B  TgEffectEnableMulti     ; 0x500C0758 bit12 = the global MULTI enable: its handler (id 0x45) re-runs TgGlobalChanCRefresh + TgGlobalChan6Refresh and both gate on this bit; channel 6 is the MULTI return captured live in kn7000_mame/notes/effect-return-routing.md
0x4C009197  TgEffectEnableBit13     ; 0x500C0758 bit13; dispatcher id 0x46, handler re-runs TgGlobalChan1Refresh (which gates on the same bit)
0x4C0091C3  TgEffectEnableBit14     ; 0x500C0758 bit14; dispatcher id 0x47, handler re-runs TgGlobalChan5Refresh (which gates on the same bit)
0x4C0091EF  TgMasterVolumeSubEnable ; 0x500C075A bit5 = include the SUB master-volume term 0x500082B6 in the 0x500C0780 bus; dispatcher id 0x48, handler also re-runs TgMasterVolumeRecompute
