; rec50 — EFFECT: GUI TRIO CHORUS, Deep/Normal/Shallow 1-8 (type 0x53, insert)
; rec49's triangle-trio engine, insert build: NO input conditioning (input
; floated straight to the line), triangle scale c005 = 0x00F00000 -> +-240 smp
; sweep (+-14.5 cents constant-slope detune at template; deepest L read 491,
; one word shy of the R write head at 494), sine amplitude 0x00040000 =
; +-4 smp (7.6-cent shimmer), tap mix = sine + (tri_a+tri_b)/2, x2 makeup at
; the OUTPUT (R8+R8). Same oscillators, same 0.386 Hz / 7.717 Hz templates,
; same degenerate template stereo (host phases decorrelate). The GUI name is
; the topology: a TRIO of taps per channel.
; Full doc: dsp/modulation-pitch-family.md #7.
dm:0x9800  tri1_incr            ; +0x12599 signed triangle increment (0.386 Hz)
dm:0x9801  tri2_incr            ; +0x12599 (right)
dm:0x9802  tri3_incr            ; -0x12599 (contrary)
dm:0x9803  sineosc_eps          ; 0x2407C1 -> 7.717 Hz magic-circle rate
dm:0x9804  sineosc_neg1         ; 0x80000000 = -1.0 negator
dm:0xc004  tri1_phase           ; triangle accumulator 1
dm:0xc005  tri_scale            ; 0x00F00000: accumulator -> +-240 smp 16.16 offset
dm:0xc006  tri2_phase           ; triangle accumulator 2
dm:0xc007  tri3_phase           ; triangle accumulator 3
dm:0xc008  sineosc_sin          ; magic-circle state (sin)
dm:0xc009  sineosc_cos          ; magic-circle state (cos; templ 0x00040000 = +-4 smp)
dm:0xc00a  fexp_L               ; 0xFFFFFFE1 = -31 fraction float scale (x3)
dm:0xc00d  wet_L                ; 0x7FFFFFFF
dm:0xc00e  fexp_R               ; -31 (x3, right)
dm:0xc011  wet_R                ; 0x7FFFFFFF
pm:0x8400  trio_entry           ; I0=I1 (no input doubling — makeup is at output)
pm:0x8401  trio_osc1            ; triangle 1 (IF AV reflect) -> R13
pm:0x8405  trio_osc2            ; triangle 2 -> R11
pm:0x8409  trio_osc3            ; triangle 3 -> R14; R15 = -R13
pm:0x840d  trio_sineosc         ; magic-circle sin/cos -> R6
pm:0x8410  trio_read_inL        ; R0 = DM(0x20,I4); FLOAT
pm:0x8413  trio_write_L         ; write at P (float bits), stride 250
pm:0x8417  trio_tapL1           ; tap 250 + tri1 (+-240)
pm:0x841f  trio_tapL2           ; tap 250 + tri3; F9 = (t1+t2)/2
pm:0x8428  trio_tapL3           ; tap 250 + sine (+-4); F8 = t3 + (t1+t2)/2
pm:0x8431  trio_advance_R       ; MODIFY(I2,0xF4) -> R write base P+494
pm:0x8433  trio_out_L           ; FIX, x wet, x2 (R8+R8), CLIP, out L
pm:0x8439  trio_read_inR        ; R1 = DM(0x21,I4); FLOAT; write at P+494
pm:0x843c  trio_tapR1           ; tap: tri2
pm:0x8444  trio_tapR2           ; tap: -tri1
pm:0x844d  trio_tapR3           ; tap: sine
pm:0x8455  trio_out_R           ; FIX, x wet, x2, CLIP, out R
pm:0x845b  trio_rts             ; RTS (delayed)
pm:0x845d  trio_state_rewind    ; MODIFY(I8,0x4B) — 5 state reads
