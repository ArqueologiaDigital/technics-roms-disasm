; rec71 [EFFECT] — feedback delay + allpass-interpolated LFO-modulated tap, stereo (F70-73 family)
; uses block-float FLOAT R3 BY R4 + allpass frac interp (F8=F8-F12; F8=F8+F12)
pm:0x8400  Entry_I0eqI1          ; I0=I1
pm:0x8401  LoadFbState           ; R10 = DM(-1,I1)
pm:0x8402  ReadInputL            ; R3=DM(0x20,I4); F3=FLOAT
pm:0x8404  FeedbackMix           ; F7=F10*F7; F0=F3+F7
pm:0x8406  Delay1_Write          ; M7=0x1F40(8000); DM(I6,M7)=R0
pm:0x8408  Delay1_Read           ; R0=DM(I6,M6)
pm:0x8409  Delay1_Advance        ; M7=0x3C64; MODIFY(I6,M7)
pm:0x840f  LFO_PhaseAccum        ; F12=F0*F7; R8=DM(I0,M6)+PM(I8,M8)
pm:0x8411  Phase_To_Index        ; FDEP SE; ASHIFT -11
pm:0x8413  TapSetup              ; MODIFY(I5,0x2C) tap base; int/frac split
pm:0x841a  AllpassInterp1        ; F3=FLOAT R4; F12=F3*F8; F8=F8-F12; F8=F8+F12
pm:0x841d  Tap_Delay             ; M7=0x12C(300); DM(I2,M7)=R0
pm:0x8420  LFO_PhaseAccum2       ; R8=R5*R9 second modulation index
pm:0x8425  AllpassInterp2        ; FLOAT R3 BY R4; allpass frac interp
pm:0x842d  ReadInputR            ; R3=DM(0x21,I4) right channel path
pm:0x8431  Delay2_Write          ; M7=0x1F40; DM(I6,M7)=R0
pm:0x8441  AllpassInterp3        ; second-channel allpass interp
pm:0x8449  AmpScale_Return       ; R6=R6*R14; R8=R8*R14; RTS(DB)
pm:0x844b  OutputL               ; DM(I4,M2)=R6
pm:0x844c  OutputR               ; DM(I4,M2)=R8
