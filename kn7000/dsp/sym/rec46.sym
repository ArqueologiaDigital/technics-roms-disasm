; rec46 — EFFECT: LFO-swept 10-POLE RESONANT LOWPASS (filter-wah), computed bilinear coeffs
; (corrected from "6-stage swept-allpass phaser": no allpass — five identical 2nd-order
; LOWPASS sections, Q=1, numerator g^2*(1+z^-1)^2). Full doc dsp/insert-effects-algorithms.md #2.
; g = 0.2*m + 0.0014 (m = unipolar sine LFO) is the bilinear tan-domain variable
; g = tan(pi*f0/fs): f0 sweeps 19.6 Hz .. 2.79 kHz at 1.35 Hz (incr 0x10000 in PM 0x9800).
; Denominator (1+g^2+g) + 2(g^2-1)z^-1 + (1+g^2-g)z^-2 = bilinear of 1/(s^2+s+1);
; reciprocal via RECIPS + 3 Newton iterations PER SAMPLE. Mono in (L+R)/2, mono out x0.5.
; NOTE: only FIVE stages — the old "AllpassStage6" at 0x8458 is the output-scale load.
pm:0x8400  Entry                 ; I0=I1
pm:0x8401  LFO_PhaseAcc          ; phase(c004) += incr(PM 0x9800 = 0x10000 -> 1.35 Hz); 31-bit wrap
pm:0x8404  LFO_StateWrite        ; DM(I0,M2)=R8 store phase -> c004
pm:0x8406  LFO_TableIndex        ; ASHIFT-11/-16 -> 16-step sine index (table center c030)
pm:0x840a  LFO_SineInterp        ; MR1F/MAC linear interp between sine samples
pm:0x840f  Mod_Unipolar          ; F8=FLOAT BY -31; +1.0; *0.5 -> m in [0,1]
pm:0x8416  SweepMap              ; g = c005(0.2)*m + c006(0.0014); CLIP by 1.0
pm:0x841c  BilinearPrep          ; g^2; 1+g^2-g (F1); 1+g^2+g (F12); 2(g^2-1) (F9); -2 (c00c)
pm:0x8427  RecipNewton           ; F0=RECIPS + 3x Newton -> 1/(1+g+g^2) (F3); F0=g^2 numerator
pm:0x8431  Input_Mono            ; R5=(DM(0x20)+DM(0x21))/2; FLOAT
pm:0x8435  LP_Stage1             ; w=(g^2*x -2(g^2-1)w1 -(1+g^2-g)w2)/(1+g+g^2); y=w+2w1+w2 (state c00d/e)
pm:0x843c  LP_Stage2             ; state c00f/c010
pm:0x8443  LP_Stage3             ; state c011/c012
pm:0x844a  LP_Stage4             ; state c013/c014
pm:0x8451  LP_Stage5             ; state c015/c016
pm:0x8458  OutCoeffLoad          ; R0 = c017 (0.5 output scale) — NOT a sixth stage
pm:0x8459  OutputScale           ; F5=F5*0.5; FIX; *wet(c018); CLIP +-0x7FFFFF
pm:0x845e  OutputWrite           ; DM(I4,M2)=R0 twice (mono to L and R)
pm:0x8460  Return                ; RTS(DB)
dm:0x9800  LFO_incr              ; 0x00010000 = 1.346 Hz (fs*incr/2^31) — LFO rate, host-writable
dm:0xc005  SweepScale            ; 0.2 (0x3E4CCCCC): g = 0.2*m + offset
dm:0xc006  SweepOffset           ; 0.0014 (0x3AB78034): min g -> f0 = 19.6 Hz
dm:0xc00c  Coeff_neg2            ; -2.0 (0xC0000000) bilinear prep constant
dm:0xc017  OutScale_half         ; 0.5 (0x3F000000) output scale
dm:0xc018  Wet                   ; 0x7FFFFFFF Q31 ~1.0
dm:0xc028  SineLFO_table         ; sine LFO waveform table (c028..c03f + guard, center c030)
dm:0xc030  SineLFO_neg_half      ; negative half of sine table
