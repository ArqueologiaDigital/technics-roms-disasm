; rec22 — EFFECT: dynamics processor (envelope follower + gain), fixed-point
; Family: DM@C000:40e "gain" super-family (shares I/O framing with rec21/25).
; Mono-summed detector drives a two-stage one-pole envelope with attack/release
; coeff select; the resulting gain multiplies the L and R input samples.
pm:0x8400  Entry_I0eqI1            ; I0 = I1 : copy effect DM coeff/state base
pm:0x8401  ReadInL                 ; R0 = DM(0x20,I4) input L
pm:0x8402  ReadInR                 ; R8 = DM(0x21,I4) input R
pm:0x8403  SumMono                 ; R8 = L+R (mono detector signal)
pm:0x8404  ScaleLShift9            ; R8 <<= 9 headroom rescale
pm:0x8405  Rectify_LoadEnvState    ; R8=ABS(det); R7 = PM(I8,M14) prev env state
pm:0x8406  EnvDelta                ; R3 = det - env
pm:0x8407  AttackReleaseSelect     ; IF LT reload alt (release) coeff from DM
pm:0x8409  EnvOnePoleUpdate        ; R8 = env + R3*coeff  (one-pole smoothing)
pm:0x840a  StoreEnvState           ; PM(I8,M8) = new env state
pm:0x840d  ThresholdCompare        ; COMP(R7,R3) gain-stage threshold test
pm:0x8411  GainOnePole             ; R3 = gain state + R3*step
pm:0x8412  ApplyGain_L_StoreState  ; R0 = gain*inL ; PM(I8,M8) = gain state
pm:0x8414  OutL                    ; DM(I4,M2) = out L
pm:0x8415  ReReadInForR            ; R0 = DM(0x20,I4)
pm:0x8418  OutR                    ; DM(I4,M2) = out R
pm:0x8419  Return                  ; RTS (delayed)
pm:0x841b  PMStateRewind           ; MODIFY(I8,0x4E) rewind 78-word PM state
dm:0xc004  Coeff_AttackRate        ; 0x04000000 attack step
dm:0xc005  Coeff_ReleaseRate       ; 0x00100000 release step
dm:0xc006  Coeff_GainStep          ; 0x10000000
dm:0xc007  Coeff_Threshold         ; 0x7FFFFFFF detector/threshold max
dm:0xc008  Coeff_A                 ; 0x00010000
dm:0xc00a  Coeff_B                 ; 0x01000000
dm:0xc00b  Coeff_MakeupMax         ; 0x7FFFFFFF
