; rec53 — EFFECT: float comb+allpass REVERB (variant of rec51 family)
; Same PM algorithm as rec51 (see rec51.sym). Preset differs:
;   delay lengths and the full damping/mix coeff bank (c004..c023) changed;
;   c011..c013 here are non-unity (0x3F74BC6A/0x3F43D70A) = stronger feedback.
; Delays: 8406=0xFFFFFB86 8410=0xFFFFFD3E 841a=0xFFFFFB2D 841d=0xFFFFFDEF.
;
dm:0x9808  rev_damp0             ; 0x3DB020C4 damping coeff (this preset)
dm:0x980a  rev_damp1             ; 0x3E841893 damping coeff (this preset)
dm:0xc004  rev_biquad_inL        ; 0x3FCC985F b0 input tone biquad L
dm:0xc011  rev_fb_gain           ; 0x3F74BC6A feedback/mix weight (non-unity here)
dm:0xc014  rev_diffuser_gain     ; 0x3F1CE075 diffuser/allpass gain (this preset)
dm:0xc024  rev_mix_wet_neg       ; wet mix (inverting)
dm:0xc026  rev_out_scale         ; output scale
pm:0x8400  rev_entry             ; effect entry (see rec51.sym for full trace)
pm:0x8403  rev_delaybase         ; MODIFY(I6,0x00010747) delay-buffer base
pm:0x8406  rev_delaylen0         ; M7=0xFFFFFB86 early delay len 0 (VARIANT)
pm:0x8410  rev_delaylen1         ; M7=0xFFFFFD3E early delay len 1 (VARIANT)
pm:0x841a  rev_delaylen2         ; M7=0xFFFFFB2D early delay len 2 (VARIANT)
pm:0x841d  rev_delaylen3         ; M7=0xFFFFFDEF early delay len 3 (VARIANT)
pm:0x841f  rev_allpass          ; float allpass core
pm:0x8425  rev_diffuse_chain     ; allpass/comb diffuser loop
pm:0x8468  rev_out_L             ; left output write
pm:0x846d  rev_out_R             ; right output write
pm:0x846f  rev_rts               ; RTS(DB)
