; rec24 — EFFECT: LFO amplitude modulation (tremolo / auto-pan)
; DM@C000:77e "modulation" super-family (shares the c029..c03f half-sine window
; table). A DM phase accumulator (DM(I0,M6) += increment) indexes the sine table
; via I5=I1+0x2C with linear interpolation (ASHIFT-16 integer index, FDEP 15:16
; fractional weight) -> a sine LFO value. The LFO scales the input sample; no
; audio delay line is written, so this is pure amplitude/pan modulation.
; DM@9800: 9800/9801 = LFO increment (rate), 9802/9803 = 0x66666666 depth.
pm:0x8400  Entry_I0eqI1            ; I0 = I1
pm:0x8401  PhaseAccum_L            ; R8 = DM(I0,M6)phase + PM(I8,M8)inc
pm:0x8403  PhaseWrap               ; FDEP 0:31 sign-extend phase
pm:0x8404  StorePhase_L            ; DM(I0,M2) = phase
pm:0x8405  SineTableBase           ; I5 = I1
pm:0x8406  PhaseIntShift           ; R8 = ASHIFT -11 (integer scan)
pm:0x8407  SineTableOffset         ; MODIFY(I5,0x2C) -> half-sine table
pm:0x8408  IndexHi                 ; R7 = ASHIFT -16 table index
pm:0x840a  FracWeight_ReadTap0     ; R3=frac; R7 = table[idx]
pm:0x840d  Interp_MAC              ; MRF += frac*(tap1-tap0) linear interp
pm:0x840e  LFO0_Result             ; R8 = interpolated sine value
pm:0x840f  SaveLFO0                ; R5 = LFO channel-0 value
pm:0x8410  PhaseAccum_R            ; second LFO phase (R channel)
pm:0x841d  LFO1_Result             ; R8 = second interpolated sine value
pm:0x841e  ReadInL                 ; R0 = DM(0x20,I4) input
pm:0x8421  DepthScale_L            ; R7 = depth*LFO
pm:0x8423  AmpModL                 ; R8 = (bias + depth*LFO) * input
pm:0x8427  ClipL                   ; CLIP by 0x007FFFFF
pm:0x8428  OutL                    ; DM(I4,M2) = out L
pm:0x8429  ReadInR                 ; R0 = DM(0x20,I4)
pm:0x8432  OutR                    ; DM(I4,M2) = out R
pm:0x8433  Return                  ; RTS (delayed)
pm:0x8435  PMStateRewind           ; MODIFY(I8,0x4C) rewind 76-word PM state
dm:0x9800  LFO_Increment_L         ; 0x00080000 LFO rate (channel 0)
dm:0x9802  LFO_Depth               ; 0x66666666 modulation depth
dm:0xc006  Coeff_DepthScale        ; 0x19999999 (0.2) depth trim
dm:0xc007  Coeff_Bias              ; 0x7FFFFFFF
dm:0xc029  SineWindow_Table        ; half-sine LFO/crossfade table (c029..c03f)
dm:0xc02c  SineWindow_Peak         ; 0x7FFFFFFF table centre (=1.0)
