; rec65 — cubic soft-clip overdrive (family rec62-65; tone bank D, type 0x67)
; Identical PM to rec62 — see sym/rec62.sym + dsp/insert-effects-algorithms.md #3.
; Bank D: inject 0.10; poles = rec62's (r=0.901 @ 2.91 kHz) with softened real
; zeros 0.889/0.109. Unity DC.
pm:0x8400  DistEntry             ; I0 = I1
pm:0x840c  recipGain             ; AGC (inert as in rec62; clamps at 4.0)
pm:0x841d  chA_cubicShaper       ; y = x - x^3/3, rails +-2/3
pm:0x842f  chA_toneBank          ; tone bank D (c018-c01d = this preset)
pm:0x843e  chA_writeOut          ; DM(I4,M2) = R8
pm:0x846a  DistReturn            ; RTS (DB)
dm:0xc018  ToneInject            ; 0.10 (0x3DCCCCCD) (PRESET)
dm:0xc019  ToneA1                ; +1.6491: poles r=0.901 @ 2.91 kHz (= rec62 bank)
dm:0xc01a  ToneA2                ; -0.8122
dm:0xc01b  ToneB1                ; -1.6491
dm:0xc01c  ToneB0                ; +1.652 (0x3FD3743C): real zeros 0.889/0.109
dm:0xc01d  ToneB2                ; +0.1602 (0x3E240EAB)
