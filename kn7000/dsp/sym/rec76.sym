; rec76 [EFFECT] — reciprocal-phase LFO + allpass-interpolated modulated delay, stereo (F75-76 family)
; PM byte-identical to rec75; differs only in DM coeffs (preset: 9801=0x6666666600). Chorus/flanger-class.
pm:0x8400  Entry_I0eqI1          ; I0=I1
pm:0x8401  ReadInputLR           ; R0=DM(0x20,I4); R6=DM(0x21,I4); R8=R0+R6
pm:0x8404  InScale               ; LSHIFT R8 BY 9; LSHIFT R0 BY 9; F0=FLOAT R0
pm:0x8407  RangeReduce_Abs       ; R8=ABS; R3=R8-R7; MRF+(R3*R4) piecewise
pm:0x840c  Recip_PhaseGen        ; F8=RECIPS; F8=F4*F8; F15=F3+F8 phase
pm:0x8412  PhaseScale            ; F15=F15*F1; F0=F0*F15
pm:0x8414  Phase_To_Index        ; R8=FIX F0; ASHIFT -11; MODIFY(I5,0x34) tap
pm:0x8417  IntFrac_Split         ; int part->M7; FDEP R8 15:16 fraction
pm:0x841a  AllpassInterp1        ; F3=FLOAT R3 BY R4; F12=F3*F8; F8=F8-F12; F8=F8+F12
pm:0x841f  Tap_MAC               ; MRF=R2*R0; R8=MRF+(R9*R7) feedback MAC
pm:0x8421  WetScale              ; F8=FLOAT R8; F10=F8*F11; F0=F10*F0
pm:0x8428  Delay1_Write          ; M7=0x1388(5000); DM(I6,M7)=R8
pm:0x842a  Delay1_Read           ; R8=DM(I6,M6)
pm:0x842c  Delay1_Advance        ; M7=0x3C64; MODIFY(I6,M7)
pm:0x8430  Tap2Setup             ; MODIFY(I5,0x34) second modulated tap
pm:0x8434  AllpassInterp2        ; second-channel allpass frac interp
pm:0x8440  Delay2_Write          ; M7=0x1388(5000); DM(I6,M7)=R4
pm:0x8447  OutputL               ; R1=LSHIFT -8; DM(I4,M2)=R1
pm:0x8449  Return                ; RTS (DB); R8=R8*R14
pm:0x844b  OutputR               ; R8=LSHIFT -8; DM(I4,M2)=R8
dm:0x9801  Preset_Coef           ; 0x6666666600 (=0.9 approx) — differs from rec75 (zero)
