# rec03 [PROBE] — external-SDRAM POST / board-variant probe, variant 5-high
# Tests SDRAM region 0xA0000..0xC0000 (4x 32K-word banks) with pattern 0x55555555.
# One of a 2x2 family: {pattern AAAA/5555} x {region 0x80000 / 0xA0000}.
# = rec02 with 5-pattern, or rec01 with high region. DM identical to rec00-03.

pm:0x8400  Probe_Entry            ; R3 = DM(I1,M6): read run-once guard flag
pm:0x8401  GuardTest              ; R3 = R3+R3 — sets Z if not yet probed
pm:0x8402  GuardSkipIfDone        ; IF NE JUMP 0x842B: already probed -> return
pm:0x8403  ClearResult            ; R3 = 0
pm:0x8404  InitHostReg0B          ; DM(0x0B) = 0
pm:0x8405  LoadTestPattern        ; R0 = 0x55555555  <-- VARIANT: 5-pattern
pm:0x8406  MarkProbed             ; DM(I1,M6) = R0: run-once guard
pm:0x8407  Bank0_SetPtr           ; I5 = 0x000A0000  <-- VARIANT: SDRAM region base (high)
pm:0x8408  Bank0_FillLoop         ; LCNTR=0x8000: fill 32K words
pm:0x8409  Bank0_FillStore        ; DM(I5,M2) = R0
pm:0x840a  Bank0_Rewind           ; I5 = 0x000A0000
pm:0x840b  Bank0_VerifyLoop       ; read back and compare
pm:0x840c  Bank0_Readback         ; R1 = DM(I5,M2)
pm:0x840d  Bank0_Compare          ; R2 = R1 - R0
pm:0x840e  Bank0_RecordMismatch   ; IF NE R3 = R1
pm:0x840f  Bank0_Report           ; DM(0x0B) = R3
pm:0x8410  Bank1_SetPtr           ; I5 = 0x000A8000
pm:0x8418  Bank1_Report           ; DM(0x0B) = R3
pm:0x8419  Bank2_SetPtr           ; I5 = 0x000B0000
pm:0x8421  Bank2_Report           ; DM(0x0B) = R3
pm:0x8422  Bank3_SetPtr           ; I5 = 0x000B8000
pm:0x842a  Bank3_Report           ; DM(0x0B) = R3 (0 = all banks OK)
pm:0x842b  Probe_Return           ; RTS (DB)
pm:0x842c  RetSlot1_PtrRestore    ; delay slot: pointer housekeeping
pm:0x842d  RetSlot2_PtrAdvance    ; delay slot: MODIFY(I8, 0x50)

dm:0xc006  Const_PosFull          ; 0x7FFFFFFF = +1.0
dm:0xc029  CosTwiddleTable        ; 8-pt cos/sin twiddle table (shared)
dm:0xc034  Const_NegFull          ; 0x80000000 = -1.0
