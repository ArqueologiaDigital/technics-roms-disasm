; rec33 EFFECT — 16-tap FIR convolution + biquad, stereo
; Averages L/R, convolves against a coefficient kernel (PM), two accumulators
; -> two biquad-filtered outputs. Circular delay buffer L=0x400 (1024 words).
pm:0x8400  Rec33_Entry          ; I0=I1; save I2; MODIFY(I2,0x3FF) circular buffer setup
pm:0x8403  Rec33_AudioIn        ; R0=DM(0x20) L, R1=DM(0x21) R; F11=(F0+F1)/2 mono sum
pm:0x8407  Rec33_FIR_AccA       ; FIR MAC chain: F8=F2*F6,F12=F8+F12, taps DM(I2,M3)*PM(I8,M8)
pm:0x841c  Rec33_FIR_AccB       ; second FIR accumulator into F13 (other channel/tap set)
pm:0x842e  Rec33_Biquad         ; biquad sections, state in PM(I8,M11/M9) write-back
pm:0x843d  Rec33_MixCross       ; F12=F12+F4, F13=F13-F5 stereo cross-mix
pm:0x843f  Rec33_OutLeft        ; R8=FIX F12, *level, CLIP, DM(I4,M2)=R8
pm:0x8443  Rec33_OutRight       ; R8=FIX F13, *level, CLIP, DM(I4,M2)=R8
pm:0x8447  Rec33_Return         ; RTS; I2=R15 restore
dm:0x9800  Rec33_FIR_Taps       ; 16 float FIR coefficients (kernel) 0x9800..0x980f
dm:0xc006  Rec33_BiquadCoefA    ; biquad section coeffs (b0,b1,b2,a1,a2) c006..c00a
dm:0xc00b  Rec33_BiquadCoefB    ; duplicate biquad section c00b..c00f
dm:0xc010  Rec33_Unity          ; =0x7FFFFFFF unity
