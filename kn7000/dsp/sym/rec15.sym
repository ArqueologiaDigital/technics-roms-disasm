; rec15 — EFFECT: 2-comb reverb, shorter taps (smaller room) variant of rec13, C000:40e family
pm:0x8400  Entry_SetInPtr        ; I0=I1, R15=I6 base
pm:0x8402  LoadFeedbackState     ; R10=DM(-2,I1)
pm:0x8403  Comb1_ReadTap_Coeff   ; R7=DM(I0,M2), R3=PM(I8,M14)
pm:0x8404  Comb1_AllpassMAC      ; F12=F3*F7 / F3=F10+F12 / F7=F3*F7, PM(I8,M8)=R3
pm:0x8408  LoadInputL            ; R3=DM(0x20,I4)
pm:0x840c  Comb1_TapLen_4000     ; M7=0x0FA0 (4000) delay tap
pm:0x840d  Comb1_WriteDelay      ; DM(I6,M7)=R0
pm:0x8411  AdvanceDelayBase      ; MODIFY(I6,M7=0x3C64)
pm:0x8412  StoreState_m1         ; DM(-1,I1)=R8
pm:0x841a  OutputWriteL          ; DM(I4,M2)=R8
pm:0x8429  Comb2_TapLen_4400     ; M7=0x1130 (4400) second comb tap
pm:0x842a  Comb2_WriteDelay      ; DM(I6,M7)=R0
pm:0x8436  OutputWriteR          ; DM(I4,M2)=R8
pm:0x8437  CrossMixTaps          ; R3=PM(I8,M8): F8=F3*F7,F12=F2*F7, DM(I0,M6)=R12
pm:0x843d  Return                ; RTS(DB)
