; rec51 — EFFECT: stereo REVERB — the KN7000 reverb engine (types 0x14/0x15)
; Topology (full dataflow trace, 2026-07-19 — see dsp/reverb-algorithm.md):
;   2 filtered early-reflection pre-delay lines (A/B, 2 taps each)
;   + mono dry -> 4 series allpasses (k=0.618; 313/607/1227/2587)
;   -> absorbing allpass (5239, damped loop)
;   -> 2 parallel damped feedback combs (16232 / 14464, mid-taps out)
;   -> output tone biquad -> short stereo-decorrelation line J (1 / 257)
; All delay state in external SDRAM via I6 (B6=0x20000, L6=0x456F0);
; the kernel main loop scrolls I6 by -1/frame, so DM(I6) offsets ARE sample delays.
; reference preset bank; tank decay -0.2435 -> per-comb RT60(DC) ~1.8s/1.6s;
; output tone biquad = same 4.8kHz LP as the input filter
;
dm:0x9800  rev_s_gain0          ; 0x404CCCCC +3.2     input gain word 0 (prefetched @8405, value unused)
dm:0x9801  rev_s_lp1_gain       ; 0xC04CCCCC -3.2     input gain, LP1 branch (negated mono: x both L and R)
dm:0x9802  rev_s_lp1_z1         ; 0x00000000 state    LP1 z1 (DF2 state)
dm:0x9803  rev_s_lp1_z2         ; 0x00000000 state    LP1 z2
dm:0x9804  rev_s_lp2_gainR      ; 0x404CCCCC +3.2     input gain in_R, LP2 branch
dm:0x9805  rev_s_lp2_gainL      ; 0x404CCCCC +3.2     input gain in_L, LP2 branch
dm:0x9806  rev_s_lp2_z1         ; 0x00000000 state    LP2 z1
dm:0x9807  rev_s_lp2_z2         ; 0x00000000 state    LP2 z2
dm:0x9808  rev_s_egainA1        ; 0x3E041893 +0.1290  early gain g0 x lineA tap1
dm:0x9809  rev_s_egainB1        ; 0x3D0B4395 +0.0340  early gain g1 x lineB tap1
dm:0x980a  rev_s_egainA2        ; 0x3E5374BC +0.2065  early gain g2 x lineA tap2 (sum/diff term)
dm:0x980b  rev_s_egainB2        ; 0x3D1FBE76 +0.0390  early gain g3 x lineB tap2 (sum/diff term)
dm:0x980c  rev_s_dampG_h        ; 0x00000000 state    damping filter state h (absorber G)
dm:0x980d  rev_s_dampH_h        ; 0x00000000 state    damping filter state h (comb H)
dm:0x980e  rev_s_dampI_h        ; 0x00000000 state    damping filter state h (comb I)
dm:0x980f  rev_s_lpout_z1       ; 0x00000000 state    output tone biquad z1
dm:0x9810  rev_s_lpout_z2       ; 0x00000000 state    output tone biquad z2
dm:0xc003  rev_i6_save           ; scratch: I6 saved/restored here each frame (DM(I1-1))
dm:0xc004  rev_lp1_a1           ; 0x3F5A5E35 +0.8530  input LP1 a1   (biquad order in DM: a1,a2,b1,b0,b2)
dm:0xc005  rev_lp1_a2           ; 0xBE99652B -0.2996  input LP1 a2   (poles r=.547 -> ~4.8kHz LP, unity DC)
dm:0xc006  rev_lp1_b1           ; 0x3E64A8C1 +0.2233  input LP1 b1
dm:0xc007  rev_lp1_b0           ; 0x3DE4C2F8 +0.1117  input LP1 b0
dm:0xc008  rev_lp1_b2           ; 0x3DE4C2F8 +0.1117  input LP1 b2
dm:0xc009  rev_lp2_a1           ; 0x3F2D9E83 +0.6782  input LP2 a1   (poles r=.500 -> ~5.8kHz LP, unity DC)
dm:0xc00a  rev_lp2_a2           ; 0xBE800000 -0.2500  input LP2 a2
dm:0xc00b  rev_lp2_b1           ; 0x3E92617C +0.2859  input LP2 b1
dm:0xc00c  rev_lp2_b0           ; 0x3E126E97 +0.1430  input LP2 b0
dm:0xc00d  rev_lp2_b2           ; 0x3E126E97 +0.1430  input LP2 b2
dm:0xc00e  rev_drygain_L        ; 0x3F23D70A +0.6400  dry-input gain L into the diffuser (x in_L @8420)
dm:0xc00f  rev_drygain_R        ; 0x3F23D70A +0.6400  dry-input gain R into the diffuser (x in_R @8421)
dm:0xc010  rev_diffuse_k        ; 0xBF1E33FF -0.6180  diffuser/absorber allpass k (shared by ap1-ap4 + G)
dm:0xc011  rev_ap3_tapscale     ; 0x3F800000 +1.0000  ap3 tap prescale (@842f)
dm:0xc012  rev_ap4_tapscale     ; 0x3F800000 +1.0000  ap4 tap prescale (@8435)
dm:0xc013  rev_absorbG_gain     ; 0x3F296BB9 +0.6618  absorber G tap gain into its damping filter (@843b)
dm:0xc014  rev_dampG_p          ; 0x3EBF8A09 +0.3741  damp G pole p:   h' = c013*tap + p*h
dm:0xc015  rev_dampG_q0         ; 0x3EA04189 +0.3130  damp G q0:  f = q0*h + q1*h'  (zero at Nyquist)
dm:0xc016  rev_dampG_q1         ; 0x3EA04189 +0.3130  damp G q1   (f has unity DC gain: 2q/(1-p)=1)
dm:0xc017  rev_dampH_p          ; 0x3EBF8A09 +0.3741  damp H pole p
dm:0xc018  rev_dampH_q0         ; 0x3EA04189 +0.3130  damp H q0
dm:0xc019  rev_dampH_q1         ; 0x3EA04189 +0.3130  damp H q1
dm:0xc01a  rev_tank_decay       ; 0xBE795810 -0.2435  TANK DECAY g: comb feedback (both combs, @844a/@8454)
dm:0xc01b  rev_dampI_p          ; 0x3EBF8A09 +0.3741  damp I pole p
dm:0xc01c  rev_dampI_q0         ; 0x3EA04189 +0.3130  damp I q0
dm:0xc01d  rev_dampI_q1         ; 0x3EA04189 +0.3130  damp I q1
dm:0xc01e  rev_midtap_gain      ; 0x3EF95810 +0.4870  comb mid-tap output gain (x H@8912 + I@8466)
dm:0xc01f  rev_lpout_a1         ; 0x3F5A5E35 +0.8530  output tone biquad a1 (on the wet sum)
dm:0xc020  rev_lpout_a2         ; 0xBE99652B -0.2996  output tone biquad a2
dm:0xc021  rev_lpout_b1         ; 0x3E64A8C1 +0.2233  output tone biquad b1
dm:0xc022  rev_lpout_b0         ; 0x3DE4C2F8 +0.1117  output tone biquad b0
dm:0xc023  rev_lpout_b2         ; 0x3DE4C2F8 +0.1117  output tone biquad b2
dm:0xc024  rev_wet_ch2          ; 0xBF0FBACC -0.5614  wet mix, ch @I4+1: E2 - 0.5614*J@257
dm:0xc025  rev_wet_ch1          ; 0x3F0FBACC +0.5614  wet mix, ch @I4+0: E1 + 0.5614*J@1
dm:0xc026  rev_outscale_ch2     ; 0x40000000 Q31 0.5  output scale ch@I4+1 (FIXED mult: 0x40000000 = 0.5)
dm:0xc027  rev_clip             ; 0x007FFFFF clip     CLIP limit +-0x7FFFFF (24-bit DAC range)
dm:0xc028  rev_outscale_ch1     ; 0x40000000 Q31 0.5  output scale ch@I4+0
pm:0x8400  rev_entry            ; I0 = I1: param cursor (unit's 0x4D block @0xC004+slot*0x4D)
pm:0x8401  rev_save_i6          ; R0=I6; DM(I1-1)=R0: save SDRAM delay cursor in param c003
pm:0x8403  rev_arena_top        ; I6 += 0x10747 -> P0 = top of the 0x10748-word SDRAM arena (B6=0x20000 L6=0x456F0, kernel scrolls -1/frame)
pm:0x8404  rev_read_inL         ; R0 = DM(I4+0x20) input L (call-slot1: 0xC362 = TG effect send); F0=FLOAT
pm:0x8406  rev_m7_gapA          ; M7 = -0x880 (PRESET): lineA tap1->tap2 gap; tap1 delay = 3712 (84.2ms)
pm:0x8408  rev_read_inR         ; R1 = DM(I4+0x21) input R; F1=FLOAT; R6 = lineA tap1 @P0 (delay 3712)
pm:0x840a  rev_lp1_negmono      ; DF2 biquad LP1 (c004-c008) on x = -3.2*(L+R)  (gain s1=0x9801)
pm:0x8410  rev_m7_gapA2         ; M7 = -0x600 (PRESET): tap2->write gap = lineA tap2 delay 1536 (34.8ms)
pm:0x8412  rev_lp2_posmono      ; F14 = LP1 out; DF2 biquad LP2 (c009-c00d) on x = +3.2*(L+R); R4 = lineA tap2 (delay 1536)
pm:0x8418  rev_wr_lineA         ; DM(I6,M3)=R14: line A head = LP1(-3.2*mono)  [early-reflection pre-delay 1]
pm:0x841a  rev_m7_gapB          ; M7 = -0x442 (PRESET): -> lineB tap1 (delay 2370, 53.7ms); F9 = g0*A3712
pm:0x841d  rev_m7_gapB2         ; M7 = -0x500 (PRESET): lineB tap2 delay 1280 (29.0ms); early gains g0-g3 = s8-s11
pm:0x841f  rev_early_sumdiff    ; dual add/sub: E1(F14)=cm+s, E2(F15)=cm-s; cm=g0*A3712+g1*B2370, s=g2*A1536+g3*B1280
pm:0x8421  rev_wr_lineB         ; DM(I6,M3)=R15(old): line B head = LP2(+3.2*mono); F11 = 0.64*in_R (c00f)
pm:0x8424  rev_dry_mono         ; F11 = 0.64*(L+R) = diffuser input; R2 = c010 (k = -0.618)
pm:0x8425  rev_ap1              ; series allpass 1, delay 313 (7.1ms): w = x + 0.618*D; y = D - 0.618*w; DM(I6,M3)=w
pm:0x842a  rev_ap2              ; series allpass 2, delay 607 (13.8ms)
pm:0x842f  rev_ap3              ; series allpass 3, delay 1227 (27.8ms); tap prescaled by c011
pm:0x8435  rev_ap4              ; series allpass 4, delay 2587 (58.7ms); tap prescaled by c012
pm:0x843b  rev_absorbG          ; absorbing allpass G, delay 5239 (118.8ms): F10 = c013 * G@5239 -> damping filter
pm:0x843c  rev_dampG            ; one-pole+zero damp f_G: h' = in + c014*h; f = c015*h + c016*h' (unity DC)
pm:0x8443  rev_wr_lineG         ; line G head w_G = y_ap4 + 0.618*f_G(G@5239)   [lowpass inside the allpass loop]
pm:0x8444  rev_combH            ; y_ap5 = f_G - 0.618*w_G; comb H delay 16232 (368.1ms); damp f_H = c017-c019
pm:0x844a  rev_tank_decayH      ; F10 = f_H(H@16232) * c01a  <- the tank decay multiply (RT60 lives here)
pm:0x844c  rev_wr_lineH         ; line H head w_H = y_ap5 + g*f_H(H@16232)  (g = c01a, negative)
pm:0x844e  rev_combI            ; comb I delay 14464 (328.0ms), same form; output taps H@8912 (202ms), I@8466 (192ms)
pm:0x8454  rev_tank_decayI      ; F10 = f_I(I@14464) * c01a
pm:0x8457  rev_wr_lineI         ; line I head w_I = y_ap5 + g*f_I(I@14464); wet = w_H + c01e*H@8912
pm:0x8459  rev_wet_sum          ; wet += w_I + c01e*I@8466  (comb heads + mid-taps = 4-term wet sum)
pm:0x845b  rev_lp_out           ; DF2 output tone biquad (c01f-c023) on the wet sum -> y_out
pm:0x8461  rev_rd_J257          ; R13 = line J tap @257 (5.8ms stereo decorrelator)
pm:0x8462  rev_wetmix_ch2       ; F13 = J@257 * c024 (-0.5614)
pm:0x8464  rev_mix_ch2          ; F1 = E2 - 0.5614*J@257  (early diff-mix + inverted wet)
pm:0x8465  rev_fix_ch2          ; R8 = FIX F1; R12 = line J tap @1
pm:0x8466  rev_scale_ch2        ; R8 = R8 * c026 (fixed Q31 0x40000000 = x0.5); R1 = clip const c027
pm:0x8467  rev_clip_ch2         ; CLIP +-0x7FFFFF
pm:0x8468  rev_out_ch2          ; DM(M2,I4)=R8 -> out slot I4+1 (pre-modify, I4 unchanged); F12 = J@1 * c025
pm:0x8469  rev_mix_ch1          ; F0 = E1 + 0.5614*J@1  (early sum-mix + wet)
pm:0x846a  rev_fix_ch1          ; R8 = FIX F0; DM(I6,M3)=R11: WRITE line J head = y_out (taps 1 & 257)
pm:0x846b  rev_scale_ch1        ; R8 = R8 * c028 (x0.5 fixed)
pm:0x846c  rev_clip_ch1         ; CLIP; R0 = DM(I1-1) reload saved I6
pm:0x846d  rev_out_ch1          ; DM(I4,M1)=R8 -> out slot I4+0; I4 += 2 (next unit's I/O slot)
pm:0x846e  rev_restore_i6       ; I6 = R0 (kernel delay-slot MODIFYs own the per-unit arena walk)
pm:0x846f  rev_rts              ; RTS(DB); slots advance I1 +0x4D and I8 +0x3F (net +0x50 incl. state walk)
