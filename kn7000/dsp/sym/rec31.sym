; rec31 — EFFECT: RING MODULATOR (GUI "Ring Mod.1-4", type 0x36 — name = ROM
; fact via the preset-descriptor table, dsp/tremolo-rotary-family.md §1).
; Same two-LFO front end as rec24/26 (90deg offset templates) but NO bias
; term: the full BIPOLAR sine multiplies the signal — gain sweeps through
; zero and inverts polarity = ring modulation (sum/difference sidebands,
; carrier suppressed). Template increment 0x01000000 = 344.5 Hz is an
; AUDIO-RATE CARRIER — intentional here, not a placeholder. Quadrature
; carriers (L = in*sin(theta+90), R = in*sin(theta)) keep total power
; constant (cos^2+sin^2) and rotate the sideband image at the carrier
; rate. Full doc dsp/tremolo-rotary-family.md §3.
pm:0x8400  Entry_I0eqI1            ; I0 = I1
pm:0x8401  PhaseAccum_A            ; R8 = DM(I0,M6)phase + PM(I8,M8)inc
pm:0x8403  PhaseWrap               ; FDEP 0:31
pm:0x8404  StorePhase_A            ; DM(I0,M2) = phase
pm:0x8405  SineTableBaseA          ; I5 = I1
pm:0x8407  SineTableOffsetA        ; MODIFY(I5,0x2C) -> table
pm:0x840a  FracWeight_ReadTapA     ; frac + table[idx]
pm:0x840d  Interp_MAC_A            ; linear interp
pm:0x840e  Carrier_A               ; interpolated sine A (R-channel carrier)
pm:0x840f  SaveCarrier_A           ; R5 = carrier A
pm:0x8410  PhaseAccum_B            ; carrier B phase (c005 = +90deg)
pm:0x841d  Carrier_B               ; interpolated sine B (L-channel carrier)
pm:0x841e  ReadInL                 ; R0 = DM(0x20,I4)
pm:0x841f  RingModL                ; R8 = in * sinB (bipolar — no bias), R14 = level
pm:0x8422  ClipL                   ; CLIP 0x007FFFFF
pm:0x8423  OutL                    ; DM(I4,M2) = out L
pm:0x8424  ReadInR                 ; R0 = DM(0x20,I4)
pm:0x8425  RingModR                ; R8 = in * sinA
pm:0x8429  OutR                    ; DM(I4,M2) = out R
pm:0x842a  Return                  ; RTS (delayed)
pm:0x842c  PMStateRewind           ; MODIFY(I8,0x4E): 2 state reads
dm:0x9800  Carrier_Inc             ; 0x01000000 = 344.5 Hz audio-rate carrier (x2)
dm:0xc005  PhaseB_90deg            ; 0x20000000 = +90deg carrier offset
dm:0xc006  OutLevel                ; 0x7FFFFFFF = 1.0 (no bias cell — bipolar AM)
dm:0xc029  SineTable               ; family sine cycle + guard
