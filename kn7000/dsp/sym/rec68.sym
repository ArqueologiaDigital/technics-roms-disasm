; rec68 — BRASS SIMULATOR2 (type 0x7A, GUI group Vocal Effect) — the MINIMAL
; "blow model": no AGC, no envelope, no delay line (1 state word). Mono in_L
; x c004 (1e-8) -> the SAME 2-state nonlinear "lip" ODE as rec67 but
; 4x-OVERSAMPLED: LCNTR=4 DO-loop, Euler eps = c00a = 0.01 (4 x 0.01 = rec67's
; 0.04 per sample, at 4x the integration rate = tighter numerics): u' = x - v
; - 0.0667u^3 - 0.7u^2; v' = u^3 - x - 2v (u=c005, v=c008). Output = the v'
; RHS itself (u^3 - x - 2v = distortion products minus dry, ~560 Hz-
; highpassed by the 2v leak; equilibrium output ZERO -> the effect emphasizes
; attacks/dynamics — the brass "blat"). Then a +6 dB Nyquist one-pole shelf
; (unity DC: pole c00b=.769, out = 1.8802s' - 1.6489s, state PM 9800) ->
; x c00e (0.0005) -> cubic clip x - x^3/3 rails +-2/3 -> x c012 (8e9 renorm)
; x c013 (Q31) >>6, CLIP 24-bit, dual-mono out.
; Full doc: dsp/final-batch-algorithms.md §2.
pm:0x8400  Brass2_entry           ; I0 = I1
pm:0x8401  Brass2_readIn          ; R15 = in_L (mono)
pm:0x8403  Brass2_normalize       ; F15 = float(in<<8) * c004 (1e-8) — ODE input, no AGC
pm:0x8405  Brass2_odeLoop         ; LCNTR=4: 4x-oversampled Euler integration (eps 0.01)
pm:0x8407  Brass2_odeU            ; u' = x - v - 0.0667u^3 - 0.7u^2
pm:0x840c  Brass2_odeV            ; v' = u^3 - x - 2v (also the OUTPUT pick)
pm:0x8414  Brass2_loopWrap        ; MODIFY(I0,-6)/(+6): rewind coeff/state cells per iteration
pm:0x8416  Brass2_outPick         ; R10 = F7 = u^3 - x - 2v
pm:0x8417  Brass2_shelf           ; +6 dB Nyquist shelf, unity DC (c00b-c00d, state PM 9800)
pm:0x841c  Brass2_preclip         ; x c00e (0.0005)
pm:0x8420  Brass2_clipTest        ; cubic clip guards (+-1.0, c00f/c010)
pm:0x8424  Brass2_cubic           ; y = x - x^3/3 (c011 = 1/3)
pm:0x8429  Brass2_railPos         ; +2/3
pm:0x842b  Brass2_railNeg         ; -2/3
pm:0x842e  Brass2_outScale        ; x c012 (8e9) x c013 (Q31) >>6
pm:0x8433  Brass2_clipOut         ; CLIP +-0x7FFFFF
pm:0x8434  Brass2_outL            ; dual-mono out
pm:0x8435  Brass2_outR
pm:0x8436  Brass2_return          ; RTS (DB); MODIFY(I8,0x4F) (1 state word)
dm:0xc004  brass2_norm            ; 1.0e-8 — input normalize (= rec67's c019)
dm:0xc005  brass2_ode_u           ; ODE state u (runtime)
dm:0xc006  brass2_ode_a           ; 0.0667
dm:0xc007  brass2_ode_b           ; 0.70
dm:0xc008  brass2_ode_v           ; ODE state v (runtime)
dm:0xc009  brass2_ode_2           ; 2.0
dm:0xc00a  brass2_ode_eps         ; 0.01 — Euler step (x4 iterations)
dm:0xc00b  brass2_shelf_p         ; 0.7687 — shelf pole (unity DC, +6 dB @Nyquist)
dm:0xc00c  brass2_shelf_q1        ; -1.6489
dm:0xc00d  brass2_shelf_q0        ; 1.8802
dm:0xc00e  brass2_preclip         ; 0.0005
dm:0xc00f  brass2_clip_hi         ; +1.0
dm:0xc010  brass2_clip_lo         ; -1.0
dm:0xc011  brass2_third           ; 1/3
dm:0xc012  brass2_renorm          ; 8.0e9
dm:0xc013  brass2_level           ; Q31 ~1.0
