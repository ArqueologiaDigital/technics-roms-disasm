; rec21 — EFFECT: dynamics compressor/limiter/AGC (Newton-Raphson divide gain), C000:40e family
pm:0x8400  Entry_SetInPtr        ; I0=I1
pm:0x8401  LoadInputL_R          ; R13=DM(0x20,I4) L, R8=DM(0x21,I4) R
pm:0x8403  SumLR                 ; R8=R13+R8
pm:0x8404  ScaleEnvInput         ; R8=LSHIFT 9
pm:0x8405  RectifyEnv            ; R8=ABS R8 (rectified stereo sum = detector input)
pm:0x8406  ThreshCompare         ; R3=R8-R7 (R7=threshold coeff from PM ring)
pm:0x8407  BelowThresh           ; IF LT R4=DM(M3,I0) select release/attack coeff
pm:0x8408  EnvSmooth_MAC         ; MR1F=R7 prev; R8=MRF+(R3*R4) one-pole envelope integrator
pm:0x840a  StoreEnvState         ; PM(I8,M8)=R8
pm:0x840b  Env_ToFloat_Recip     ; F12=FLOAT R7; R11=2.0, R0=1.0 seed for reciprocal
pm:0x8410  RecipSeed             ; F0=RECIPS F12 reciprocal seed
pm:0x8411  RecipNR_Iter          ; F12=F0*F12 / F7=F0*F7 / F0=2-F12 Newton-Raphson (x3) => 1/env
pm:0x8418  ComputeGain           ; F8=F4*F0, F15=F3+F8 gain-reduction factor
pm:0x841a  GainCompare           ; COMP(R4,R1); IF GE clamp
pm:0x841c  ApplyGain_L           ; F0=FLOAT R13; F0=F0*F15; R0=FIX; *makeup; CLIP
pm:0x8422  OutputWriteL          ; DM(I4,M2)=R0
pm:0x8423  ApplyGain_R           ; R0=DM(0x20,I4)... F0*F15 (same gain both channels)
pm:0x8429  OutputWriteR          ; DM(I4,M2)=R0
pm:0x842a  Return                ; RTS(DB)
dm:0xc006  ThreshOrKnee          ; 0.333
dm:0xc009  Makeup_2x             ; 2.0
dm:0xc00a  UnityFixed            ; 0x7FFFFFFF
