; rec60 — MIC REVERB "Stage" (unit-7, type 0x5A) — rec58's half-rate
; series-allpass program, PM identical except the six M7 tap immediates; DM
; (gains) byte-identical to rec58. Tank scaled ~1.35x: phase A 2250/1500/1400
; ticks (102.0/68.0/63.5 ms), phase B 1235/799/920 (56.0/36.2/41.7 ms) ->
; total 322 ms of AP delay, RT60 ~3.2 s. See rec58 / final-batch doc §1.
pm:0x8400  MicRev_phaseSel        ; IF NOT FLAG3, JUMP phase-B (see rec58)
pm:0x8410  phA_out1               ; output word 1
pm:0x8419  phA_out2               ; output word 2
pm:0x841d  phA_ap1_len            ; M7 = -2250 ticks (102.0 ms), k=0.80
pm:0x8422  phA_ap2_len            ; M7 = -1500 ticks (68.0 ms), k=0.86
pm:0x8428  phA_ap3_len            ; M7 = -1400 ticks (63.5 ms), k=0.86
pm:0x8432  MicRev_phaseB          ; phase-B path
pm:0x844b  phB_ap1_len            ; M7 = -1235 ticks (56.0 ms), k=0.82
pm:0x8451  phB_ap2_len            ; M7 = -799 ticks (36.2 ms), k=0.70 -> ch1
pm:0x8456  phB_ap3_len            ; M7 = -920 ticks (41.7 ms), k=0.62 -> ch2
pm:0x845f  phB_return             ; RTS (DB)
dm:0xc004  mic_bq_a1              ; 0.5745 — same banks as rec58
dm:0xc013  mic_apA1_k             ; 0.80
dm:0xc014  mic_apA23_k            ; 0.86
dm:0xc015  mic_apB1_k             ; 0.82
dm:0xc016  mic_apB2_k             ; 0.70
dm:0xc017  mic_apB3_k             ; 0.62
