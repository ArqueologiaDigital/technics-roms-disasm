; rec40 — EFFECT: grp B distortion "Fat" (type 0x85, GUI bank 0x40 grp B).
; PM = rec39 except FOUR words: ch0 level 0.29->0.40 (@0x842e), Haas 400->200
; smp (@0x8430/0x8433), ch1 level 0.22->0.31 (@0x8457). DM bank: tone biquad =
; poles r=.868 @1744 Hz (SAME poles as rec38 "Fat") over zeros r=.797 @1241 Hz
; -> +3.8 dB mid bump @1.7 kHz, unity at the extremes. Same shared-bank rewind,
; curve B LUT, PM-state smoother, ch1 invert as rec39.
; Full doc dsp/dynamics-eq-exciter.md #6.4.
pm:0x8400  Rec40_AudioIn        ; L+R sum, LSHIFT 9
pm:0x8405  Rec40_EnvFollower    ; ABS + attack/release envelope (1/256 / 1/2048)
pm:0x840c  Rec40_RecipGain      ; RECIPS seed-only drive = 0.111+8.35e8/env clamp 4.0
pm:0x8415  Rec40_WaveshapeL     ; curve B LUT
pm:0x8420  Rec40_ToneSmootherL  ; y=k1*x+k2*y1, k=PM9801/2 (0.10/0.40)
pm:0x8427  Rec40_ToneBiquadL    ; unity-DC mid bump: poles r=.868 @1744 / zeros r=.797 @1241 Hz
pm:0x842e  Rec40_OutLevelL      ; R0=0x3ECCCCCD = 0.40 (preset immediate)
pm:0x8430  Rec40_DelayL         ; M7=0xC8(200) Haas 4.5 ms, ch0 (vs rec39's 400)
pm:0x8437  Rec40_OutLeft        ; DM(I4,M2)=R0
pm:0x8448  Rec40_ToneSmootherR  ; ch1 smoother (k=PM9805/6)
pm:0x844f  Rec40_BankRewind     ; MODIFY(I0,-8): ch1 reuses ch0's biquad bank
pm:0x8457  Rec40_OutLevelR      ; R0=0x3E9EB852 = 0.31 (preset immediate)
pm:0x845b  Rec40_InvertR        ; R0=-R0 phase invert
pm:0x845d  Rec40_OutRight       ; DM(I4,M2)=R0
pm:0x845e  Rec40_Return         ; RTS
dm:0xc006  Rec40_DriveBase      ; 0.111 (family AGC)
dm:0xc00e  Rec40_ToneBump       ; (a1,a2,b1,g,b2)=1.683/-0.754/-1.683/1.072/0.681: +3.8 dB @1.7 kHz
dm:0xc028  TransferLUT_start    ; curve B (= rec18/rec39 template)
dm:0xc038  TransferLUT_zero     ; curve center
