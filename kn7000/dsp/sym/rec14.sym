; rec14 — EFFECT: 4-tap comb/allpass reverb (denser variant of rec13), C000:40e family
pm:0x8400  Entry_SetInPtr        ; I0=I1
pm:0x8401  LoadFeedbackState     ; R10=DM(-1,I1)
pm:0x8402  Allpass_ReadTap_Coeff ; R7=DM(I0,M2), R3=PM(I8,M14) rotate allpass coeff
pm:0x8403  Allpass_InterpMAC     ; F12=F3*F7 / F3=F10+F12 / F7=F3*F7, PM(I8,M8)=R3
pm:0x8407  LoadInputLR_Avg       ; R3=DM(0x20),R8=DM(0x21); (R3+R8)/2 mono sum, R15=I6 base
pm:0x840d  Tap0_Len_5997         ; M7=0x176D, DM(I6,M7)=R0 ; R4=read
pm:0x8411  Tap1_Len_11995        ; M7=0x2EDB advance+read second tap -> R5
pm:0x8415  Tap2_Len_17992        ; M7=0x4648 -> R6
pm:0x8419  Tap3_Len_24006        ; M7=0x5DB6 -> R7 (four equally-spaced comb taps)
pm:0x841d  FIR4_Combine          ; F12=F3*F4 / F11=F3*F5 / F3*F6 / F3*F7 sum = 4-tap FIR
pm:0x8422  StoreState0           ; DM(-1,I1)=R0
pm:0x8432  OutputWriteL          ; DM(I4,M2)=R0 clipped
pm:0x843f  OutputWriteR          ; DM(I4,M2)=R0
pm:0x8440  CrossMixTaps          ; R3=PM(I8,M8): F8=F3*F7,F12=F2*F7, DM(I0,M6)=R12
pm:0x8445  Return                ; RTS(DB)
dm:0x9801  ParamSmooth_a         ; 0.004
dm:0x9802  ParamSmooth_1ma       ; 0.996
dm:0xc004  CombCoeff0            ; 0.749
dm:0xc00d  FIRtap_lo             ; 0.30 FIR tap gain
dm:0xc00e  FIRtap_mid            ; 0.60
dm:0xc00f  FIRtap_hi             ; 0.90
dm:0xc010  UnityFixed            ; 0x7FFFFFFF center tap
