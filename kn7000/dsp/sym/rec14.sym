; rec14 — EFFECT: PANNING MULTI-TAP ECHO (type 0x0A) — corrected from "4-tap comb reverb"
; Full doc dsp/insert-effects-algorithms.md #5. Mono sum into ONE line, four taps at
; 5997/11995/17992/23990 smp = 136/272/408/544 ms (equal ~136 ms spacing). The output
; banks PAN the repeats across the field: first-written channel gains ASCEND
; (c00c-c00f = 0, 0.30, 0.60, 0.90), second DESCEND (c011-c014 = 0.90, 0.60, 0.30, 0)
; — each repeat walks from one side to the other. Regeneration = taps * 0.25 each
; (c008-c00b) through a unity-DC damp (c004-c006, 0.71 @ Nyquist) at gain c007
; (template 0 = regen off until the host writes the feedback param). Master level
; c015 (1.0) via smoother state c016 (coeffs 0x9801/2) — fade-in like rec13.
pm:0x8400  Entry_SetInPtr        ; I0=I1
pm:0x8401  LoadFeedback          ; R10=DM(-1,I1) = c003 = prev regen mix
pm:0x8402  Damp_Coeff            ; R7=c004(0.749), R3=PM(0x9800) damp state
pm:0x8403  Damp_Filter           ; u = fb + 0.749*u1; y = 0.7446*u - 0.4937*u1 (unity DC)
pm:0x8407  LoadInputLR_Avg       ; (L+R)/2 mono sum, R15=I6 base
pm:0x840d  Tap0_Len_5997         ; write line; tap @ +5997 = 136 ms -> R4
pm:0x8411  Tap1_Len_11995        ; tap @ +11995 = 272 ms -> R5
pm:0x8415  Tap2_Len_17992        ; tap @ +17992 = 408 ms -> R6
pm:0x8419  Tap3_Len_23990        ; tap @ +23990 = 544 ms -> R7 (0x5DB6; four equal spacings)
pm:0x841d  RegenMix              ; 0.25*(t0+t1+t2+t3) (c008-c00b)
pm:0x8422  StoreRegen            ; DM(-1,I1)=R0 -> c003 (next frame's feedback source)
pm:0x8423  PanMixA               ; out A = 0*t0 + 0.30*t1 + 0.60*t2 + 0.90*t3 (c00c-c00f)
pm:0x8432  OutputWriteL          ; * level(c016) * wet(c010) * 2, CLIP, DM(I4,M2)
pm:0x8433  PanMixB               ; out B = 0.90*t0 + 0.60*t1 + 0.30*t2 + 0*t3 (c011-c014)
pm:0x843f  OutputWriteR          ; DM(I4,M2)
pm:0x8440  LevelSmoother         ; c016 = 0.004*c015 + 0.996*c016
pm:0x8445  Return                ; RTS(DB)
dm:0x9801  ParamSmooth_a         ; 0.004
dm:0x9802  ParamSmooth_1ma       ; 0.996
dm:0xc004  DampPole              ; 0.749
dm:0xc005  DampB1                ; -0.4937 (0xBEFCC3B3)
dm:0xc006  DampB0                ; 0.7446 (0x3F3E9D18) — unity DC, 0.71 @ Nyquist
dm:0xc007  RegenGain             ; 0 template — host-written feedback amount
dm:0xc008  RegenTap0             ; 0.25 (x4, c008-c00b)
dm:0xc00c  PanA_Tap0             ; 0 — ascending bank: repeats fade IN on this side
dm:0xc00d  PanA_Tap1             ; 0.30
dm:0xc00e  PanA_Tap2             ; 0.60
dm:0xc00f  PanA_Tap3             ; 0.90
dm:0xc010  UnityFixed            ; 0x7FFFFFFF wet
dm:0xc011  PanB_Tap0             ; 0.90 — descending bank: repeats fade OUT on this side
dm:0xc012  PanB_Tap1             ; 0.60
dm:0xc013  PanB_Tap2             ; 0.30
dm:0xc014  PanB_Tap3             ; 0
dm:0xc015  LevelTarget           ; 1.0 — host-written master level
dm:0xc016  LevelSmoothed         ; smoothed level state (fade-in)
