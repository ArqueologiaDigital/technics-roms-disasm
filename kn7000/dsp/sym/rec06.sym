; rec06 — EFFECT: quadrature 2-tap modulated-delay chorus/ensemble (wet-only)
; Full dataflow trace 2026-07-19; full algorithm doc dsp/chorus-family-algorithms.md §2
; (see also dsp/reverb-algorithm.md §6).
; One sine LFO (table-interpolated); each channel reads TWO fractional taps of
; its delay line, modulated by sine(phase) and sine(phase+90deg), averaged and
; summed.  The right channel uses the NEGATED modulators (antiphase stereo).
; No feedback and no dry mix -> pure doubling/ensemble wet.  Delay line is the
; kernel's INTERNAL DM ring via I2 (B2=0xC3A0, L2=0x1C60, scrolled -1/frame by
; the mainloop delay-slot MODIFYs): write L @P, reads @P+250+-64; write R
; @P+490, reads @P+740-+64 -> both channels 250-sample (5.7ms) centers.
; NOTE this record sits in the unit-9 "Reverb" whitelist (types 0x01,0x2C) but
; has no tail-capable structure — it cannot be the audible GUI reverb.
;
dm:0x9800  eff06_lfo_incr       ; 0x00800000 LFO phase increment (template = fs/256 under the 2^31 FDEP wrap; audio-rate — host likely rewrites per preset, rate reading PROVISIONAL)
dm:0xc004  eff06_lfo_phase      ; LFO phase accumulator (runtime state kept in the param block, template 0)
dm:0xc005  eff06_depth          ; 0x00400000 mod depth: tap swing = +-64 samples about the 250-sample center
dm:0xc006  eff06_wet            ; 0x7FFFFFFF wet level (applied to the (v1+v2)/2 average, then x2 makeup)
dm:0xc029  eff06_sine_tab       ; 16-point sine cycle c029..c038 (c030 = index-0 zero; stored angle-negated, output = -sin) + positive-half guard c039..c03f for wrap-free interp/quadrature reads; occupies the host-swappable waveform slot c028..c040 (data records rec77/78/79 = sine/tri/square overwrite it live)
dm:0xc02c  eff06_sine_peak      ; +1.0 (0x7FFFFFFF)
dm:0xc034  eff06_sine_trough    ; -1.0 (0x80000000)
pm:0x8400  eff06_entry          ; I0 = I1: LFO phase accumulator lives at param c004
pm:0x8401  eff06_read_inL       ; R0 = DM(I4+0x20) input L
pm:0x8402  eff06_read_inR       ; R11 = DM(I4+0x21) input R
pm:0x8403  eff06_lfo_acc        ; phase(c004) += incr(state 0x9800); FDEP 0:31 SE wraps mod 2^31
pm:0x8406  eff06_lfo_store      ; DM(I0,M2) = phase; I5 = I1
pm:0x8408  eff06_lfo_index      ; ASHIFT -11 then -16: table index = phase>>27 (16 steps/cycle); MODIFY(I5,0x2C) -> I5 = c030 table center
pm:0x840c  eff06_sine_interp    ; linear interp: frac = FDEP 15:16; R8 = s[i]*(1-f) + s[i+1]*f
pm:0x8410  eff06_lfo_A          ; R5 = sine(phase) = modulator A
pm:0x8412  eff06_quad_offset    ; MODIFY(I5,4) = +90deg table offset
pm:0x8413  eff06_lfo_B          ; R6 = sine(phase+90deg) = quadrature modulator B
pm:0x8418  eff06_save_i2        ; R15 = I2 delay cursor (internal DM ring B2=0xC3A0 L2=0x1C60)
pm:0x841a  eff06_wr_delayL      ; DM(I2,M7)=R0 write in_L @P; M7=0xFA -> read base P+250 (5.7ms center)
pm:0x841b  eff06_depth_ld       ; R10 = c005 depth (tap offset = modulator*depth -> +-64 samples)
pm:0x841c  eff06_tap1L          ; L voice 1: fractional read @P+250+64*B (int part via M7, frac FDEP 15:16, linear interp d[i]+f*(d[i+1]-d[i]))
pm:0x8424  eff06_tap2L          ; L voice 2 @P+250+64*A; R9 = voice 1
pm:0x842e  eff06_baseR          ; MODIFY(I2,0xF0): I2 = P+250+240 = P+490, the R-channel write base
pm:0x842f  eff06_mix_L          ; R8 = (v1+v2)/2, x wet(c006), x2 makeup
pm:0x8433  eff06_clip_L         ; CLIP +-0x7FFFFF
pm:0x8434  eff06_out_L          ; DM(I4,M2)=R8 output slot; I4+1
pm:0x8436  eff06_wr_delayR      ; (MODIFY(I2,0xF0) @842e set I2=P+490) DM(I2,M7)=R11 write in_R; read base P+740
pm:0x8438  eff06_tap1R          ; R voice 1 @P+740-64*B (negated modulator = antiphase vs L)
pm:0x8441  eff06_tap2R          ; R voice 2 @P+740-64*A
pm:0x8449  eff06_mix_R          ; (v1+v2)/2, x wet, x2
pm:0x844d  eff06_clip_R         ; CLIP +-0x7FFFFF
pm:0x844e  eff06_out_R          ; DM(I4,M2)=R8; I4 += 2 total
pm:0x844f  eff06_rts            ; RTS(DB); epilogue advances I1 +0x4D, I8 +0x4F (+1 incr read = 0x50)
