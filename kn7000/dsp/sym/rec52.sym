; rec52 — EFFECT: float comb+allpass REVERB (variant of rec51 family)
; Same PM algorithm as rec51 (see rec51.sym). Differences = preset:
;   early delay lengths shorter/altered, and input/damping biquad coeffs changed.
; Delays: 8406=0xFFFFF811 8410=0xFFFFF62F 841a=0xFFFFF798 841d=0xFFFFFE40.
;
dm:0x9808  rev_damp0             ; 0x3DD0E560 damping coeff (this preset)
dm:0x980a  rev_damp1             ; 0x3E0F5C28 damping coeff (this preset)
dm:0xc004  rev_biquad_inL        ; 0x3FCC985F b0 input tone biquad L
dm:0xc009  rev_biquad_inR        ; 0x3FCC985F b0 input tone biquad R
dm:0xc014  rev_diffuser_gain     ; 0x3F4C8B43 diffuser/allpass gain (this preset)
dm:0xc024  rev_mix_wet_neg       ; wet mix (inverting)
dm:0xc026  rev_out_scale         ; output scale
pm:0x8400  rev_entry             ; effect entry (see rec51.sym for full trace)
pm:0x8403  rev_delaybase         ; MODIFY(I6,0x00010747) delay-buffer base
pm:0x8406  rev_delaylen0         ; M7=0xFFFFF811 early delay len 0 (VARIANT)
pm:0x8410  rev_delaylen1         ; M7=0xFFFFF62F early delay len 1 (VARIANT)
pm:0x841a  rev_delaylen2         ; M7=0xFFFFF798 early delay len 2 (VARIANT)
pm:0x841d  rev_delaylen3         ; M7=0xFFFFFE40 early delay len 3 (VARIANT)
pm:0x841f  rev_allpass          ; float allpass core
pm:0x8425  rev_diffuse_chain     ; allpass/comb diffuser loop
pm:0x8468  rev_out_L             ; left output write
pm:0x846d  rev_out_R             ; right output write
pm:0x846f  rev_rts               ; RTS(DB)
