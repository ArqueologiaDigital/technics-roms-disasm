; rec66 — EFFECT: VOCAL HARMONIZER (GUI mic effect "Vocal Harmonizer",
; type 0x7C — name = ROM fact via the preset-descriptor table). The pool's
; biggest insert (141 PM words). Mono-in mono-out 3-voice granular
; (reflected-tap) pitch shifter: input <<10 -> pre biquad -> rectify +
; envelope smoother -> RECIPS auto-gain (1/env vocal levelling) -> level
; GATE (below threshold: zero + skip 6 coeffs) -> peak-hold tracker that
; PUBLISHES a word to IOP reg 0x0C (DM(0x0C)=R2 @0x843C — the only effect
; in the pool that reports back to the host; pitch/level telemetry,
; interpretation PROVISIONAL, write is fact) -> three resampling taps with
; phase-reflect (IF GE Rn=-Rn ping-pong grains) and 16.16 fractional lerp
; -> average -> 2 post biquads -> gain, CLIP, same sample to L and R.
; Template voice slopes c021/c023/c025 = -0.8747/-0.5000/-0.2498
; samples/sample -> ratios 1.8747/1.5000/1.2498 = +1088.0/+702.0/+386.0
; cents EXACTLY = integer-cent just major 7th / perfect 5th / major 3rd
; (15/8, 3/2, 5/4): the template harmony is a just maj7 chord; the host
; computes slopes from cents per harmony setting.
; Full doc dsp/tremolo-rotary-family.md §5.
pm:0x8400  Entry                   ; I0 = I1 (coeff base)
pm:0x8401  ReadInput               ; R0 = DM(0x20,I4), ASHIFT <<10 (mic path headroom)
pm:0x8403  PreBiquad               ; input biquad c005-c007, state DM(-4,I0)
pm:0x8408  AbsLevel                ; R9 = ABS R0 (rectify)
pm:0x840b  EnvSmoothMac            ; envelope smoother MAC
pm:0x840f  RecipGain               ; F9 = RECIPS(env) — auto-gain 1/level
pm:0x8414  CondPoly                ; x^2/x^3 terms (conditioning polynomial; exact role open)
pm:0x8424  PeakGateStart           ; level compare section
pm:0x8426  GateCompare             ; below threshold: zero, skip 6 coeffs, bypass
pm:0x842b  PeakTrack               ; running peak compare/hold
pm:0x8432  PeakStateStore          ; DM(-3,I1)/DM(-2,I1) peak-hold state
pm:0x843c  HostTelemetry           ; DM(0x0C) = R2 — IOP register write, host-visible
pm:0x843e  TapSpan                 ; M7 = 0x1FE delay span
pm:0x8441  Voice0_Advance          ; phase += slope (c021 -> ratio 1.8747 = +1088.0 cents)
pm:0x8446  Voice0_Reflect          ; IF GE R8 = -R8 — ping-pong grain read
pm:0x8447  Voice0_Wrap             ; FDEP 0:31, state DM(-3,I0)
pm:0x8449  DelayWrite              ; ASHIFT -5; DM(I2,M7) = in -> grain ring
pm:0x844f  Voice1_Wrap             ; voice 1 (c023 -> 1.5000 = +702.0 cents, just fifth)
pm:0x8457  Voice2_Wrap             ; voice 2 (c025 -> 1.2498 = +386.0 cents, just third)
pm:0x8462  InterpAccum             ; per-voice gain accumulate (c029/c02b/c02d)
pm:0x8463  Voice0_TapInt           ; int part -> M7
pm:0x8466  Voice0_TapLerp          ; 16.16 fractional lerp
pm:0x847a  VoiceAverage            ; R8 = (v0+v1+v2 avg) — grain crossfade sum
pm:0x847b  PostBiquad1             ; c031-c033
pm:0x8480  PostBiquad2             ; c034-c036
pm:0x8484  FixAndGain              ; FIX; * c037 out gain
pm:0x8489  AdvPMState              ; MODIFY(I8,0x50)
pm:0x848a  OutClip                 ; RTS(DB); CLIP by c038
pm:0x848b  WriteOutL               ; DM(I4,M2) = out
pm:0x848c  WriteOutR               ; same sample — mono to both channels
dm:0xc005  PreFilt_b0              ; 0.9928 input filter coeff
dm:0xc00e  Const40                 ; 40.0
dm:0xc012  Mix_0p7                 ; 0.7
dm:0xc014  Const5e6                ; 5000000.0 (envelope scale)
dm:0xc016  Smooth_0p05             ; 0.05 envelope smoothing
dm:0xc021  Voice0_Slope            ; -1834398 = -0.8747 smp/smp -> +1088.0 cents (just M7)
dm:0xc023  Voice1_Slope            ; -1048658 = -0.5000 -> +702.0 cents (just P5)
dm:0xc025  Voice2_Slope            ; -523813 = -0.2498 -> +386.0 cents (just M3)
dm:0xc029  Voice0_Gain             ; 1.0 template
dm:0xc02b  Voice1_Gain             ; 1.0
dm:0xc02d  Voice2_Gain             ; 1.0
dm:0xc031  PostFilt1_b0            ; post biquad 1
dm:0xc034  PostFilt2_b0            ; post biquad 2
dm:0xc037  OutGain                 ; ~1.0
dm:0xc038  ClipLimit               ; 0x007FFFFF
