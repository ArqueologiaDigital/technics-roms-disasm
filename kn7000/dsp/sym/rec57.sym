; rec57 — EFFECT: dual-tap crossfaded fixed-point PITCH-SHIFTER / detune
;         (modulated fractional delay), stereo. Structurally distinct from the
;         rec51-56 reverb family.
;
; Two sawtooth phase accumulators (DM 9800=0x00010000, 9801=0xFFFF0000, i.e.
; ~180deg apart) are advanced each sample by an increment fetched from the PM
; coeff stream (R7=PM(I8,M8)) at 8401/8406, wrapped with FDEP 0:31 and stored
; back. Their absolute values R6/R13 (ABS of a sawtooth = triangular window) are
; the crossfade weights. Input DM(0x20,I4) is doubled and pushed into the DM
; delay line DM(I2,M7) with M7=0x000000FA (write @ +250). For each of the two
; phases: phase*depth (R10=DM(I0,M2)) gives a modulated read index; the integer
; part (ASHIFT -16) modifies the delay pointer, the fractional part (FDEP 15:16)
; drives a linear interpolation R3/R8 = tap + frac*(next-tap) between adjacent
; delay samples (MAC MRF+(R8*R7)). The two interpolated taps are crossfaded by
; the triangular windows (MRF=R3*R13; R8=MRF+(R8*R6)) — the classic overlap-add
; time-domain pitch shifter. Output *= gain (R14=DM(I0,M2)), doubled, CLIP to
; 0x007FFFFF, written DM(I4,M2). Right channel (8436 input @0x1F) repeats.
; A 16pt sine table sits at c029..c03f but is NOT referenced by this PM (shared
; DM / leftover); the LFO here is the ABS-of-sawtooth triangle, not the sine.
;
dm:0x9800  ps_phase0             ; 0x00010000 pitch phase accumulator, tap A
dm:0x9801  ps_phase1             ; 0xFFFF0000 pitch phase accumulator, tap B (anti-phase)
dm:0xc005  ps_depthA_or_scale    ; 0x40000000 window/mix scale
dm:0xc006  ps_depth              ; 0x00F00000 delay-sweep depth (index scale)
dm:0xc007  ps_clip               ; 0x7FFFFFFF fixed clip limit
dm:0xc009  ps_scaleR             ; 0x40000000 right-channel scale
dm:0xc00a  ps_depthR             ; 0x00F00000 right-channel sweep depth
dm:0xc029  ps_sine_tab           ; 16pt sine table c029..c03f (unused by this PM)
pm:0x8400  ps_entry              ; I0=I1 effect entry
pm:0x8401  ps_phaseA_acc         ; R8=DM(I0,M6)+PM(I8,M8) phase-A accumulate
pm:0x8403  ps_phaseA_wrap        ; FDEP R8 0:31; store; R6=ABS (triangle window A)
pm:0x8406  ps_phaseB_acc         ; R5 phase-B accumulate + wrap; R13=ABS (window B)
pm:0x840b  ps_save_i2            ; R15=I2 save delay pointer
pm:0x840c  ps_read_inL           ; R0=DM(0x20,I4) input L; R0=R0+R0 (x2)
pm:0x840e  ps_write_delay        ; M7=0xFA; DM(I2,M7)=R0 push into delay line
pm:0x8411  ps_indexA             ; R8=R8*R10 phase*depth (tap A read index)
pm:0x8412  ps_intfracA           ; ASHIFT -16 int part; FDEP 15:16 frac part
pm:0x8415  ps_interpA            ; linear interp: R3=tap+frac*(next-tap)
pm:0x841a  ps_indexB             ; R8=R5*R10 tap-B read index
pm:0x8421  ps_interpB            ; interp tap B → R8
pm:0x8424  ps_crossfade          ; MRF=R3*R13; R8=MRF+(R8*R6) triangular crossfade
pm:0x8427  ps_outscaleL          ; R8*=R14 gain; R8+R8; CLIP 0x7FFFFF
pm:0x842b  ps_out_L              ; DM(I4,M2)=R8 left output
pm:0x842c  ps_chanR              ; right channel begins (input @0x1F @8436)
pm:0x8452  ps_out_R              ; DM(I4,M2)=R8 right output
pm:0x8453  ps_restore_i2         ; I2=R15 restore delay pointer
pm:0x8454  ps_rts                ; RTS(DB)
