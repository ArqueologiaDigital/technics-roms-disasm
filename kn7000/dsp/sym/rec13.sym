; rec13 — EFFECT: delay-line comb/allpass reverb (2-comb stereo), C000:40e family
pm:0x8400  Entry_SetInPtr        ; I0=I1 (input/delay ptr), R15=I6 saves delay-line base
pm:0x8402  LoadFeedbackState     ; R10 = DM(-1,I1) prev comb feedback/damping state
pm:0x8403  Comb1_ReadTap_Coeff   ; R7=DM(I0,M2) delayed sample, R3=PM(I8,M14) rotate allpass coeff
pm:0x8404  Comb1_AllpassMAC      ; F12=F3*F7 / F3=F10+F12 / F7=F3*F7, PM(I8,M8)=R3 store coeff state
pm:0x8408  LoadInputL            ; R3=DM(0x20,I4) input sample, F3=FLOAT
pm:0x840b  MixInputPlusFeedback  ; F0=F3+F7 input+damped feedback, R14=DM gain
pm:0x840c  Comb1_TapLen_8000     ; M7=0x1F40 (8000) delay tap length
pm:0x840d  Comb1_WriteDelay      ; DM(I6,M7)=R0 write into delay line
pm:0x840e  Comb1_ReadDelay       ; R8=DM(I6,M6)
pm:0x8411  AdvanceDelayBase      ; MODIFY(I6,M7=0x3C64) advance circular delay base
pm:0x8412  StoreFeedbackState    ; DM(-1,I1)=R8
pm:0x841a  OutputWriteL          ; DM(I4,M2)=R8 (clipped) output
pm:0x8429  Comb2_TapLen_10000    ; M7=0x2710 (10000) second comb tap
pm:0x842a  Comb2_WriteDelay      ; DM(I6,M7)=R0
pm:0x8436  OutputWriteR          ; DM(I4,M2)=R8 second output
pm:0x8437  CrossMixTaps          ; R7=DM,R3=PM(I8,M8): F8=F3*F7,F12=F2*F7 mix, DM(I0,M6)=R12
pm:0x843c  Return                ; RTS(DB)
dm:0x9802  ParamSmooth_a         ; 0.004 one-pole param-smoothing coeff
dm:0x9803  ParamSmooth_1ma       ; 0.996 (1-a)
dm:0xc004  CombCoeff0            ; 0.749 comb/allpass gain
dm:0xc005  CombCoeff1            ; -0.313
dm:0xc006  CombCoeff2            ; 0.564
dm:0xc008  UnityFixed            ; 0x7FFFFFFF
