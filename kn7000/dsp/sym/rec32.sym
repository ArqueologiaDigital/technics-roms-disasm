; rec32 — EFFECT: GUI MIXUP1-4 (type 0x38) — burst vibrato
; Three sine LFOs: LFO1 slow (templ 1.346 Hz) + LFO2/LFO3 a FAST QUADRATURE
; PAIR (templ 21.5 Hz, phase3 = +90 deg via c006=0x20000000). The tap
; modulators are Q31 PRODUCTS:
;   modR = sin(slow)*sin(fast)      modL = sin(slow)*sin(fast+90)
; = a beating pair (20.2/22.9 Hz) whose envelope |sin(slow)| swells and nulls
; 2.7x/s: bursts of deep fast vibrato (up to +-3.1 semitones at template
; peaks), L/R 90 deg apart -> the wobble swirls across the image. MONO source
; (both channels read in_L). Float delay line, taps 250+-64, wet x2.
; Full doc: dsp/modulation-pitch-family.md #5.
dm:0x9800  mix_lfo1_incr        ; 0x00010000 = 1.346 Hz — the SLOW gate LFO
dm:0x9801  mix_lfo2_incr        ; 0x00100000 = 21.5 Hz — fast pair, 0 deg
dm:0x9802  mix_lfo3_incr        ; 0x00100000 = 21.5 Hz — fast pair, +90 deg
dm:0xc004  mix_phase1           ; slow phase (templ 0)
dm:0xc005  mix_phase2           ; fast phase A (templ 0)
dm:0xc006  mix_phase3           ; fast phase B (templ 0x20000000 = +90 deg)
dm:0xc007  mix_depth            ; 0x00400000 = +-64 smp tap depth
dm:0xc008  mix_fexp_L           ; 0xFFFFFFE1 = -31: FLOAT R3 BY -31 fraction scale (L)
dm:0xc009  mix_wet              ; 0x7FFFFFFF wet (shared)
dm:0xc00a  mix_fexp_R           ; -31 fraction scale (R)
pm:0x8400  mix_entry            ; I0=I1
pm:0x8401  mix_lfo1             ; slow sine -> R9
pm:0x8410  mix_lfo2             ; fast sine A
pm:0x841e  mix_modR             ; R5 = sin(slow)*sin(fastA) — right modulator (product!)
pm:0x841f  mix_lfo3             ; fast sine B (+90)
pm:0x842d  mix_modL             ; R8 = sin(slow)*sin(fastB) — left modulator; R15=I2 save
pm:0x842e  mix_read_inL         ; R0 = DM(0x20,I4); FLOAT (float delay line)
pm:0x8431  mix_write_L          ; write at P, advance 250
pm:0x8433  mix_offset_L         ; R8 = modL * depth; R1 = read base
pm:0x8434  mix_tap_L            ; fractional float lerp
pm:0x843d  mix_advance_R        ; MODIFY(I2,0xFA) -> R write base P+500
pm:0x843e  mix_wet_L            ; FIX, x wet, x2
pm:0x8443  mix_out_L            ; DM(I4,M2) = out L
pm:0x8444  mix_read_inL2        ; DM(0x20,I4) AGAIN — mono source
pm:0x8448  mix_offset_R         ; R8 = modR * depth
pm:0x8449  mix_tap_R            ; fractional float lerp about P+750
pm:0x8451  mix_restore          ; I2 = R15 (entry base)
pm:0x8456  mix_out_R            ; DM(I4,M2) = out R
pm:0x8457  mix_rts              ; RTS (delayed)
pm:0x8459  mix_state_rewind     ; MODIFY(I8,0x4D) — 3 state reads
