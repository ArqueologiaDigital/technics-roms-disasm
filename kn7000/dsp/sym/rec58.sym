; rec58 — MIC REVERB "Room" (unit-7, type 0x58) — the pool's THIRD reverb
; architecture: a HALF-RATE series-allpass (Schroeder) reverberator.
; FLAG3 = fs/2 frame-parity strobe: the kernel scrolls the exclusive I3 SDRAM
; ring (B3=0x656F0, L3=18000 w) only on FLAG3-high frames (u7 call delay slot
; 0x8098), and this program splits its tank across the two phases — phase A
; (FLAG3 high): 3 series allpasses 1650/1100/1000 ticks, k=.8/.86/.86;
; phase B (low): AP 935 (k=.82) then a parallel terminal pair 549 (k=.70) /
; 720 (k=.62). 1 tick = 2 samples -> Room tank = 270 ms of AP delay, RT60
; ~2.3 s. Audio-rate biquads (3 identical unity-DC LP banks, poles r=.61
; @7.6 kHz, double zero at Nyquist) bracket the half-rate core: bq3 =
; decimation filter on the input (state advanced EVERY frame — phase B
; computes it and discards the result to keep the state correct), bq1/bq2 =
; interpolation smoothers on the two half-rate tank outputs. Cross-phase
; hand-off through param scratch: c000 = A-chain out -> B-chain in,
; c002/c001 = B outs (after 549/720 AP) -> bq1/bq2 -> out ch1/ch2 (stereo
; decorrelation by different terminal APs, cf rec12's out-of-loop AP4).
; I3 cursor is saved in MSGR2 (DM 0x0A — the one message register kernel
; boot-init does NOT zero) by phase A and restored by phase B.
; Mono in_L, wet-only. Uses NO I6 and NO I2 -> resolves the kernel's
; {u6,u7} shared-window concern (u7 mic reverbs live in I3 alone).
; Full doc: dsp/final-batch-algorithms.md §1.
pm:0x8400  MicRev_phaseSel        ; IF NOT FLAG3, JUMP phase-B (DB: input read + I0=I1 run on BOTH paths)
pm:0x8402  MicRev_floatInput      ; F8 = FLOAT(in_L), I0 = I1 (coeff stream from c004)
pm:0x8403  phA_saveCursor         ; MSGR2 (DM 0x0A) = I3 — phase-B restores it
pm:0x8404  phA_bq1_in             ; R10 = c002 = phase-B AP549 out -> F10 = bq1 input
pm:0x8405  phA_bq1                ; unity-DC LP biquad 1 (c004-c008, state PM 9800/1) — out-ch1 smoother
pm:0x840c  phA_fix1               ; R0 = FIX(bq1 out); R14 = c003 (tank input gain)
pm:0x8410  phA_out1               ; DM(I4,M2) = CLIP(bq1(c002)) — output word 1
pm:0x8411  phA_bq2_in             ; R10 = c001 = phase-B AP720 out -> bq2 input
pm:0x8419  phA_out2               ; DM(I4,M2) = CLIP(bq2(c001)) — output word 2
pm:0x841a  phA_bq3_input          ; F10 = F8 + ... : bq3 = decimation LP on THIS frame's input
pm:0x841d  phA_ap1_len            ; M7 = -1650 ticks (74.8 ms) — AP_a1 delay (PRESET immediate)
pm:0x841f  phA_ap1_read           ; R3 = DM(I3,M7): AP_a1 tap; F10 = bq3 out
pm:0x8420  phA_tankInGain         ; F10 = bq3out * float(c003) (template ~1.0)
pm:0x8421  phA_ap1_k              ; F7 = c013 = 0.8; R6 = c014 = 0.86 (k for a2 AND a3)
pm:0x8422  phA_ap2_len            ; M7 = -1100 ticks (49.9 ms)
pm:0x8424  phA_ap1_write          ; DM(I3,M3) = w1 (w = x - k*d; y = d + k*w form)
pm:0x8428  phA_ap3_len            ; M7 = -1000 ticks (45.4 ms)
pm:0x842b  phA_stateAdv           ; MODIFY(I8, 0x4A): 6 shared biquad state words + stride
pm:0x842f  phA_return             ; RTS (DB); c000 <- AP_a3 out (hand-off to phase B)
pm:0x8432  MicRev_phaseB          ; FLAG3-low path: same bq1/bq2/bq3 (SAME states/coeffs)
pm:0x8447  phB_bq3_dead           ; bq3 runs for its STATE only — phase B discards its output
pm:0x844b  phB_ap1_len            ; M7 = -935 ticks (42.4 ms); input = c000 = phase-A chain out
pm:0x844f  phB_ap1_k              ; F7 = c015 = 0.82; R6 = c016 = 0.70
pm:0x8451  phB_ap2_len            ; M7 = -549 ticks (24.9 ms); k = 0.70
pm:0x8455  phB_ap3_k              ; R7 = c017 = 0.62 (AP_b3)
pm:0x8456  phB_ap3_len            ; M7 = -720 ticks (32.7 ms); input = AP_b1 out (parallel pair)
pm:0x8459  phB_saveOut1           ; c002 <- AP_b2 out (F11) — next frames' bq1 input
pm:0x845e  phB_restoreCursor      ; I3 = MSGR2 — undo the walk; net ring motion = kernel scroll only
pm:0x845f  phB_return             ; RTS (DB); c001 <- AP_b3 out — next frames' bq2 input
dm:0xc000  mic_xA_out             ; phase-A chain out -> phase-B chain in (float bits)
dm:0xc001  mic_xB_out2            ; phase-B AP720 out -> bq2 -> out ch2
dm:0xc002  mic_xB_out1            ; phase-B AP549 out -> bq1 -> out ch1
dm:0xc003  mic_tank_gain          ; 0x7FFFFFFF ~ 1.0 — tank input gain (FLOAT BY -31)
dm:0xc004  mic_bq_a1              ; 0.5745  unity-DC LP: H=0.2002(1+z^-1)^2/(1-.5745z^-1+.3752z^-2)
dm:0xc005  mic_bq_a2              ; -0.3752 (poles r=.6125 @7.6 kHz; -6.5 dB @11 k; double zero @Nyquist)
dm:0xc006  mic_bq_b1              ; 0.4004  — 3 identical banks: c004-8 (bq1) = c009-d (bq2) = c00e-12 (bq3)
dm:0xc007  mic_bq_b0              ; 0.2002  (order a1,a2,b1,b0,b2 — the rec51 DF2 idiom)
dm:0xc008  mic_bq_b2              ; 0.2002
dm:0xc013  mic_apA1_k             ; 0.80 — phase-A AP 1650 t (RT60 contribution 2.32 s)
dm:0xc014  mic_apA23_k            ; 0.86 — phase-A APs 1100/1000 t (2.29/2.08 s)
dm:0xc015  mic_apB1_k             ; 0.82 — phase-B AP 935 t (1.48 s)
dm:0xc016  mic_apB2_k             ; 0.70 — phase-B AP 549 t -> out ch1
dm:0xc017  mic_apB3_k             ; 0.62 — phase-B AP 720 t -> out ch2
