; rec67 [EFFECT] — sine-polynomial waveshaper + variable-delay (most complex of F67-69 core)
; I4=I/O frame (0x20/0x21 in, DM(I4,M2) out); I0/I1=coeff/state walk; I2=modulated delay; I8=PM coeff table
pm:0x8400  Entry_I0eqI1          ; entry: alias state ptr I0=I1
pm:0x8401  ReadInput             ; R0 = DM(0x20,I4) input sample
pm:0x8402  InScale               ; ASHIFT R0 BY 8 (fixed-point align)
pm:0x8403  ToFloat_LoadCoef      ; F10=FLOAT R0; walk DM/PM coeff tables
pm:0x8409  RangeReduce_Abs       ; R9=ABS; R3=R9-R7(thresh); piecewise via MRF+(R3*R4)
pm:0x840e  Recip_Divide          ; F9=RECIPS; F9=F4*F9 -> reciprocal/phase scale
pm:0x8411  PhaseAdd              ; F15 = F3 + F9 (reduced phase)
pm:0x8422  ClampCompare          ; COMP(F10,F2)/COMP(F11,F2) branch guards
pm:0x842d  DelaySetup_M7         ; M7=0x1FE(510); R8=DM(I0,M6) delay-tap base
pm:0x8430  DelayWrite            ; DM(I2,M7)=R0 write into modulated delay line
pm:0x8438  VarDelayModify        ; M7=R7; MODIFY(I2,M7) variable read pointer
pm:0x843a  FracInterp_MAC        ; MR1F=R7; R7=R4-R7; R8=MRF+(R8*R7) linear interp
pm:0x843e  PolySine_Begin        ; F10=FLOAT; cubic/poly sine approx (F12=F3*F7 chain)
pm:0x845a  CubicShape            ; F2=F10*F10; F2=F2*F10; F2=F2*F3; F10=F10-F2
pm:0x845f  ClampPos              ; R10=0x3F2AAAAB (+2/3) saturation const
pm:0x8461  ClampNeg              ; R10=0xBF2AAAAB (-2/3) saturation const
pm:0x8463  FinalScale            ; F10=F2*F10; R8=FIX; R8=R8*R7; ASHIFT -9
pm:0x8467  OutputL               ; DM(I4,M2)=R8 (left)
pm:0x8468  OutputR               ; DM(I4,M2)=R8 (right)
pm:0x8469  Return                ; RTS (DB)
dm:0x9802  StateInit             ; 0xFFE0000000 seed
dm:0xc00c  Coef_4p0              ; 0x4080000000 = 4.0
dm:0xc010  Coef_0p5              ; 0x3F000000.. = 0.5
dm:0xc01c  Coef_0p7              ; 0x3F333333.. = 0.7
dm:0xc021  Coef_1p0             ; 0x3F800000.. = +1.0
dm:0xc022  Coef_neg1p0           ; 0xBF800000.. = -1.0
dm:0xc023  Coef_third            ; 0x3EAAAAA9.. = 1/3
dm:0xc025  Coef_max              ; 0x7FFFFFFF.. fullscale clamp
