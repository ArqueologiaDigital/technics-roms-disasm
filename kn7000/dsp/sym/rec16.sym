; rec16 — EFFECT: dual modulated-delay chorus/ensemble with stereo sum/diff matrix, C000:77e family
pm:0x8400  Entry_LoadInput       ; R0=DM(0x20),R8=DM(0x21); (R0+R8)/2 mono sum; R3=DM(I1,M6)
pm:0x8403  Input_ToFloat         ; F0=FLOAT R0, I0=I1; F8=F0*F3 pre-gain
pm:0x8405  Index_FixShift        ; R8=FIX; <<9; ASHIFT-11; I5=I1+0x34 buffer base
pm:0x8409  LUT_IndexHi           ; R7=ASHIFT R8 BY -16 -> M7
pm:0x840b  LUT_Fetch_Interp      ; R3=FDEP 15:16; R7=DM(I5,M7); FLOAT R3 BY R4; F3*F8 interpolate (variable-tap read)
pm:0x8412  Tap2Mix               ; R7=DM,R3=PM(I8,M8): R6=R3*R7, R12=R2*R7, R12=R6+R12
pm:0x8416  Call_KernelDelay1     ; CALL 0x8300 kernel allpass/comb tap helper (DB)
pm:0x8418  Feed_Float            ; DM(I0,M2)=R12; F8=FLOAT R12
pm:0x8419  Call_KernelDelay2     ; CALL 0x830B kernel tap helper (DB)
pm:0x841a  Delay_Write_A         ; M7=0x140 (320) DM(I2,M7)=R10 modulated delay line A
pm:0x841d  ModTapRead_A          ; R8=R8*R9; ASHIFT-16; FDEP; DM(I2,M7) fractional modulated tap
pm:0x8425  ModTapRead_B          ; R8=R5*R9; second modulated tap
pm:0x842e  Delay_Write_B         ; MODIFY(I2,0xC8); M7=0xA0 DM(I2,M7)=R6 delay line B
pm:0x8438  StereoMatrix          ; F10=F0*F6/F0*F7, F9=F3*F4,F11=F3*F4: F12=sum, F13=diff (L/R rotate)
pm:0x843e  OutputWriteL          ; R0=FIX F12; *R4; ASHIFT-8; DM(I4,M2)=R8
pm:0x8441  OutputWriteR          ; R0=FIX F13; *R4; ASHIFT-8; DM(I4,M2)=R8
pm:0x8445  Return                ; RTS(DB)
dm:0x9800  LFO_paramA            ; 0.10 (0x19999999)
dm:0x9801  LFO_paramB            ; 0.40 (0x66666666)
dm:0x9806  LFO1_incr             ; 0x0019BC65 modulation phase increment / depth (twice)
dm:0x9809  LFO2_incr             ; 0x001E0676 second modulation increment (twice)
dm:0xc00f  DelayLen_A            ; 0x1D delay-line length param
dm:0xc028  ModLUT_start          ; interpolation/curve table (c028..c048)
dm:0xc038  ModLUT_zero           ; center
