# The OT-block, title and mode ids, GENERATED by tools/gen_data_s.py from the start-up code's
# RegisterOTBlock (-), RegisterTitle (?) and RegisterMode (?) calls:
# id = (registry slot << 16) | index, slot 0xC OT blocks, 0xF titles, 0xE modes; each name is
# the string the call registers.

# 1 OT blocks
.equ OTB_PLUG, 0x000C002F

# 1 titles
.equ TT_PLUGIN, 0x000F013F	# screen PLUG_Main

# 0 modes

# the SP7001's titles and functions this image's records name (the host's ids)
.equ FN_DefaultFunction, 0x00020000
.equ MD_PS, 0x000E0000
.equ TT_PS, 0x000F0000
.equ TT_SDCCUS, 0x000F0111
.equ TT_SDAUDPLY, 0x000F0116
.equ FN_NamingCheck, 0x00220000
