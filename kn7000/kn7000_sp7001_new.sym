0x4C03B77F  slp_tsk_Impl            ; slp_tsk's body, behind the wrapper slp_tsk; KernelErrorHook d0 = -38 (H'ffda, slp_tsk), d1 = E_CTX (uITRON 3.0 sect. 6.3; notes/uitron3-function-codes)
