; KN2400/KN2600 manual symbol supplement: entry points recovered by hand, which
; the firmware's MILK reflection tables (kn2400.sym, generated) do not name.
; Format as in kn7000/kn7000_manual.sym: "0xCPUADDR  name  ; note".
; Names ending in _entry mark a register-save `call` entry a few bytes into a
; function (after its movm prologue); they are labels, not function boundaries.
;
; ---- boot header (file 0x0..0x10), laid out as the KN7000's ----------------
0x48400000  _reset          ; jmp to the crt0, the image's first instruction
0x4840000A  _vector_0a      ; second vector jmp, at the same offset as the KN7000's
;
; ---- start-up ----------------------------------------------------------------
0x48705BDF  crt0_start      ; _reset's target: ports + memory controller (0x32000020..0x32000042), sp = 0x5006908C, clears 0x50006E88 (+0x189178) and 0x502B8000 (+0x148000), copies .data 0x485DD334 -> 0x50000010 (0x6E78 bytes), writes the jmp vectors at 0x90000000/0x90000006, then calls func_4870587E_entry and jumps to func_48728591
;
; ---- after the code linked for work RAM (file 0x3965b8..0x3965d3) --------------
0x487965B8  RamCodeTrailer  ; 7 bytes, then 5 words: 0x487285BE (flash start of the RAM-linked code), 0x50120000 (its link address), 0x00038003, 0x487965B8 (this address: the flash end of that code), 0x5018FFF0; func_4870587E reads it byte by byte from +3 (movbu, each word assembled little-endian with asl 8 / 16 / 24) and steps 12 bytes a record (corrected 2026-10-30, lane generic-zero: the note said no code read it) [INFERENCE: a copy descriptor]
0x487965BF  RamCodeTrailerWords  ; RamCodeTrailer+7: its five words (gen_image_s.py --long-table), which func_4870587E reads byte by byte
;
; ---- data ----------------------------------------------------------------------
0x4852BD9C  TechnicsRhythmsResource ; built-in rhythm style resource in IC18's format, one style (as the KN7000's at 0x48729988, typed by kn7000/tools/program_rhythm.py); its name string "Technics Rhythms" is also at 0x4852BC20
0x48571564  StyleRecordTable           ; the KN2600's and PR54's built-in Music Stylist setups, 720 x 24 bytes (the KN7000's / KN6000's layout): MssSetupGet returns &StyleRecordTable[i] unless KnprModelGet answers 1 (KN2400); +0 -> a 160-byte one-touch setting (kn6000/notes/siblings-data-final/README.md; kn7000/notes/mn10300-formats/README.md)
0x48577738  StyleRecordTableKN2400     ; the KN2400's Music Stylist setups, 680 x 24 bytes, over the same one-touch settings: MssSetupGet returns &StyleRecordTableKN2400[i] when KnprModelGet answers 1 (was StyleRecordTableAlt)
0x4856F5E4  StyleSetupIndexTable       ; 720 x u16, the record index of setup number n + 1 (here n itself) for the KN2600 / PR54: MssSetupIndexGet reads [n] unless KnprModelGet answers 1; MssNameFunc then takes MssSetupGet of the answer
0x4857595C  StyleSetupIndexTableKN2400 ; 684 x u16 (0..679, then four more), the KN2400's: MssSetupIndexGet reads [n] when KnprModelGet answers 1
0x4857087C  StyleGenreTable            ; the KN2600 / PR54 genre list, 11 x {name, setup list}: MssGenreGet returns &[i] unless KnprModelGet answers 1 (the KN6000's StyleGenreTable)
0x48576AF0  StyleGenreTableKN2400      ; the KN2400's genre list, 11 x {name, setup list}: MssGenreGet returns &[i] when KnprModelGet answers 1
0x48570EB8  StyleAlphabetTable         ; the KN2600 / PR54 alphabet index, 34 x {letter string, setup list}: MssLetterGet returns &[i] unless KnprModelGet answers 1 (the KN6000's StyleAlphabetTable)
0x485770DC  StyleAlphabetTableKN2400   ; the KN2400's alphabet index, 34 x {letter string, setup list}: MssLetterGet returns &[i] when KnprModelGet answers 1
0x485758E4  StyleEraTable              ; the KN2600 / PR54 era list, 10 x {name, setup list, u16 era}: MssEraGet returns &[i] unless KnprModelGet answers 1 (the KN6000's StyleEraTable)
0x4857B6F8  StyleEraTableKN2400        ; the KN2400's era list, 10 x {name, setup list, u16 era}: MssEraGet returns &[i] when KnprModelGet answers 1
0x48532260  TechnicsPadsResource       ; the built-in "Technics Pads" PERFORMANCE PAD bank (the table flash's segment 4 format): TechnicsPadsResourceInit stores it when the table flash's resource does not check; typed by ../kn7000/tools/gen_data_s.py pads()
0x4854B24C  NoteConvRules              ; 128 x 8-byte note-conversion rules {is_melody, alt_chord, no_third_adj, no_transpose, table}: func_50173F49 (RAM-linked code; the KN7000's func_48436229), +1 / +2 / +3 answered by func_50173EF8 / func_50173F13 / func_50173F2E
; ---- the MILK kernel's tail routines (lane code-island, 2026-10-30; the KN7000's names,
;      ../kn7000/notes/code-island/README.md: the same block, linked at the flash address) ----
0x485E41C4  KernelServiceHash            ; 16 x {u32 key, code pointer}: KernelWaitRelease takes the task's wait state (TCB +0xE) & 0xFF00, minus 0xFF, indexes the table by (key & 0xF) * 8, probes the records in turn up to KernelRamLayout and jumps through +4 of the one whose +0 is the key (the KN6000's table of the same name)
0x485E4244  KernelRamLayout              ; 6 RAM addresses (0x50380000, 0x50387FFF, 0x50388000, 0x503BBFFF, ...); KernelStart loads its stack pointer from +0x14 [INFERENCE: the kernel's memory pools' bounds]
0x485E425C  KernelParams                 ; 14 u16 (10, 20, 20, 20, 10 ...): the kernel's parameter words, as on the KN6000 / KN7000
0x48728165  KernelInit                   ; the routine KernelStart jumps to: fills the kernel's RAM tables, creates the kernel task, calls the application's start-up, KernelInitHook and the dispatcher start [INFERENCE: name, from what it does]
0x4872841C  KernelWaitRelease            ; d0 = task id: dequeues the task from the wait queue its wait state names (through KernelServiceHash), then from the timer list [INFERENCE: name]
0x48728588  KernelErrorHook              ; `retf 0, 0`: kernel services call it before they return an error, d0 = the function code, d1 = the uITRON error code [INFERENCE]
0x4872858B  KernelErrorHook2             ; `retf 0, 0`: as KernelErrorHook, from a few other call sites [INFERENCE]
0x4872858E  KernelWaitAbortHook          ; `retf 0, 0`: called with a0 = the TCB and d0 = -0x55 (E_TMOUT) or -0x51 (E_DLT) for a wait that ends in an error [INFERENCE]
0x48728591  KernelStart                  ; sp := (KernelRamLayout + 0x14), jmp KernelInit: the kernel's start
0x4872859C  KernelInitHook               ; `ret 0, 0`: KernelInit calls it before it starts the dispatcher [INFERENCE: an empty start-up hook]
0x4872859F  KernelTickIsrDefault         ; the kernel's default system-tick interrupt handler, after KernelInitHook: clears bits 4..7 of G6ICR 0x34000118 (acknowledges interrupt group 6), calls func_5018DD6C_L3 (the kernel's wake-up of the task (0x50380000) points at) and returns with `rets` (LibIrqScheduler enters handlers with `calls (a2)` through the RAM table 0x50380B64). Nothing enters it: no word of the image holds its address, and the application start-up (through the def_int service) installs 0x5018B5FD for the same interrupt (number 1, G6ICR) [INFERENCE: the kernel configuration's default tick handler, replaced by the application's; lane mn10300-typer]
;
; ---- the model strap: one image for three instruments (lane mn10300-formats, 2026-10-31,
;      kn7000/notes/mn10300-formats/README.md) ----------------------------------------
0x487055C4  KnprModelGet               ; -> d0 = the instrument this image runs on, from the board strap halfword 0x98070000: bit 1 (mask 0x02) and bit 0 (mask 0x01) both set = 0 (KN2600), one of them set = 1 (KN2400), neither = 2 (PR54); 61 call sites in 51 routines. The numbering is IvKNPRWinProc's: model 0 / 1 / 2 picks the IvKNPRWin field at +0x18 / +0x1C / +0x20, whose names are KN2600 / KN2400 / PR54 (ClassFields_IvKNPRWin)
0x48641CCD  MssSetupGet                ; (d0 = i) -> a0 = &StyleRecordTableKN2400[i] when KnprModelGet answers 1, else &StyleRecordTable[i] (24-byte records: mulu 0x18)
0x48641D02  MssSetupIndexGet           ; (d0 = n) -> d0 = StyleSetupIndexTableKN2400[n] when KnprModelGet answers 1, else StyleSetupIndexTable[n] (u16)
0x48641D2F  MssGenreGet                ; (d0 = i) -> a0 = &StyleGenreTableKN2400[i] when KnprModelGet answers 1, else &StyleGenreTable[i] (8-byte records)
0x48641D5E  MssLetterGet               ; (d0 = i) -> a0 = &StyleAlphabetTableKN2400[i] when KnprModelGet answers 1, else &StyleAlphabetTable[i] (8-byte records)
0x48641D8D  MssEraGet                  ; (d0 = i) -> a0 = &StyleEraTableKN2400[i] when KnprModelGet answers 1, else &StyleEraTable[i] (12-byte records)
;
; ---- zlib 1.0.4's data tables (lane mn10300-formats, 2026-10-31): found by their contents, which are
;      the zlib sources' own, and laid out in the sources' order (deflate.c, trees.c, infblock.c,
;      inftrees.c, then infutil.c's inflate_mask and zutil.c's z_errmsg after the copyright strings);
;      kn7000/notes/mn10300-formats-probes/zlib_tables.py finds them in every build ----------------
0x50000D58  configuration_table     ; zlib 1.0.4 deflate.c: per-level {good_length, max_lazy, nice_length, max_chain, func} (10 x 12 bytes) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000DD0  extra_lbits             ; zlib 1.0.4 trees.c: extra bits of each length code (29 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000E44  extra_dbits             ; zlib 1.0.4 trees.c: extra bits of each distance code (30 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000EBC  extra_blbits            ; zlib 1.0.4 trees.c: extra bits of each bit-length code (19 ints) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000F08  bl_order                ; zlib 1.0.4 trees.c: the order the bit-length code lengths are sent in (19 bytes) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000F1C  static_l_desc           ; zlib 1.0.4 trees.c: {tree, extra_lbits, 257, 286, 15} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000F30  static_d_desc           ; zlib 1.0.4 trees.c: {tree, extra_dbits, 0, 30, 15} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000F44  static_bl_desc          ; zlib 1.0.4 trees.c: {tree, extra_blbits, 0, 19, 7} (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000F58  static_init_done        ; zlib 1.0.4 trees.c: non-zero once tr_static_init has run (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000F5C  border                  ; zlib 1.0.4 infblock.c: the order of the bit-length code lengths (19 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50000FA8  cplens                  ; zlib 1.0.4 inftrees.c: copy lengths for literal codes 257..285 (31 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50001024  cplext                  ; zlib 1.0.4 inftrees.c: extra bits for literal codes 257..285; 192 = invalid (31 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x500010A0  cpdist                  ; zlib 1.0.4 inftrees.c: copy offsets for distance codes 0..29 (30 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50001118  cpdext                  ; zlib 1.0.4 inftrees.c: extra bits for distance codes (30 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50001190  fixed_built             ; zlib 1.0.4 inftrees.c: non-zero once inflate_trees_fixed has built the fixed tables (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50006668  deflate_copyright       ; zlib 1.0.4 the copyright string the zlib sources keep in the binary (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x500066A0  inflate_copyright       ; zlib 1.0.4 the copyright string the zlib sources keep in the binary (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x500066D0  inflate_mask            ; zlib 1.0.4 infutil.c: masks of the low n bits, n = 0..16 (17 uInts) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
0x50006714  z_errmsg                ; zlib 1.0.4 zutil.c: the error texts, indexed 2 - err (10 pointers) (found by contents: kn7000/notes/mn10300-formats-probes/zlib_tables.py)
;
; ---- the DSP effects' descriptors and parameter records (lane mn10300-formats, 2026-10-31;
;      kn7000/notes/mn10300-formats/README.md, gen_data_s.py fx_descriptors, probe
;      kn7000/notes/mn10300-formats-probes/kn2400_fx_desc.py) --------------------------------
0x4856C74C  FxDescTable                ; 260 pointers to effect descriptors (107 distinct): FxDescGet answers [FxDescIndexGet(d0)]
0x4863CDEF  FxDescGet                  ; (d0 = effect code) -> a0 = FxDescTable[FxDescIndexGet(d0)], a 16-byte descriptor {u8 count, u8 nparams, u16 0, params, s8 mode, pnum9, pnum10, pnum11, send_param, 3 x 0}
0x4863D2E0  FxDescNParamsGet           ; (d0 = effect code) -> descriptor +1, the number of parameter numbers (-1 for a category its jump table rejects)
0x4863D30F  FxDescTempoParamGet        ; (d0) -> descriptor +10 (s8), the tempo_param: a parameter number or -1; FxParamValueGet 0x4863DF3E (calls at 0x4863DFD6 / 0x4863E068) answers GetM3Em id 4 (TEMPO) for that parameter instead of its stored value (was FxDescPnum10Get; lane mn10300-rest)
0x4863D33F  FxDescSpeedParamGet        ; (d0) -> descriptor +9 (s8), the speed_param: a parameter number or -1; called (at its entry +5) only by FxSpeedNudge 0x4863B51E, which moves that parameter by (its stack argument - 0x40) within min / max: LFO SPEED, SLOW LFO SPEED or PEDAL (was FxDescPnum9Get; lane mn10300-rest)
0x4863D36F  FxDescConnectionGet        ; (d0) -> descriptor +8 (s8), the connection: FxConnectionGet 0x4863BA0B maps it to the connection message (kind 9), SndUnitDbGroupQuery and FxDepthApply act for 1 and 2 (was FxDescModeGet; lane mn10300-rest)
0x4863D39F  FxDescSendParamGet         ; (d0) -> descriptor +12 (s8): the number of the effect's REVERB SEND parameter, -1 for the reverbs (kn2400_fx_desc.py: 106 of 106)
0x4863D3CF  FxDescDriveParamGet        ; (d0) -> descriptor +11 (s8), the drive_param: a parameter number or -1; func_4863B2B6 (0x4863B2EA) / func_4863B3CF (0x4863B41B) reload an effect of the same type with the parameters kept (kind 5) only when it is -1: the DRIVE of the 9 rotary / amp twins (was FxDescPnum11Get; lane mn10300-rest)
0x4863D3FF  FxDescIndexGet             ; (d0 = effect code) -> the FxDescTable index: FxCategoryGet picks the case, which reads +0x12 of the record func_4863CDB5 / func_4863CDD8 / func_4863DCF4 answers, or asks func_4863AB58
0x4863D4F1  FxParamGet                 ; (d0 = effect code, d1 = i) -> a0 = &params[i] (36-byte records: mulu 0x24)
0x4863D52C  FxParamMinGet              ; (d0, d1 = i) -> params[i] +0x16, s16 minimum
0x4863D568  FxParamMaxGet              ; (d0, d1 = i) -> params[i] +0x18, s16 maximum
0x4863D5A4  FxParamNumberGet           ; (d0, d1 = i) -> params[i] +0x14, u16 parameter number (records of one number are alternatives, chosen by +0x1C)
0x4863D5E0  FxParamNextDepthLinked     ; (d0 = effect code, d1 = i) -> the index of the next parameter record at or after i whose +0x1D (depth_link) is 0 and whose variant matches, or -1: a search, not a getter (was FxParamX29Get; lane mn10300-rest)
0x4863D692  FxParamBandGet             ; (d0, d1 = i) -> params[i] +0x1A (0..4 in the EQ effects' band parameters, else 0xFF)
0x4863D6CF  FxParamSubGet              ; (d0, d1 = i) -> params[i] +0x1B (0..2: within an EQ band, frequency / Q / gain)
0x4863D70C  FxParamVariantGet          ; (d0, d1 = i) -> params[i] +0x1C: 0 or 1 for the two alternative records of one parameter number ("DEPTH" / "DEPTH (V)", "SPEED FAST" / "SLOW"), 0xFF for a record that is always shown
0x4863D749  FxParamValuesGet           ; (d0, d1 = i) -> params[i] +0x20, the parameter's value texts ("    0 ms", ...) or 0
0x4863DC81  FxCategoryGet              ; (d0 = effect code) -> its category 0..14: codes 0x00..0x6F are category 0, 0x70..0xC0 are looked up in func_4863DC81_Ld_Records (8-byte records)
;
; ---- the effect DSP: its programs, parameter scripts and address maps, and the routines that download
;      them (lane mn10300-rest, 2026-10-31; kn7000/notes/mn10300-rest/README.md, gen_data_s.py fx_streams,
;      probes kn7000/notes/mn10300-rest-probes/kn2400_fx_streams.py, kn2400_fx_pnums.py) ----------------
0x4854B764  FxPresetTable              ; 8192 pointers to the effect presets {char name[16], NUL, pad, u16 DSP type (+0x12, FxDescIndexGet: the FxDescTable index), u16 n (+0x14), u16 0, the u16 parameter values (+0x18, a pointer), u32 code (+0x1C)}, indexed (code & 0xFF) << 6 | (code >> 8) & 0x3F (FxPresetGet)
0x48553764  FxPresetVarTable           ; 64 pointers to effect presets, indexed (code >> 8) & 0x3F (FxPresetVarGet)
0x4863CDB5  FxPresetGet                ; (d0 = effect code) -> a0 = FxPresetTable[(code & 0xFF) << 6 | (code >> 8) & 0x3F]
0x4863CDD8  FxPresetVarGet             ; (d0 = effect code) -> a0 = FxPresetVarTable[(code >> 8) & 0x3F]
0x48541630  FxTypeProgramTable         ; 208 pointers: the effect-DSP program stream of each DSP type (0: none), read by FxDspProgramLoad (`mov 0x48541630, a0 / mov (d0, a0), d1` 0x50189F74 / 0x50189F7A)
0x48541970  FxTypeScriptTable          ; 208 pointers: each DSP type's parameter script (FxDspParamApply 0x5018A298)
0x48541CB0  FxTypeMapTable             ; 208 pointers: each DSP type's address map (FxDspParamApply 0x5018A28C)
0x48541FF8  FxUnitIdleProgramTable     ; 6 pointers: the program each DSP unit loads for type 0 (FxDspProgramLoad 0x50189F64)
0x48541618  FxUnitProgramBase          ; 6 u16: each unit's first program step (60 reverb, 179 chorus, 287 mic reverb, 329 EQ, 351 insertion, 450 mic effects; FxDspStreamExec's FC records add it)
0x48541488  FxUnitStepRows             ; the units' step rows {u16 entry step, u16 bypass target, u16 base} (FxUnitBypass)
0x48533A0C  FxUnitCoefBase             ; 12 rows of zeros: the per-unit coefficient offset FxDspParamApply adds (0x5018A2AD)
0x48533A9C  FxUnitTypesAllowed0        ; 208 bytes: the DSP types unit 0 (insertion effects) may load (FxUnitTypeAllowed `movbu (d0, a0), d0`)
0x48533B6C  FxUnitTypesAllowed1        ; the same for unit 1 (reverb)
0x48533C3C  FxUnitTypesAllowed2        ; unit 2 (chorus)
0x48533D0C  FxUnitTypesAllowed3        ; unit 3 (mic reverb)
0x48533DDC  FxUnitTypesAllowed5        ; unit 5 (mic effects); unit 4, the 2-band EQ, takes type 0x4F only (`cmp 0x4f, d0`)
0x48533EAC  FxDspBootStream            ; the program stream FxDspBoot downloads first (FxDspBootStreamRun 0x50189EF7)
0x485340C5  FxDspBootStream2           ; the boot stream's second part (FxDspBootStreamRun2 0x50189F14)
0x4853F0CF  FxDspClearStream           ; the stream a script's kind-0x79 entry runs to clear a unit (FxDspClearRun 0x50189F31)
0x485414AD  FxLfoWave0                 ; coefficient 0x68 = 0: 37 u24 values to coefficient 0x68 (FxDspQueueFlush) [INFERENCE: an LFO wave, sine by its values]
0x48541522  FxLfoWave1                 ; coefficient 0x68 = 1 [INFERENCE: triangle]
0x48541597  FxLfoWave2                 ; coefficient 0x68 = 2 [INFERENCE: a clipped wave]
0x4854160C  FxCurveKeep                ; coefficient 0x8D = 3: an empty coefficient record (`fd 00 03 ff`); its twins at +4 and +8 for 4 and 5
0x501854DA  FxDspBoot                  ; boots the effect DSP: FxDspBootStreamRun2, FxDspBootStreamRun
0x50185356  FxDspService               ; the effect DSP's service routine: takes the queued type and parameter requests
0x50184EBB  FxDspTypeRequest           ; queues a DSP type change for a unit
0x50185032  FxDspParamRequest          ; queues a parameter change for a unit
0x50185A10  FxUnitTypeAllowed          ; (d0 = unit, d1 = type) -> FxUnitTypesAllowed<unit>[type] (unit 4: type 0x4F only)
0x50185C7D  FxDspProgramsLoad          ; loads each unit's program
0x50189F4E  FxDspProgramLoad           ; (d0 = type, d1 = unit) the type's program (FxTypeProgramTable) or the unit's idle one (FxUnitIdleProgramTable) through FxDspStreamRun
0x5018A213  FxDspStreamRun             ; runs a program stream (FxDspStreamExec)
0x5018A345  FxDspStreamExec            ; the program-stream interpreter: `movbu (a0), d0` 0x5018A358, records 0xFB raw / 0xFC program steps / 0xFD coefficients / 0xF7 coefficients one by one / 0xFE register pairs, 0xFF the end
0x5018A23D  FxDspCoefStreamRun         ; runs a coefficient-only stream (FxDspCoefStreamExec)
0x5018A64E  FxDspCoefStreamExec        ; the 0xFD-only interpreter (FxDspQueueFlush's waves and curves)
0x5018A267  FxDspParamApply            ; (d0 = unit, d1 = type, the parameter number and 3 values on the stack) runs the type's script group for the parameter against its address map (FxParamScriptRun)
0x5018A724  FxParamScriptRun           ; finds the parameter's script group (FxScriptGroupFind) and runs its entries (FxParamEntryExec)
0x5018A7B8  FxParamEntryExec           ; one script entry: the kind byte (`cmp 0x61` 0x5018A82A .. `cmp 0x7a` 0x5018ADC5) selects the converter, the index the address in the map group (FxMapAddrFind)
0x5018AEA6  FxScriptGroupFind          ; skips to group n of a script or map (`movbu (a0), d1` 0x5018AEEA, the end at 0xFF 0x5018AEFB)
0x5018AE27  FxMapAddrFind              ; the map group of an entry's kind and its index-th address (`movbu (a0), d2` 0x5018AE3A)
0x5018ADD8  FxReadS24BE                ; reads a big-endian 24-bit operand
0x50185F06  FxDspQueueFlush            ; sends the queued coefficient / register writes; coefficient 0x68 = 0..2 runs FxLfoWave0..2, 0x8D = 3..5 FxCurveKeep and its twins
0x501863EF  FxDspQueueCoef             ; queues a coefficient write (kind 0xFD)
0x5018655F  FxDspQueueReg              ; queues a register write (kind 0xFE)
0x50189F8E  FxUnitBypassSet            ; bypasses a unit (a script's kind 0x79 before the clear stream)
0x50189FF6  FxUnitBypass               ; writes a unit's bypass step from FxUnitStepRows
0x5018A07D  FxUnitEnable               ; writes a unit's entry step word (F8 xx xx 00) [INFERENCE: a jump into the unit's program]
0x50189EF7  FxDspBootStreamRun         ; FxDspStreamRun(FxDspBootStream)
0x50189F14  FxDspBootStreamRun2        ; FxDspStreamRun(FxDspBootStream2)
0x50189F31  FxDspClearRun              ; FxDspStreamRun(FxDspClearStream)
0x5018AFD0  FxDspStepWrite             ; writes one 4-byte program word to step base[unit] + i
0x5018B137  FxDspFrameSend             ; sends one write as a 5-byte frame: a 9-bit register, then a 24-bit value
0x5018B18A  FxDspIndirectWrite         ; register 0xFF = the address, 0x1FF = the value, 9 strobes
0x5018B06D  FxDspBurstBegin            ; starts a burst write at an address (FD records)
0x5018B0B5  FxDspBurstEnd              ; ends a burst write
0x5018B0F2  FxDspBurstWrite            ; one u24 value of a burst, the address auto-incremented
0x5018B27D  FxDspByteSend              ; one byte to the DSP
0x5018B241  FxSerialByteSend           ; one byte out: register 7 = 0x82, then register 6 = the byte
0x5018B22B  FxSerialRegWrite           ; writes halfword register reg at 0x98050000 + 2 x reg (`mov 0x98050000, a0` 0x5018B235, `movhu d1, (d0, a0)` 0x5018B23C)
0x5018B20E  FxSerialRegRead            ; reads halfword register reg at 0x98050000 + 2 x reg
0x5018B290  FxSerialInit               ; sets the serial interface up
0x5018B48C  FxDspBusyGet               ; bit 2 of 0x98070000 (`movhu (0x98070000), d0` 0x5018B48F): the DSP's ready / busy line
0x5018AF38  FxDspWaitIdle              ; waits until the DSP is not busy
0x5018AF84  FxDspWaitBusy              ; waits until the DSP is busy
0x5018B4A6  FxDspSelect                ; sets the DSP's chip select (bit 4 of the latch 0x98000000, Latch98000000Set)
0x5018B4B1  FxDspDeselect              ; clears it (Latch98000000Clear)
0x48705A38  Latch98000000Set           ; sets bits of the write-only latch 0x98000000 in its shadow and writes it (bits 4 / 2 / 1: the effect DSP's chip select, reset and strobe)
0x48705A6A  Latch98000000Clear         ; clears bits of the latch 0x98000000
0x48639E41  FxUnitMsgPost              ; posts a unit message: kind 1 type, 2 parameter, 5 reload with the parameters kept, 7 levels, 9 connection
0x4863DF3E  FxParamValueGet            ; a parameter's value: the stored one, or GetM3Em id 4 (TEMPO) for the descriptor's tempo_param / that EQ band
0x4863CEF5  FxCodeResolve              ; resolves an effect code to its effect
0x4863BA75  FxDepthApply               ; scales every depth-linked parameter (FxParamNextDepthLinked) by the control / 0x50, clamps it and posts it (kind 2)
0x4863BA0B  FxConnectionGet            ; (d0 = slot, d1 = effect code) -> the connection value posted as kind 9: slot 1 {0, 1, 2, 0}, slots 2..4 {0, 1, 1, 3} by FxDescConnectionGet
0x48639D4A  FxUnitTypeSet              ; stores the effect's DSP type (FxDescIndexGet) at the unit record +0xC
0x4863B51E  FxSpeedNudge               ; (d0 = slot, d1 = effect code, a value on the stack) the speed_param's value (FxParamValueGet) + (the value - 0x40), clamped to min / max, posted as a parameter change (kind 2) [INFERENCE: a relative speed control centred on 64]; nothing calls it
