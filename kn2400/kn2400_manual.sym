0x487019FB  SoundAlphaListGet          ; (d0 = kind 0..2, d1 = variant 0..1) -> a0 = slot 2 x kind + variant of SoundAlphaListTableKN2400 (`mov (d0, a0), a0` 0x48701A25) when KnprModelGet answers 1, else of SoundAlphaListTable (0x48701A35)
0x48701A3A  SoundAlphaIndexBuild       ; stores the list to 0x50068688 (0x48701A5C) and groups its 4-byte entries by their initial (`movbu (d1, a0), d2` 0x48701A82)
0x48701D1E  SoundAlphaInitialGet       ; matches +1 / +2 / +3 (`movbu (1, a0)` / (2, a0) / (3, a0) 0x48701D54 .. 0x48701D7A) with a sound's bank MSB, LSB and program and answers +0
0x485ABF00  SoundAlphaListTable        ; 6 pointers to the KN2600 / PR54's alphabetical sound lists, SoundAlphaListGet's [2 x kind + variant]
0x485AF118  SoundAlphaListTableKN2400  ; the same for the KN2400 (KnprModelGet = 1)
